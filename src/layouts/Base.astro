---
const {title='Prima Scriptura',description='Comentários bíblicos e estudos temáticos gratuitos'}=Astro.props;
---
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><title>{title} | Prima Scriptura</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/></head><body><header><div class="wrap head"><a class="brand" href="/">PRIMA <span>SCRIPTURA</span></a><nav aria-label="Navegação principal"><a href="/comentarios">Comentários</a><a href="/estudos">Estudos temáticos</a><a href="/pesquisa">Pesquisar</a><a href="/sobre">Sobre</a></nav></div></header><main><slot/></main><footer><div class="wrap foot"><strong class="brand">PRIMA <span>SCRIPTURA</span></strong><small>Conhecimento bíblico acessível a todos · © {new Date().getFullYear()}</small></div></footer></body></html>
<style is:global>
:root{--navy:#101f35;--navy2:#1c3554;--gold:#c6a15b;--cream:#f5f0e5;--ink:#233149}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#fbfaf7;color:var(--ink);font-family:Inter,Arial,sans-serif;line-height:1.7}a{color:inherit;text-decoration:none}a:hover{color:#99743a}header{background:var(--navy);color:white;border-bottom:1px solid #ffffff26} .wrap{max-width:1120px;margin:auto;padding:0 24px}.head{min-height:78px;display:flex;justify-content:space-between;align-items:center;gap:24px}.brand{font:700 21px 'Libre Baskerville',Georgia,serif;letter-spacing:.02em;color:#f7ead3}.brand span{color:var(--gold)}nav{display:flex;flex-wrap:wrap;gap:23px}nav a{font-size:14px;color:#e6eaf0}.hero{background:radial-gradient(circle at 80% 30%,#2a4567,var(--navy) 65%);color:white;padding:100px 0}.hero h1{color:#fff;font-size:clamp(38px,6vw,66px);max-width:780px}.hero p{font-size:18px;color:#e0e6ee;max-width:690px}.eyebrow{color:var(--gold);font-size:12px;font-weight:700;letter-spacing:.19em;text-transform:uppercase}h1,h2,h3{font-family:'Libre Baskerville',Georgia,serif;line-height:1.3;color:var(--navy)}h1{font-size:clamp(32px,5vw,48px)}h2{font-size:30px}h3{font-size:19px}.section{padding:60px 0}.soft{background:var(--cream)}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.card{background:white;border:1px solid #e7e1d6;border-radius:9px;padding:26px;box-shadow:0 8px 30px #0b1c3408}.card p{color:#596578}.card small,.muted{color:#667386}.btn{display:inline-block;background:var(--gold);color:var(--navy);border:1px solid var(--gold);padding:12px 20px;font-weight:700;border-radius:5px}.btn.outline{background:transparent;color:#fff}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.kicker{font-size:12px;text-transform:uppercase;letter-spacing:.12em;color:#96723c;font-weight:700}.article{max-width:790px;margin:auto}.article h1{margin-bottom:10px}.article .meta{color:#647083;font-size:14px;border-bottom:1px solid #e0ddd5;padding-bottom:20px}.prose{font-family:Georgia,serif;font-size:19px;line-height:1.9}.prose h2{font-size:25px;margin-top:42px}.prose h3{font-size:21px;margin-top:32px}.prose blockquote{border-left:4px solid var(--gold);padding-left:18px;margin-left:0;color:#526074}.prose a{color:#89612d;text-decoration:underline}.prose table{border-collapse:collapse;display:block;overflow:auto}.prose td,.prose th{border:1px solid #ddd;padding:8px 12px}.foot{padding:38px 24px;display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}footer{background:var(--navy);color:#d7e0ed}input{font:inherit;padding:13px;border:1px solid #bbb;border-radius:5px;max-width:100%;width:100%} .results a{display:block;padding:18px 0;border-bottom:1px solid #ddd}.results small{display:block;color:#6d7887}@media(max-width:760px){.head{padding-top:20px;padding-bottom:20px;align-items:flex-start;flex-direction:column;gap:12px}nav{gap:12px}.grid{grid-template-columns:1fr}.hero{padding:65px 0}.section{padding:42px 0}}
</style>
