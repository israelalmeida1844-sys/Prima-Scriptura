---
interface ChapterLink { number: number; verses: number; }
interface Props { bookSlug: string; bookName: string; chapters: ChapterLink[]; }
const { bookSlug, bookName, chapters } = Astro.props;
---
<section class="chapter-picker" data-book-picker data-book-slug={bookSlug} data-book-name={bookName} data-chapters={JSON.stringify(chapters)} hidden aria-label={'Escolha de versículos de ' + bookName}>
  <div class="chapter-picker-top">
    <div><span class="chapter-picker-eyebrow">NAVEGAÇÃO RÁPIDA</span><h3 data-chapter-picker-title>Selecione um capítulo</h3><p>Os números aparecem em uma faixa horizontal. Escolha o versículo para abrir seu comentário.</p></div>
    <a class="chapter-picker-all" data-chapter-picker-all href={'/comentarios/' + bookSlug + '/'}>Ler capítulo completo</a>
  </div>
  <div class="chapter-picker-scroll" role="group" data-picker-numbers aria-label="Versículos disponíveis"></div>
  <p class="chapter-picker-footnote" data-picker-footnote></p>
</section>
<script>
  // Sem JavaScript, o clique num cartão continua a abrir a leitura integral.
  for (const panel of document.querySelectorAll('[data-book-picker]')) {
    if (!(panel instanceof HTMLElement)) continue;
    const slug = panel.dataset.bookSlug;
    const name = panel.dataset.bookName || '';
    let chapters: { number: number; verses: number }[] = [];
    try { chapters = JSON.parse(panel.dataset.chapters || '[]'); } catch { chapters = []; }
    const list = panel.querySelector('[data-picker-numbers]');
    const title = panel.querySelector('[data-chapter-picker-title]');
    const full = panel.querySelector('[data-chapter-picker-all]');
    const note = panel.querySelector('[data-picker-footnote]');
    if (!(list instanceof HTMLElement) || !(title instanceof HTMLElement) || !(full instanceof HTMLAnchorElement)) continue;
    const cards = document.querySelectorAll('a[href^="/comentarios/' + slug + '/capitulo-"]');
    const show = (number: number) => {
      const found = chapters.find(c => c.number === number);
      if (!found) return;
      title.textContent = name + ' — capítulo ' + number;
      full.href = '/comentarios/' + slug + '/capitulo-' + number + '/';
      list.replaceChildren();
      for (let i = 1; i <= found.verses; i++) {
        const link = document.createElement('a');
        link.className = 'chapter-picker-verse';
        link.href = full.href + '#v' + i;
        link.textContent = String(i);
        link.setAttribute('aria-label', name + ' ' + number + ':' + i + ' — abrir comentário');
        list.append(link);
      }
      if (note instanceof HTMLElement) note.textContent = slug === 'hebreus'
        ? 'Em Hebreus, os versículos abrem as seções exegéticas correspondentes.'
        : slug === '1-joao' ? 'Algumas passagens de 1 João são comentadas em grupos.' : 'Escolha um número para ler o comentário daquele versículo.';
      panel.hidden = false;
      cards.forEach(card => {
        const active = (card as HTMLAnchorElement).pathname === full.pathname;
        card.classList.toggle('chapter-picker-selected', active);
        card.setAttribute('aria-expanded', String(active));
      });
      panel.scrollIntoView({behavior:'smooth',block:'start'});
    };
    cards.forEach(card => {
      if (!(card instanceof HTMLAnchorElement)) return;
      card.addEventListener('click', event => {
        if (event.defaultPrevented || event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        const match = card.pathname.match(/\/capitulo-(\d+)\/?$/);
        if (!match) return;
        event.preventDefault(); show(Number(match[1]));
      });
    });
  }
</script>
<style>
.chapter-picker{margin:0 0 27px;padding:25px 28px 19px;border:1px solid #d7c8ad;border-radius:14px;background:#f9f7f2;box-shadow:0 9px 30px #1429420c;scroll-margin-top:20px}
.chapter-picker[hidden]{display:none!important}
.chapter-picker-top{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;margin-bottom:20px}
.chapter-picker-eyebrow{font:700 10px Inter,Arial,sans-serif;letter-spacing:.16em;color:#967344}
.chapter-picker h3{font:700 20px/1.4 "Libre Baskerville",Georgia,serif;margin:7px 0;color:#19344e}
.chapter-picker p{font:400 13px/1.65 Inter,Arial,sans-serif;color:#667687;margin:4px 0 0}
.chapter-picker-all{display:inline-block;border-radius:8px;background:#17304d;color:white;padding:13px 16px;white-space:nowrap;font:700 12px Inter,Arial,sans-serif}
.chapter-picker-all:hover{background:#355670;color:white}
.chapter-picker-scroll{display:flex;flex-wrap:nowrap;gap:8px;overflow-x:auto;scrollbar-width:thin;padding:4px 1px 12px;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain}
.chapter-picker-verse{flex:0 0 44px;min-height:44px;display:inline-flex;align-items:center;justify-content:center;background:#fff;border:1px solid #cdd5da;color:#173c5e;text-decoration:none;border-radius:8px;font:700 14px Inter,Arial,sans-serif}
.chapter-picker-verse:hover,.chapter-picker-verse:focus-visible{background:#17304d;color:#fff;border-color:#17304d}
:global(.chapter-picker-selected){border-color:#b99763!important;box-shadow:0 9px 28px #14294219!important}
@media(max-width:760px){.chapter-picker{padding:18px 16px}.chapter-picker-top{display:block}.chapter-picker-all{margin-top:13px}.chapter-picker-verse{flex-basis:42px;min-height:42px}}
</style>