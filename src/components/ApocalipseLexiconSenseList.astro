---
import {lemmaForStrong,transliterateGreekSnippet} from '../scripts/lexico-grego-apocalipse';
interface Props {strong:string}
const {strong}=Astro.props;
const entry=lemmaForStrong(strong);
const valid=(s?:string)=>Boolean(s&&s.trim()&&!['-','—','•'].includes(s.trim()));
---
{entry ? entry.senses.filter(sense=>valid(sense.label)||valid(sense.definition)).map(sense=>(
 <section class="lexical-sense" data-sense-id={sense.id} aria-label={sense.label}>
  {valid(sense.label)&&<h5 class="lexical-sense-title">{sense.label.trim()}</h5>}
  {valid(sense.definition)&&<p class="lexical-sense-definition">{sense.definition.trim()}</p>}
  <div class="lexical-examples">
   {sense.examples.filter(example=>valid(example.greek)&&valid(example.translation)).map(example=>(
    <div class="lexical-example">
     {valid(example.reference)&&<p class="lexical-example-reference">Exemplo: {example.reference}</p>}
     <span class="example-field-label">Grego</span>
     <p class="lexical-example-greek" lang="grc">{example.greek}</p>
     <span class="example-field-label">Transliteração auxiliar</span>
     <p class="lexical-example-transliteration">{example.transliteration || transliterateGreekSnippet(example.greek)}</p>
     <span class="example-field-label">Tradução</span>
     <p class="lexical-example-translation">{example.translation}</p>
     {valid(example.explanation)&&<p class="lexical-example-note">{example.explanation}</p>}
    </div>
   ))}
  </div>
 </section>
)) : <span>Verbete lexical ainda não revisado.</span>}
