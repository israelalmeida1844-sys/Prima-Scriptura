---
import lexicon1 from '../data/lexico-grego/apocalipse-1-1.json';
import lexicon2 from '../data/lexico-grego/apocalipse-1-2.json';
import lexicon38 from '../data/lexico-grego/apocalipse-1-3-8.json';
import lexicon4 from '../data/lexico-grego/apocalipse-4-1-11.json';

interface Props {
  strong: string;
}

const { strong } = Astro.props;
const entries = { ...lexicon4.entries, ...lexicon38.entries, ...lexicon1.entries, ...lexicon2.entries, G1163: lexicon4.entries.G1163 } as Record<string, {
  senses: Array<{
    id: string;
    label: string;
    definition: string;
    examples: Array<{
      reference: string;
      greek: string;
      translation: string;
      explanation: string;
    }>;
  }>;
}>;

const entry = entries[strong];
---
{entry ? entry.senses.map((sense) => (
  <section class="lexical-sense" data-sense-id={sense.id} aria-label={sense.label}>
    <h5 class="lexical-sense-title">{sense.label}</h5>
    <p class="lexical-sense-definition">{sense.definition}</p>
    <div class="lexical-examples">
      {sense.examples.map((example) => (
        <div class="lexical-example">
          <p class="lexical-example-reference">Exemplo: {example.reference}</p>
          <p class="lexical-example-greek" lang="grc">{example.greek}</p>
          <p class="lexical-example-translation">{example.translation}</p>
          <p class="lexical-example-note">{example.explanation}</p>
        </div>
      ))}
    </div>
  </section>
)) : <span>Entrada lexical ainda não revisada.</span>}
