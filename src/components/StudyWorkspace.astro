  }
  return doc.body.textContent||"";
}
document.querySelector<HTMLButtonElement>("#comment-open")!.onclick=async()=>{
  const id=++commentSerial,b=commentBook.value,c=Number(commentChapter.value),v=Number(commentVerse.value),lang=commentLang.value,a=commentAuthor.value;
  const prepared=lang==="pt"?prepareCommentaryTranslator():Promise.resolve(null);
  commentContent.replaceChildren();
  if(!b||!Number.isInteger(c)||c<1||!Number.isInteger(v)||v<0){appendText(commentContent,"p","Referência inválida.");return;}
  appendText(commentContent,"p","Carregando comentários…");
  try{
    const manifest=await commentManifest;
    if(!(manifest.books?.[b]||[]).includes(c)){if(id!==commentSerial)return;commentContent.replaceChildren();appendText(commentContent,"p","Capítulo não encontrado nos módulos locais.");return;}
    const chapterData=await requiredJson("/commentaries/"+encodeURIComponent(b)+"/"+c+".json");
    const translations=lang==="pt"?await optional("/commentaries-pt/"+encodeURIComponent(b)+"/"+c+".json"):{};
    if(id!==commentSerial)return;
    commentContent.replaceChildren();
    appendText(commentContent,"h3",(commentBook.selectedOptions[0]?.text||b)+" "+c+":"+v+" — numeração KJV");
    const jobs:(()=>Promise<void>)[]=[];
    for(const author of manifest.authors.filter((x:any)=>!a||x.id===a)){
      const section=document.createElement("article");section.className="commentary-entry";commentContent.append(section);
      appendText(section,"h4",author.author);appendText(section,"small",author.title+" · módulo "+author.id+" "+author.version+" · "+author.license);
      const rec=chapterData[author.id],hash=rec?.granularity==="chapter"?(rec.verse_keys?.[String(v)]||rec.keys?.["0"]):rec?.keys?.[String(v)];
      if(!hash){appendText(section,"p","Nenhuma entrada indexada nesta referência.");continue;}
      const raw=rec.entries[hash];if(rec.invalid_bytes?.[hash])appendText(section,"p","A fonte contém bytes incompatíveis com UTF-8. A visualização apresenta caracteres substitutos; os bytes originais estão preservados no arquivo de dados.");const keys=Object.keys(rec.keys).filter(k=>rec.keys[k]===hash);
      if(rec.granularity==="chapter")appendText(section,"p",(rec.verse_keys?.[String(v)]===hash?"Texto e anotações do versículo, identificado na transcrição":"Comentário integral do capítulo, não isolado por versículo")+" · transcrição histórica EEBO-TCP "+rec.year+" · "+rec.heading+". Pode conter erros de transcrição; confira a edição original.");else appendText(section,"p","Chaves do módulo com este mesmo conteúdo no capítulo: "+keys.join(", ")+".");
      const original=rec.granularity==="chapter"?readableMarkup(raw.replace(/<(\/?)(?:ns\d+:)/g,"<$1")):readableMarkup(raw);
      if(lang==="pt"){
        const translated=translations?.[author.id]?.[hash];
        if(translated?.source_sha256===hash&&translated?.status==="reviewed"&&typeof translated.text==="string"&&translated.text.trim()){
          appendText(section,"small","Tradução editorial revisada");
          const output=appendText(section,"div",translated.text);output.lang="pt";output.style.whiteSpace="pre-wrap";
        }else if(original.trim()){
          const status=appendText(section,"small","Preparando tradução automática…");
          const output=appendText(section,"div","");output.lang="pt";output.style.whiteSpace="pre-wrap";
          const button=document.createElement("button");button.type="button";button.textContent="Tentar tradução novamente";button.hidden=true;section.append(button);
          async function run(promise:Promise<CommentaryTranslator|null>){
            if(id!==commentSerial)return;
            button.hidden=true;status.textContent="Traduzindo automaticamente no navegador…";output.textContent="";
            try{
              const translator=await promise;
              if(id!==commentSerial)return;
              if(!translator){status.textContent="Tradução automática indisponível neste navegador. Consulte o original abaixo ou use um navegador compatível com tradução integrada.";button.hidden=false;return;}
              const text=await translateCommentary(original,translator,()=>id===commentSerial);
              if(id!==commentSerial||text===null)return;
              output.textContent=text;status.textContent="Tradução automática · não revisada academicamente";
            }catch{if(id===commentSerial){status.textContent="Não foi possível traduzir este comentário. Consulte o original ou tente novamente.";button.hidden=false;}}
          }
          jobs.push(()=>run(prepared));
          button.onclick=()=>{void run(prepareCommentaryTranslator());};
        }else appendText(section,"p","Esta entrada contém apenas marcação, sem texto traduzível.");
        const details=document.createElement("details");appendText(details,"summary","Ver original em inglês");const content=appendText(details,"div",original);content.lang="en";content.className="commentary-original";section.append(details);
      }else{
        const content=appendText(section,"div",original);content.lang="en";content.className="commentary-original";
        const details=document.createElement("details");appendText(details,"summary","Registro original do módulo (marcação incluída)");appendText(details,"pre",raw);section.append(details);
      }
    }
    for(const job of jobs){if(id!==commentSerial)return;await job();}
  }catch{if(id===commentSerial){commentContent.replaceChildren();appendText(commentContent,"p","Não foi possível carregar os comentários.");}}
};
const criticismContent=document.querySelector<HTMLElement>("#criticism-content")!,exegesisContent=document.querySelector<HTMLElement>("#exegesis-content")!;
function clearStudyNotes(){critSerial++;exegSerial++;criticismContent.replaceChildren();exegesisContent.replaceChildren();}
for(const e of [book,chapter,verse])e.addEventListener("change",clearStudyNotes);
document.querySelector<HTMLButtonElement>("#criticism-open")!.onclick=async()=>{
  const id=++critSerial,b=book.value,ref=originalRef();
  criticismContent.replaceChildren();appendText(criticismContent,"p","Carregando registros…");
  const greek=book.selectedOptions[0]?.dataset.rtl!=="yes";
  try{
    const d=await requiredJson("/textual-criticism/"+(greek?"greek":"hebrew")+"/"+encodeURIComponent(b)+".json");
    if(id!==critSerial||b!==book.value||ref!==originalRef())return;
    criticismContent.replaceChildren();
    appendText(criticismContent,"h3",greek?"SBLGNT — aparato comparativo de edições":"OSHB — notas do Texto Massorético");
    appendText(criticismContent,"p",greek?"WH: Westcott-Hort; Treg: Tregelles; RP: Robinson-Pierpont; NA27/NA28: Nestle-Aland conforme indicado na fonte. Não é um aparato completo de manuscritos.":"Notas preservadas da fonte, incluindo leituras Qere, sem inferência de testemunhos.");
    const rows=d[ref]||[];if(!rows.length)appendText(criticismContent,"p","Nenhum registro indexado nesta referência na fonte utilizada; isso não demonstra ausência de variantes.");
    for(const row of rows){
      if(greek){appendText(criticismContent,"small",row.source_reference);appendText(criticismContent,"p",row.note);}
      else{const details=document.createElement("details");appendText(details,"summary","Nota da fonte · posição "+row.before_token);const show=(parent:HTMLElement,e:any)=>{const q=document.createElement("div");parent.append(q);appendText(q,"small",e.tag+" "+JSON.stringify(e.attributes||{}));if(e.text?.trim())appendText(q,"p",e.text);for(const c of e.children||[])show(q,c);};show(details,row.element);criticismContent.append(details);}
    }
  }catch{if(id===critSerial)appendText(criticismContent,"p","Não foi possível carregar a fonte.");}
};
document.querySelector<HTMLButtonElement>("#exegesis-open")!.onclick=async()=>{
  const id=++exegSerial,b=book.value,ref=originalRef();exegesisContent.replaceChildren();
  const d=await optional("/exegesis/"+encodeURIComponent(b)+"/"+encodeURIComponent(ref.split(":")[0])+".json");
  if(id!==exegSerial||b!==book.value||ref!==originalRef())return;
  const rows=(d[ref]||[]).filter((entry:{status:string})=>entry.status==="reviewed");
  if(!rows.length){
    const [c,v]=ref.split(":").map(Number);
    const bookSlug=({Dan:"daniel",Heb:"hebreus","1John":"1-joao"} as Record<string,string>)[b];
    const section=b==="Gen"&&c===1&&v>=1&&v<=8
      ? "/comentarios/genesis/capitulo-1/versiculo-"+v+"/"
      : bookSlug && verse.value
        ? "/comentarios/"+bookSlug+"/capitulo-"+chapter.value+"/#v"+verse.value
        : "";
    if(section){
      const link=document.createElement("a");
      link.href=section;
      link.textContent="Consultar a exposição editorial da passagem";
      exegesisContent.append(link);
    }else appendText(exegesisContent,"p","Nenhuma nota editorial homologada nesta referência.");
  }
  for(const r of rows){appendText(exegesisContent,"h3",r.title);appendText(exegesisContent,"p",r.text);appendText(exegesisContent,"small",r.author+" · "+r.references.join("; "));}
};


const toolMenu=document.querySelector<HTMLDetailsElement>("#verse-tools")!,toolDialog=document.querySelector<HTMLDialogElement>("#study-tool-dialog")!,toolTitle=document.querySelector<HTMLElement>("#study-tool-title")!,toolContent=document.querySelector<HTMLElement>("#study-tool-content")!;
function currentReading(){
  const key=originalRef();
  const ref=chapter.value+":"+verse.value;
  const sourceRef=reading?ref:extra[key]?.source_ref||null;
  return {book:book.value,name:book.selectedOptions[0]?.textContent||book.value,ref,sourceRef,text:sourceRef?pt[sourceRef]||"":"",original:(data[key]||[]).map(w=>w.text).join(" "),rtl:book.selectedOptions[0]?.dataset.rtl==="yes"};
}
function openTool(title:string){toolMenu.open=false;toolTitle.textContent=title;toolContent.replaceChildren();if(!toolDialog.open)toolDialog.showModal();}
const activeSermon=initial.get("esboco");
const editorUrl=(id?:string|null)=>"/sermoes/"+(id?"?"+new URLSearchParams({esboco:id}):"");
document.querySelector<HTMLAnchorElement>("#view-sermon")!.href=editorUrl(activeSermon);
document.querySelector<HTMLButtonElement>("#tool-sermon")!.onclick=()=>{
  const passage=currentReading();
  openTool("Adicionar ao sermão");
  if(!passage.text){appendText(toolContent,"p","Texto da Bíblia Livre indisponível nesta referência.");return;}
  try{
    const drafts=loadSermons();
    const caption=document.createElement("label");
    caption.textContent="Esboço ";
    const selection=document.createElement("select");
    selection.add(new Option("Novo esboço",""));
    for(const draft of drafts)selection.add(new Option(draft.title.trim() || "Esboço sem título",draft.id));
    if(activeSermon && drafts.some(draft=>draft.id===activeSermon))selection.value=activeSermon;
    caption.append(selection);
    toolContent.append(caption);
    const feedback=appendText(toolContent,"p","");
    feedback.setAttribute("role","status");
    const add=document.createElement("button");
    add.type="button";
    add.textContent="Salvar no esboço";
    add.onclick=()=>{
      try{
        const existing=selection.value?loadSermons().find(draft=>draft.id===selection.value):undefined;
        if(selection.value && !existing){feedback.textContent="O esboço selecionado está indisponível.";return;}
        const draft=existing || newSermon(passage);
        const added=existing?addCitation(draft,passage):true;
        if(added)saveSermon(draft);
        toolContent.replaceChildren();
        appendText(toolContent,"p",added?"Versículo adicionado ao esboço.":"Este versículo já está no esboço.");
        const link=document.createElement("a");
        link.href=editorUrl(draft.id);
        link.textContent="Abrir esboço no editor →";
        toolContent.append(link);
        link.focus();
      }catch{feedback.textContent="Não foi possível salvar neste navegador.";}
    };
    toolContent.append(add);
  }catch{appendText(toolContent,"p","O armazenamento local está indisponível.");}
};
type ComparisonVerse = { type:string; number:number; content:(string|{text?:string;type?:string})[] };
document.querySelector<HTMLButtonElement>("#tool-compare")!.onclick=async()=>{
  const r=currentReading();
  openTool("Comparação de traduções");
  appendText(toolContent,"h3",r.name+" "+r.ref);
  appendText(toolContent,"h4","Bíblia Livre — "+(r.sourceRef||"sem referência alinhada"));
  appendText(toolContent,"p",r.text||"Tradução indisponível.");
  appendText(toolContent,"h4","King James Version — inglês");
  const pending=appendText(toolContent,"p","Carregando tradução…");
  if(r.sourceRef){
    const [c,v]=r.sourceRef.split(":");
    try{
      const edition=await requiredJson("https://bible.helloao.org/api/eng_kjv/"+helloAoBooks[canon.indexOf(r.book)]+"/"+encodeURIComponent(c)+".json");
      const entry=edition.chapter.content.find((row:ComparisonVerse)=>row.type==="verse"&&row.number===Number(v)) as ComparisonVerse|undefined;
      pending.textContent=entry?.content.map(part=>typeof part==="string"?part:part.type==="note"?"":part.text||"").join("")||"Versículo indisponível na edição.";
      if(pending.isConnected){
        appendText(toolContent,"small","Equivalência numérica com a KJV. Confirme a referência quando a numeração divergir.");
        const source=document.createElement("a");
        source.href="https://ebible.org/Scriptures/details.php?id=eng-kjv2006";source.textContent=" Fonte e licença da KJV";toolContent.append(source);
      }
    }catch{pending.textContent="Não foi possível consultar a edição KJV.";}
  }else pending.textContent="Sem referência portuguesa alinhada para comparação.";
  if(!pending.isConnected)return;
  appendText(toolContent,"h4",r.rtl?"Texto original — OSHB/WLC":"Texto original — SBLGNT/MorphGNT");
  const p=appendText(toolContent,"p",r.original||"Texto original indisponível.");
  p.dir=r.rtl?"rtl":"ltr";p.className="comparison-original";
};
document.querySelector<HTMLButtonElement>("#tool-comment")!.onclick=()=>{toolMenu.open=false;openPanel("commentary");document.querySelector<HTMLButtonElement>("#comment-copy")!.click();document.querySelector<HTMLElement>("#commentary-panel")!.scrollIntoView({block:"start"});document.querySelector<HTMLButtonElement>("#comment-open")!.focus({preventScroll:true});};
document.querySelector<HTMLButtonElement>("#tool-exegesis")!.onclick=()=>{toolMenu.open=false;openPanel("exegesis");document.querySelector<HTMLButtonElement>("#exegesis-open")!.click();document.querySelector<HTMLElement>("#exegesis-panel")!.scrollIntoView({block:"start"});};

document.querySelector<HTMLButtonElement>("#tool-criticism")!.onclick=()=>{openPanel("criticism");toolMenu.open=false;document.querySelector<HTMLButtonElement>("#criticism-open")!.click();};
const inlineButton=(id:string)=>document.querySelector<HTMLButtonElement>("#inline-"+id)!;
const showLink=(container:HTMLElement, label:string, href:string)=>{
  const link=document.createElement("a");
  link.textContent=label;
  link.href=href;
  container.append(link);
  return link;
};
inlineButton("tools").onclick=()=>{
  const quick=document.querySelector<HTMLElement>("#verse-quick-actions")!;
  quick.hidden=!quick.hidden;
  inlineButton("tools").setAttribute("aria-expanded",String(!quick.hidden));
};
inlineButton("original").onclick=()=>{
  if(words.hidden)partToggle.click();
  words.scrollIntoView({block:"start"});
  (words.querySelector<HTMLButtonElement>("button") || partToggle).focus({preventScroll:true});
};
inlineButton("syntax").onclick=()=>{openPanel("syntax");void showSyntax();syntaxOpen.focus({preventScroll:true});};
