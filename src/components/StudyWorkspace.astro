  document.querySelector<HTMLButtonElement>("#comment-open")!.click();
};
inlineButton("attach").onclick=()=>document.querySelector<HTMLButtonElement>("#tool-sermon")!.click();
inlineButton("create").onclick=()=>{
  const passage=currentReading();
  if(!passage.text)return;
  try{
    const draft=newSermon(passage);
    saveSermon(draft);
    location.assign(editorUrl(draft.id));
