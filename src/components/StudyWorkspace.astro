  const groups=await Promise.all(variants.map(async variant=>{
    const digest=await crypto.subtle.digest("SHA-256",new TextEncoder().encode(variant));
    const shard=new Uint8Array(digest)[0].toString(16).padStart(2,"0");
    const file=mode+"/"+kind+"/"+shard;
    if(!meta.shards.includes(file))return [];
    const index=await requiredJson("/interlinear-search/index/"+file+".json");
    return (Object.hasOwn(index,variant)?index[variant]:[]) as SearchLoc[];
  }));
  const unique=new Map(groups.flat().map(location=>[location.join(":"),location]));
  return [...unique.values()].sort((a,b)=>a[0]-b[0] || a[1]-b[1] || a[2]-b[2]);
