  const doc=new DOMParser().parseFromString(raw,"text/html");
  for(const el of doc.querySelectorAll("script,style,iframe,object,embed,svg,math,link,meta,img"))el.remove();
  for(const el of doc.querySelectorAll("br,p,div,lb,l,lg,title,hi,seg,reference,note")){
