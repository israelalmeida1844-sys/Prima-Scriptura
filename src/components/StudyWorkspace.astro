type CommentaryTranslator = { translate(text:string):Promise<string> };
let translatorPromise:Promise<CommentaryTranslator|null>|null=null;
function prepareCommentaryTranslator(){
  const api=(globalThis as unknown as {Translator?:{create(options:{sourceLanguage:string;targetLanguage:string}):Promise<CommentaryTranslator>}}).Translator;
  if(!api)return Promise.resolve(null);
  if(!translatorPromise)translatorPromise=api.create({sourceLanguage:"en",targetLanguage:"pt"}).catch(()=>{translatorPromise=null;return null;});
  return translatorPromise;
}
async function translateCommentary(text:string,translator:CommentaryTranslator,isCurrent:()=>boolean){
  const result:string[]=[];
  for(const paragraph of text.split(/\n+/).map(s=>s.trim()).filter(Boolean)){
    let chunk="";const translated:string[]=[];
    for(const word of paragraph.split(/\s+/)){
      if(chunk && chunk.length+word.length+1>1400){
        if(!isCurrent())return null;
        translated.push(await translator.translate(chunk));chunk="";
      }
      chunk+=(chunk?" ":"")+word;
    }
    if(chunk){if(!isCurrent())return null;translated.push(await translator.translate(chunk));}
    result.push(translated.join(" "));
  }
  return result.join("\n\n");
}
