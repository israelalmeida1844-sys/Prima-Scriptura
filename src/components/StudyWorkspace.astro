inlineButton("mark").onclick=()=>{
  const passage=currentReading();
  const key=passage.book+" "+passage.ref;
  const next=new Set(marks);
  const marked=!next.has(key);
  if(marked)next.add(key);else next.delete(key);
  try{
    localStorage.setItem(marksKey,JSON.stringify([...next]));
    marks=next;
    inlineButton("mark").setAttribute("aria-pressed",String(marked));
    inlineActions.closest(".verse-line")?.classList.toggle("marked-verse",marked);
    inlineStatus.textContent=marked?"Versículo marcado.":"Marcação removida.";
  }catch{inlineStatus.textContent="Não foi possível salvar a marcação.";}
};
inlineButton("copy").onclick=async()=>{
  const passage=currentReading();
  const quote=passage.name+" "+passage.ref+" (Bíblia Livre)\n"+passage.text;
  try{
    await navigator.clipboard.writeText(quote);
    if(currentReading().ref===passage.ref && book.value===passage.book)inlineStatus.textContent="Versículo copiado.";
  }catch{
    openTool("Copiar versículo");
    const output=appendText(toolContent,"textarea","") as HTMLTextAreaElement;
    output.value=quote;
    output.readOnly=true;
    output.rows=4;
    output.setAttribute("aria-label","Texto do versículo");
    output.select();
  }
};
function stopListening(){
  utterance=null;
  speechSynthesis.cancel();
  inlineButton("listen").setAttribute("aria-pressed","false");
  inlineButton("listen").textContent="Ouvir";
}
inlineButton("listen").hidden=!("speechSynthesis" in window && "SpeechSynthesisUtterance" in window);
inlineButton("listen").onclick=()=>{
  if(utterance){stopListening();return;}
  const speech=new SpeechSynthesisUtterance(currentReading().text);
  speech.lang="pt-BR";
  const voice=speechSynthesis.getVoices().find(item=>item.lang.toLowerCase().startsWith("pt"));
  if(voice)speech.voice=voice;
  speech.onend=()=>{if(utterance===speech)stopListening();};
  speech.onerror=()=>{if(utterance===speech){stopListening();inlineStatus.textContent="A leitura em voz alta está indisponível neste dispositivo.";}};
  utterance=speech;
  inlineButton("listen").setAttribute("aria-pressed","true");
  inlineButton("listen").textContent="Parar leitura";
  speechSynthesis.speak(speech);
};
if(initial.has("sermao"))location.replace(editorUrl(activeSermon));
const initialTerm=initial.get("termo");
if(initialTerm && initialMode){field("query").value=initialTerm;searchForm.requestSubmit();}
