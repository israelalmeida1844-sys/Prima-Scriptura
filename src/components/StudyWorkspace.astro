inlineButton("context").onclick=()=>{
  const passage=currentReading();
  openTool("Contexto · "+passage.name+" "+passage.ref);
  const options=[...verse.options];
  const index=verse.selectedIndex;
  for(const option of options.slice(Math.max(0,index-3),index+4)){
    const ref=chapter.value+":"+option.value;
    const paragraph=appendText(toolContent,"p",option.value+" · "+pt[ref]);
    paragraph.classList.toggle("context-current",option.selected);
  }
