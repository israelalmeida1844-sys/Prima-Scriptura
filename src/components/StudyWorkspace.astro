---
import Base from "../layouts/Base.astro";
import "../styles/workspace.css";
const {reading = false} = Astro.props;
import { books, names } from "../data/livros";
---
<Base title={reading ? "Bíblia completa" : "Bíblia interlinear"}>
<div class="wrap workspace" data-reading={reading ? "true" : "false"}>
  <div class="workspace-head">
    <div><p class="kicker">Ambiente de estudo</p><h1>{reading ? "Bíblia completa" : "Bíblia interlinear"}</h1></div>
    <div class="reading-actions">
      <button type="button" id="font-down" aria-label="Diminuir fonte">A−</button>
      <button type="button" id="font-up" aria-label="Aumentar fonte">A+</button>
      <button type="button" id="reading-focus" aria-pressed="false">Modo foco</button>
    </div>
  </div>
  <div class="passage-controls">
    <label>Livro <select id="book">{books.map((b,i)=><option value={b} data-rtl={i<39?"yes":"no"}>{names[i]}</option>)}</select></label>
    <label>Capítulo <select id="chapter"></select></label>
    <label>Versículo <select id="verse"></select></label>
  </div>
  <div class="verse-nav">
    <button id="prev-verse" type="button" aria-label="Versículo anterior">←</button>
    <div id="verse-strip" role="group" aria-label="Selecionar versículo"></div>
    <button id="next-verse" type="button" aria-label="Próximo versículo">→</button>
  </div>
  <p id="status" role="status"></p>
  <div class="study-columns">
    <div class="study-main">
      <div id="bible-reading">
        <div><p class="kicker"><a href="/interlinear-enrichment/CREDITOS.md">Bíblia Livre</a></p><h2 id="passage-title"></h2></div>
        <div id="pt-text" dir="ltr"></div>
        <section id="verse-actions" aria-label="Ferramentas do versículo" hidden>
          <div class="verse-action-row">
            <button type="button" id="inline-tools" aria-expanded="true" aria-controls="verse-quick-actions">Ferramentas</button>
            <button type="button" id="inline-original">Original</button>
            <button type="button" id="inline-syntax">Sintaxe</button>
            <button type="button" id="inline-compare">Comparar</button>
            <button type="button" id="inline-cross">Cruzadas</button>
            <button type="button" id="inline-literature">Literatura</button>
            <button type="button" id="inline-context">Contexto</button>
            <button type="button" id="inline-comment">Comentários</button>
          </div>
          <div id="verse-quick-actions" class="verse-action-row">
            <button type="button" id="inline-create">Elaborar sermão</button>
            <button type="button" id="inline-attach">Anexar ao sermão</button>
            <button type="button" id="inline-mark" aria-pressed="false">Marcar</button>
            <button type="button" id="inline-listen" aria-pressed="false">Ouvir</button>
            <button type="button" id="inline-copy">Copiar</button>
          </div>
          <div id="verse-feedback" role="status"></div>
        </section>
      </div>
      <div class="original-heading"><h2>Texto original</h2><button type="button" id="toggle-interlinear" aria-expanded={String(!reading)} aria-controls="words">{reading ? "Mostrar interlinear" : "Recolher interlinear"}</button></div>
      <section id="words" aria-label="Palavras do versículo" hidden={reading}></section>
    </div>
    <aside class="study-aside" aria-label="Ferramentas acadêmicas">
      <details id="verse-tools"><summary>Ferramentas</summary><div class="verse-tools-menu">
        <button id="tool-sermon" type="button">Adicionar ao sermão</button>
        <a id="view-sermon" href="/sermoes/">Abrir editor de sermões</a>
        <button id="tool-compare" type="button">Comparação de traduções</button>
        <button id="tool-comment" type="button">Comentários bíblicos</button>
        <button id="tool-exegesis" type="button">Exegese</button>
        <button id="tool-criticism" type="button">Crítica textual</button>
        <a id="tool-chronology" href="/cronologia/">Cronologia bíblica</a>
      </div></details>
<dialog id="study-tool-dialog" aria-labelledby="study-tool-title"><form method="dialog"><button>Fechar</button></form><h2 id="study-tool-title"></h2><div id="study-tool-content"></div></dialog><details id="syntax-panel"><summary>Análise sintática</summary><h2 id="syntax-title">Análise sintática</h2><button id="syntax-open" type="button">Ver árvore sintática do versículo</button><div id="syntax-content" aria-live="polite"></div><p><a href="/interlinear-syntax/CREDITOS.md">Fontes e limites da análise sintática</a></p></details><details id="commentary-panel"><summary>Comentários bíblicos clássicos</summary><h2 id="commentary-title">Comentários bíblicos clássicos</h2><p>Leia os comentários em português sem sair do Prima Scriptura. Traduções revisadas têm prioridade; traduções automáticas são identificadas e podem conter imprecisões. A referência dos módulos é KJV; no Antigo Testamento a numeração pode divergir da do Texto Massorético. Confirme a referência antes de consultar.</p><label>Livro (KJV) <select id="comment-book">{books.map((b,i)=><option value={b}>{names[i]}</option>)}</select></label><label>Capítulo <input id="comment-chapter" type="number" min="1" value="1"/></label><label>Versículo <input id="comment-verse" type="number" min="0" value="1"/></label><button id="comment-copy" type="button">Copiar referência numérica do interlinear</button><label>Autor <select id="comment-author"><option value="">Comparar todos</option></select></label><label>Idioma <select id="comment-lang"><option value="pt" selected>Português</option><option value="en">Inglês original</option></select></label><button id="comment-open" type="button">Consultar comentários</button><div id="comment-content" aria-live="polite"></div><p><a href="/commentaries/CREDITOS.md">Créditos e licenças</a>. Consulte as edições nesta página.</p></details><details id="exegesis-panel"><summary>Notas exegéticas</summary><h2>Notas exegéticas — Prima Scriptura</h2><button id="exegesis-open" type="button">Consultar notas editoriais</button><div id="exegesis-content" aria-live="polite"></div></details><details id="criticism-panel"><summary>Crítica textual</summary><h2>Nota de crítica textual</h2><button id="criticism-open" type="button">Consultar aparato e notas da fonte</button><div id="criticism-content" aria-live="polite"></div><p><a href="/textual-criticism/CREDITOS.md">Fontes e escopo</a></p></details></aside></div>
<details id="busca" class="search-panel"><summary>Concordância e pesquisa no texto original</summary>
<form id="lex-search"><h2>Concordância e pesquisa avançada</h2><label>Tipo de consulta <select id="search-mode"><option value="original">Palavra original</option><option value="lema">Lema / verbete lexical</option><option value="strong">Strong</option><option value="transliteracao">Transliteração</option><option value="glosa">Glosa contextual</option><option value="morfologia">Código morfológico</option></select></label><label>Termo <input id="query" /></label><label><input type="checkbox" id="search-loose" /> Ignorar diacríticos</label><label>Testamento <select id="search-testament"><option value="">Todos</option><option value="ot">Antigo</option><option value="nt">Novo</option></select></label><label>Livro <select id="search-book"><option value="">Todos</option>{books.map((b,i)=><option value={b}>{names[i]}</option>)}</select></label><label>Capítulo <input type="number" min="1" id="search-chapter" /></label><label>Idioma <select id="search-language"><option value="">Todos</option><option value="grc">Grego</option><option value="hbo">Hebraico</option><option value="arc">Aramaico</option></select></label><fieldset><legend>Características morfológicas (no mesmo componente)</legend><div id="search-features"></div></fieldset><button type="submit">Pesquisar</button><p>Busca por palavra ou glosa inteira. No hebraico e aramaico, o lema consulta os verbetes vinculados ao Strong, sem determinar a acepção contextual.</p></form><p id="search-status" role="status"></p><section id="hits" aria-label="Ocorrências"></section><div id="search-pagination" aria-label="Paginação"></div></details><details class="search-panel"><summary>Fontes e metodologia</summary><p>Glossas de fonte aberta: importadas e verificadas estruturalmente, alinhadas automaticamente ou pendentes. As verificações automáticas não equivalem à revisão semântica humana. <a href="/interlinear-enrichment/CREDITOS.md">Créditos e licenças</a>. <a href="/interlinear-strong-review/CREDITOS.md">Fontes dos índices Strong</a>. <a href="/interlinear-transliteration/CONVENCOES.md">Convenções e limites da transliteração</a>. <a href="/interlinear-morphology/METODOLOGIA.md">Metodologia morfológica</a>. <a href="/interlinear-lexicon/CREDITOS.md">Fontes lexicais</a>.</p></details><dialog id="lex-dialog" aria-labelledby="lex-title"><form method="dialog"><button>Fechar</button></form><h2 id="lex-title">Ficha lexical</h2><div id="lex-content"></div></dialog>
<p>Fontes: <a href="https://github.com/morphgnt/sblgnt">MorphGNT / SBLGNT</a>; <a href="https://github.com/openscriptures/morphhb">Original work of the Open Scriptures Hebrew Bible</a>. Consulte as licenças originais.</p></div>
<script>
import { marcos } from "../data/cronologia";
import { renderConcordance, type Occurrence } from "../scripts/concordancia-lexical";
import { addCitation, loadSermons, newSermon, saveSermon } from "../data/sermoes";
import { books as canon, helloAoBooks } from "../data/livros";
type Token={text:string;lemma?:string;morph?:string;gloss_pt?:string;pos?:string};
const book=document.querySelector<HTMLSelectElement>("#book")!,chapter=document.querySelector<HTMLSelectElement>("#chapter")!,verse=document.querySelector<HTMLSelectElement>("#verse")!,status=document.querySelector<HTMLElement>("#status")!,words=document.querySelector<HTMLElement>("#words")!;
type Extra={gloss_pt?:string;strong?:string;source_flag?:string;gloss_status?:string;gloss_reason?:string}; type Match={source_ref:string|null;words:Extra[]};
type StrongEntry={ids:string[];status:string;extended_ids?:string[];components?:{raw:string;id?:string;sense_suffix?:string}[]};
let strongData:Record<string,StrongEntry[]>={};
type Translit={value:string|null;status:string;language:string;flags:string[]};
let translitData:Record<string,Translit[]>={};
type MorphEntry={descricao:string|null;status:string;motivo?:string};
let morphCatalog:Record<string,MorphEntry>={};
let data:Record<string,Token[]>={}; let extra:Record<string,Match>={};let pt:Record<string,string>={}; let serial=0;
const workspace = document.querySelector<HTMLElement>(".workspace")!;
const reading = workspace.dataset.reading === "true";
const strip = document.querySelector<HTMLElement>("#verse-strip")!;
const title = document.querySelector<HTMLElement>("#passage-title")!;
const initial = new URLSearchParams(location.search);
const chronology = document.querySelector<HTMLAnchorElement>("#tool-chronology")!;
let originalsByTranslation = new Map<string,string>();
const inlineActions=document.querySelector<HTMLElement>("#verse-actions")!;
const inlineStatus=document.querySelector<HTMLElement>("#verse-feedback")!;
let inlineOpen=false;
let utterance:SpeechSynthesisUtterance|null=null;
const marksKey="prima-scriptura-verse-marks-v1";
let marks=new Set<string>();
try { marks=new Set(JSON.parse(localStorage.getItem(marksKey)||"[]")); } catch {}
const ptText=document.querySelector<HTMLElement>("#pt-text")!;
async function optional(url:string){try{const r=await fetch(url);return r.ok?await r.json():{};}catch{return {};}}
function options(el:HTMLSelectElement,values:string[]){el.replaceChildren(...values.map(v=>new Option(v,v)));}
type LexEntry={source_id:string;disambiguated_id:string;unique_id:string;headword:string;transliteration:string;lexical_morphology:string;gloss_en:string;definition_en:string;source_line:number};
type LexCard={id:string;source:string;entries:LexEntry[];occurrence_count:number;observed_portuguese_glosses:{gloss:string;count:number}[]};
const lexDialog=document.querySelector<HTMLDialogElement>("#lex-dialog")!,lexContent=document.querySelector<HTMLElement>("#lex-content")!;
let lexSerial=0;
const lexCache=new Map<string,Promise<any>>();
async function lexShard(folder:string,key:string){
  const digest=await crypto.subtle.digest("SHA-256",new TextEncoder().encode(key));
  const file=new Uint8Array(digest)[0].toString(16).padStart(2,"0");
  const url="/interlinear-lexicon/"+folder+"/"+file+".json";
  if(!lexCache.has(url))lexCache.set(url,optional(url));
  return await lexCache.get(url);
}
function appendText(parent:HTMLElement,tag:string,value:string){const node=document.createElement(tag);node.textContent=value;node.dir="auto";parent.append(node);return node;}
type EditorialLexicon=Record<string,{lemma:string;definitions:string[]}>;
let editorialLexicon:Promise<EditorialLexicon>|undefined;
async function openLex(token:Token,add:Extra|undefined,strong:StrongEntry|undefined, fields:HTMLElement[], index:number){
  const serial=++lexSerial;
  const isCurrent=()=>serial===lexSerial && lexDialog.open;
  lexContent.replaceChildren();
  if(!lexDialog.open)lexDialog.showModal();
  const heading=appendText(lexContent,"h3",token.text);
  heading.className="lex-headword";
  const definition=appendText(lexContent,"div","");
  definition.className="lex-definition";
  const definitionWait=appendText(definition,"p","Carregando definição…");
  const gloss=add?.gloss_pt?.replaceAll("-"," ");
  if(gloss)appendText(lexContent,"p","Neste versículo · "+gloss);
  const syntax=appendText(lexContent,"button","Consultar sintaxe da palavra") as HTMLButtonElement;
  syntax.type="button";
  syntax.onclick=()=>{lexDialog.close();openPanel("syntax");void showSyntax(index);};
  const concordance=appendText(lexContent,"section","");
  concordance.className="lex-concordance";
  appendText(concordance,"p","Carregando concordância…");
  const technical=document.createElement("details");
  appendText(technical,"summary","Morfologia, códigos e fontes");
  if(strong?.status)appendText(technical,"p","Associação Strong · "+strong.status);
  if(strong?.components?.length)appendText(technical,"p","Componentes OSHB · "+strong.components.map(component=>component.raw).join(" / "));
  for(const field of fields)technical.append(field.cloneNode(true));
  const credits=appendText(technical,"a","Créditos lexicais e metodologia") as HTMLAnchorElement;
  credits.href="/interlinear-lexicon/CREDITOS.md";
  lexContent.append(technical);
  const ids=strong?.ids || [];
  const lemmaKey=token.pos&&token.lemma?"grc:"+token.lemma.trim().toLowerCase().normalize("NFC"):null;
  const scope=document.createElement("select");
  for(const id of ids)scope.add(new Option(id,"strong:"+id));
  if(lemmaKey)scope.add(new Option("Lema grego","lemma"));
  if(!scope.length)scope.add(new Option("Forma exata","form"));
  if(scope.length>1){
    const label=appendText(lexContent,"label","Índice da concordância ");
    label.append(scope);
    lexContent.insertBefore(label,concordance);
  }
  const cardsPromise=Promise.all(ids.map(async id=>(await lexShard("cards",id.toLowerCase()))[id] as LexCard|undefined));
  editorialLexicon ??=requiredJson("/lexico-pt.json").catch(()=>{editorialLexicon=undefined;return {};});
  let chartLemma=token.lemma && token.pos?token.lemma:token.text;
  async function showDefinition(){
    const [editorial,cards]=await Promise.all([editorialLexicon!,cardsPromise]);
    if(!isCurrent())return;
    definitionWait.remove();
    const primary=(lemmaKey && editorial[lemmaKey]) || ids.map(id=>editorial[id]).find(Boolean);
    const entries=cards.flatMap(card=>card?.entries || []);
    chartLemma=primary?.lemma || entries[0]?.headword || chartLemma;
    heading.textContent=chartLemma;
    if(primary){
      appendText(definition,"h4","Definição");
      for(const text of primary.definitions)appendText(definition,"p",text);
    }else if(entries.length){
      appendText(definition,"h4","Definição em inglês");
      const summaries=[...new Set(entries.map(entry=>entry.gloss_en.trim()).filter(Boolean))];
      if(summaries.length)appendText(definition,"p",summaries.join(" · "));
      else appendText(definition,"p",entries[0].definition_en);
    }else appendText(definition,"p","Definição lexical indisponível para esta palavra.");
    for(const card of cards){
      if(!card)continue;
      appendText(technical,"h4",card.id+" · "+card.source+" — STEP Bible");
      for(const entry of card.entries){
        const section=document.createElement("section");
        section.className="lex-entry";
        appendText(section,"h5",entry.headword+" · "+entry.transliteration);
        appendText(section,"p",[entry.source_id,entry.disambiguated_id,entry.unique_id,entry.lexical_morphology].filter(Boolean).join(" · "));
        appendText(section,"p",entry.definition_en);
        appendText(section,"small","STEP Bible · "+card.source+" · linha "+entry.source_line+" · CC BY 4.0");
        technical.append(section);
      }
    }
  }
  const definitionReady=showDefinition().catch(()=>{if(isCurrent())definitionWait.textContent="Não foi possível carregar a definição.";});
  const nameMap=Object.fromEntries([...book.options].map(option=>[option.value,option.text]));
  let concordanceSerial=0;
  async function showConcordance(){
    const run=++concordanceSerial;
    const current=()=>isCurrent() && run===concordanceSerial;
    const selected=scope.value;
    concordance.replaceChildren();
    const loading=appendText(concordance,"p","Carregando concordância…");
    try{
      const meta=await metaPromise;
      const id=selected.startsWith("strong:")?selected.slice(7):"";
      const label=id || (selected==="lemma"?"Lema grego":"Forma exata");
      let locations:SearchLoc[];
      if(selected==="lemma" && lemmaKey){
        const refs=(await lexShard("lemas",lemmaKey))[lemmaKey] as [string,string,number][]|undefined;
        locations=[];
        const tables=new Map<string,Promise<SearchTable>>();
        for(const [b] of refs || [])if(!tables.has(b))tables.set(b,tableFor(meta,meta.books.indexOf(b)));
        const references=new Map<string,Map<string,number>>();
        for(const [b,table] of tables)references.set(b,new Map((await table).refs.map((ref,i)=>[ref,i])));
        for(const [b,ref,i] of refs || []){
          const v=references.get(b)?.get(ref);
          if(v!==undefined)locations.push([meta.books.indexOf(b),v,i]);
        }
      }else{
        const mode=id?"strong":"original";
        locations=await indexLocations(meta,mode,normalizeQuery(id || token.text,mode,false),false);
      }
      if(!current())return;
      const booksWithHits=[...new Set(locations.map(([b])=>b))];
      const tables=new Map<number,SearchTable>();
      for(let i=0;i<booksWithHits.length;i+=6){
        await Promise.all(booksWithHits.slice(i,i+6).map(async b=>{tables.set(b,await tableFor(meta,b));}));
        if(!current())return;
      }
      const occurrences:Occurrence[]=locations.map(([b,v,i])=>{
        const table=tables.get(b)!;
        return {book:meta.books[b],reference:table.refs[v],index:i,word:table.rows[v][i][0],gloss:table.rows[v][i][3]};
      });
      await definitionReady;
      if(!current())return;
      renderConcordance(concordance,occurrences,chartLemma,label,nameMap,row=>{
        lexDialog.close();
        void goToOccurrence(row.book,row.reference,row.index);
      });
    }catch{if(current())loading.textContent="Não foi possível carregar a concordância.";}
  }
  scope.onchange=()=>void showConcordance();
  void showConcordance();
}
type SynNode={kind:"wg"|"w";parent:number|null;attrs:Record<string,string>;sentence:string;source_group?:number;source_id?:string;source_ref?:string;token?:number;component?:number};
type SynVerse={method:string;matched:number;source_word_count:number;words:{status:string;nodes:number[];component_match?:boolean;reason?:string}[];nodes:SynNode[];sentences:Record<string,string[]>};
const syntaxContent=document.querySelector<HTMLElement>("#syntax-content")!,syntaxOpen=document.querySelector<HTMLButtonElement>("#syntax-open")!;
let syntaxSerial=0;
const syntaxCache=new Map<string,Promise<Record<string,SynVerse>>>();
const roleNames:Record<string,string>={s:"Sujeito",v:"Verbo",o:"Objeto",io:"Objeto indireto",adv:"Adverbial",pp:"Grupo preposicional",p:"Predicado",aux:"Auxiliar"};
const groupNames:Record<string,string>={cl:"Oração",np:"Sintagma nominal",vp:"Sintagma verbal",pp:"Sintagma preposicional",adjp:"Sintagma adjetival",advp:"Sintagma adverbial"};
function describeSyn(n:SynNode){
  const a=n.attrs;return [a.role?(a.role.startsWith("err_")?"Diagnóstico da fonte — função não validada":((roleNames[a.role]||"Função da fonte")+" ["+a.role+"]")):"",a.class?((groupNames[a.class]||a.class)+" ["+a.class+"]"):"",a.rule||a.Rule?"Regra: "+(a.rule||a.Rule):"",a.clauseType?"Tipo de oração: "+a.clauseType:"",a.junction?"Junção: "+a.junction:"",a.predication?"Predicação: "+a.predication:"",a.head==="true"?"Núcleo indicado pela fonte":""].filter(Boolean).join(" · ")||"Grupo sem rótulo explícito";
}
async function showSyntax(selected?:number){
  const id=++syntaxSerial,b=book.value,ref=originalRef(),ch=ref.split(":")[0],ws=data[ref]||[];
  syntaxContent.replaceChildren();if(!ws.length){appendText(syntaxContent,"p","Sem texto original alinhado para análise nesta referência.");return;}
  appendText(syntaxContent,"p","Carregando análise sintática…");
  try{
    const url="/interlinear-syntax/"+encodeURIComponent(b)+"/"+encodeURIComponent(ch)+".json";
    if(!syntaxCache.has(url)){const p=requiredJson(url);syntaxCache.set(url,p);p.catch(()=>syntaxCache.delete(url));}
    const x=(await syntaxCache.get(url))?.[ref];if(id!==syntaxSerial)return;
    syntaxContent.replaceChildren();if(!x){appendText(syntaxContent,"p","Análise sintática indisponível neste versículo.");return;}
    const coverage=appendText(syntaxContent,"p",x.matched+" de "+ws.length+" palavras alinhadas · MACULA · "+(x.method==="versiculo_integral"?"sequência integral":"alinhamento parcial conservador"));coverage.id="syntax-coverage";
    appendText(syntaxContent,"p","Árvore de constituintes projetada no versículo; relações de dependência não são inferidas. Grupos podem abranger outras referências.");
    if(selected!==undefined){
      const m=x.words[selected];
      appendText(syntaxContent,"h3","Função da palavra selecionada: "+ws[selected].text);
      if(!m?.nodes.length)appendText(syntaxContent,"p","Pendente: "+(m?.reason||"sem correspondência segura").replaceAll("_"," ")+".");
      else{
        if(!m.component_match)appendText(syntaxContent,"p","Segmentação diferente da fonte: ligação apenas à palavra inteira.");
        for(const j of m.nodes){
          const chain=[];let k:number|null=j;while(k!==null){chain.unshift(describeSyn(x.nodes[k]));k=x.nodes[k].parent;}
          appendText(syntaxContent,"p",chain.join(" › "));
        }
      }
    }
    const kids=new Map<number|null,number[]>();x.nodes.forEach((n,i)=>{const a=kids.get(n.parent)||[];a.push(i);kids.set(n.parent,a);});
    function tree(parent:HTMLElement,indices:number[]){
      const ul=document.createElement("ul");ul.className="syntax-tree";parent.append(ul);
      for(const i of indices){const n=x.nodes[i],li=document.createElement("li");li.dataset.syntaxNode=String(i);ul.append(li);
        if(n.kind==="w"){
          const token=n.token!;const raw=ws[token]?.text||"";
          const display=n.component!==undefined?(raw.split("/")[n.component]||raw):raw;
          const btn=document.createElement("button");btn.type="button";btn.textContent=display+" · "+describeSyn(n);btn.dir="auto";btn.dataset.syntaxToken=String(token);btn.onclick=()=>{const card=words.querySelector<HTMLElement>('[data-token-index="'+token+'"]');card?.scrollIntoView({block:"nearest",inline:"center"});showSyntax(token);};
          if(token===selected)btn.classList.add("syntax-selected");li.append(btn);appendText(li,"small"," "+n.source_id+" · "+n.source_ref);
        }else{appendText(li,"strong",describeSyn(n));if(n.parent===null)appendText(li,"small"," · frase: "+(x.sentences[n.sentence]||[]).join(", "));}
        if(kids.has(i))tree(li,kids.get(i)!);
      }
    }
    tree(syntaxContent,kids.get(null)||[]);
    if(x.matched<ws.length){
      const section=document.createElement("section");section.id="alternate-syntax";syntaxContent.append(section);
      appendText(section,"h3","Leituras alternativas e revisão filológica");
      try{
