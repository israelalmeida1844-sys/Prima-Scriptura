inlineButton("cross").onclick=()=>{
  const passage=currentReading();
  openTool("Referências cruzadas");
  appendText(toolContent,"p",passage.name+" "+passage.ref+" · Consulta externa");
  showLink(toolContent,"Consultar referências no OpenBible.info ↗","https://www.openbible.info/labs/cross-references/search?"+new URLSearchParams({q:passage.book+" "+passage.ref})).target="_blank";
};
inlineButton("literature").onclick=()=>{
  const passage=currentReading();
  openTool("Literatura de apoio");
  appendText(toolContent,"p","Recursos bibliográficos para o estudo de "+passage.name+".");
  showLink(appendText(toolContent,"p",""),"Pesquisar "+passage.name+" na biblioteca","/pesquisa/?"+new URLSearchParams({termo:passage.name}));
  showLink(appendText(toolContent,"p",""),"Fontes dos comentários clássicos","/commentaries/CREDITOS.md");
  showLink(appendText(toolContent,"p",""),"Fontes lexicais","/interlinear-lexicon/CREDITOS.md");
