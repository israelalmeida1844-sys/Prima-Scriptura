---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const comentarios = (await getCollection('comentarios', ({data}) => !data.draft)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const estudos = (await getCollection('estudos', ({data}) => !data.draft)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const livros = Array.from(new Set(comentarios.map(item => item.data.book))).map(name => {
  const chapters = comentarios.filter(item => item.data.book === name);
  return { name, testament: chapters[0].data.testament, chapterCount: chapters.length, link: name === '1 João' ? '/comentarios/1-joao/' : name === 'Daniel' ? '/comentarios/daniel/' : name === 'Hebreus' ? '/comentarios/hebreus/' : '/comentarios/' + chapters[0].id + '/' };
});
const recursos = [
  ['▤', 'Bíblia completa', 'Leia os 66 livros e navegue por capítulo e versículo.', '/biblia/'],
  ['α', 'Bíblia interlinear', 'Consulte o texto original palavra por palavra.', '/interlinear-experimental/'],
  ['¶', 'Comentários bíblicos', 'Consulte exposições e notas por passagem.', '/comentarios/'],
  ['Aa', 'Dicionário e léxico', 'Encontre verbetes por lema ou índice Strong.', '/interlinear-experimental/?modo=lema#busca'],
  ['⌕', 'Concordância bíblica', 'Localize ocorrências no corpus bíblico.', '/interlinear-experimental/#busca'],
  ['◷', 'Cronologia bíblica', 'Percorra as eras do Antigo Testamento.', '/cronologia/'],
  ['✧', 'Estudos temáticos', 'Explore os estudos da biblioteca por assunto.', '/estudos/'],
  ['≡', 'Preparação de sermões', 'Escreva esboços, reúna citações e use o modo púlpito.', '/sermoes/'],
];

---
<Base title="Estudos bíblicos e comentários">
  <section class="home-hero">
    <div class="wrap home-intro">
      <div>
        <div class="eyebrow">Biblioteca digital de estudos bíblicos</div>
        <h1>Explore as Escrituras<br />com profundidade.</h1>
        <p>Leia a Bíblia, consulte os idiomas originais e estude o contexto histórico e literário de cada passagem.</p>
        <div class="actions"><a class="btn" href="/biblia/">Abrir a Bíblia <span aria-hidden="true">→</span></a><a class="btn outline" href="/pesquisa/">Pesquisar na biblioteca</a></div>
      </div>
      <img src="/images/1-joao-hero.webp" alt="Ilustração de João escrevendo sua epístola" fetchpriority="high" />
    </div>
  </section>
  <section class="section resources">
    <div class="wrap">
      <h2>Recursos de estudo</h2>
      <div class="resource-grid">
        {recursos.map(([icon,label,description,href]) => <a class="card resource" href={href}><span aria-hidden="true" class="resource-icon">{icon}</span><h3>{label}</h3><p>{description}</p><span class="resource-arrow" aria-hidden="true">→</span></a>)}
      </div>
    </div>
  </section>
  <section class="section soft">
    <div class="wrap">
      <div class="eyebrow">Biblioteca bíblica</div>
      <h2>Projetos de comentários bíblicos</h2>
      <div class="grid">
        {livros.slice(0,3).map(book => (
          <a class="card" href={book.link}>
            <div class="kicker">{book.testament} · ESTUDO POR CAPÍTULOS</div>
            <h3>{book.name} — comentário bíblico</h3>
            <p>Selecione um capítulo para estudar o texto bíblico com explicação, aplicações e referências.</p>
            <strong>Ver capítulos →</strong>
          </a>
        ))}
        <a class="card" href="/comentarios/genesis/">
          <div class="kicker">ANTIGO TESTAMENTO · EDIÇÃO DE AVALIAÇÃO</div>
          <h3>Gênesis — texto original e comentário</h3>
          <p>Explore Gênesis 1:1–8 em hebraico, com transliteração, glosas, análise lexical e concordâncias exaustivas. Conteúdo parcial.</p>
          <strong>Avaliar Gênesis →</strong>
        </a>
      </div>
      {livros.length === 0 && <p>Comentários em preparação.</p>}
    </div>
  </section>
  <section class="section soft">
    <div class="wrap">
      <div class="eyebrow">Conhecimento e reflexão</div>
      <h2>Estudos temáticos</h2>
      <div class="grid">
        {estudos.slice(0,3).map(e => (
          <a class="card" href={'/estudos/' + e.id + '/'}>
            <div class="kicker">{e.data.category}</div>
            <h3>{e.data.title}</h3>
            <p>{e.data.description}</p>
            <strong>Leia o estudo →</strong>
          </a>
        ))}
      </div>
      {estudos.length === 0 && <p>Estudos em preparação.</p>}
    </div>
  </section>
  <section class="section">
    <div class="wrap"><h2>Pesquisar na biblioteca</h2><p>Encontre estudos por assunto, título, livro bíblico ou palavra-chave.</p><a class="btn" href="/pesquisa/">Abrir pesquisa</a></div>
  </section>
</Base>

<style>
.home-hero { color: #f9f3e7; background: #102039; border-bottom: 3px solid #bc9a5e; }
.home-intro { display: grid; grid-template-columns: 1.15fr .85fr; align-items: center; gap: 2rem; padding-block: clamp(2.7rem,7vw,6rem); }
.home-intro h1 { font-size: clamp(2.65rem,6vw,4.8rem); color: #fff8eb; font-weight: 400; margin: .3em 0; line-height: .98; }
.home-intro p { max-width: 42ch; color: #d8e0ec; }
.home-intro img { width: 100%; height: clamp(210px,28vw,360px); object-fit: cover; border: 1px solid #b49a68; border-radius: 5px; }
.home-intro .outline:hover { color: #f5d89a; }
.resources h2 { font-size: clamp(2rem,3.5vw,2.8rem); margin: 0 0 .7em; }
.resource-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 1rem; }
.resource { position: relative; display: block; min-height: 175px; padding: 1.1rem 1.2rem; }
.resource:hover { border-color: var(--accent); }
.resource h3 { margin: .55rem 0 .25rem; font-size: 1.35rem; }
.resource p { margin: 0 0 1rem; font-size: .87rem; line-height: 1.5; }
.resource-icon { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 5px; color: var(--accent); background: var(--panel); font: 1.2rem var(--serif); }
.resource-arrow { position: absolute; right: 1rem; bottom: .5rem; color: var(--accent); }
@media (max-width: 920px) { .resource-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
@media (max-width: 650px) { .home-intro { grid-template-columns: 1fr; } .home-intro img { height: 170px; } }
@media (max-width: 360px) { .resource-grid { grid-template-columns: 1fr; } }
</style>
