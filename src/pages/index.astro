---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const comentarios = (await getCollection('comentarios', ({data}) => !data.draft)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const estudos = (await getCollection('estudos', ({data}) => !data.draft)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const livros = Array.from(new Set(comentarios.map(item => item.data.book))).map(name => {
  const chapters = comentarios.filter(item => item.data.book === name);
  return { name, testament: chapters[0].data.testament, chapterCount: chapters.length, link: name === '1 João' ? '/comentarios/1-joao/' : name === 'Daniel' ? '/comentarios/daniel/' : '/comentarios/' + chapters[0].id + '/' };
});
---
<Base title="Estudos bíblicos e comentários">
  <section class="hero">
    <div class="wrap">
      <div class="eyebrow">Biblioteca digital de estudos bíblicos</div>
      <h1>Explore as Escrituras com profundidade.</h1>
      <p>Comentários bíblicos, estudos temáticos e recursos para compreender o texto sagrado em seu contexto histórico, literário e teológico.</p>
      <div class="actions"><a class="btn" href="/comentarios/">Explorar comentários</a><a class="btn outline" href="/estudos/">Estudos temáticos</a></div>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="eyebrow">Biblioteca bíblica</div>
      <h2>Projetos de comentários bíblicos</h2>
      <div class="grid">
        {livros.slice(0,3).map(book => (
          <a class="card" href={book.link}>
            <div class="kicker">{book.testament} · ESTUDO POR CAPÍTULOS</div>
            <h3>{book.name} — comentário bíblico</h3>
            <p>Selecione um capítulo para estudar o texto bíblico com explicação, aplicações e referências.</p>
            <strong>Ver capítulos →</strong>
          </a>
        ))}
      </div>
      {livros.length === 0 && <p>Comentários em preparação.</p>}
    </div>
  </section>
  <section class="section soft">
    <div class="wrap">
      <div class="eyebrow">Conhecimento e reflexão</div>
      <h2>Estudos temáticos</h2>
      <div class="grid">
        {estudos.slice(0,3).map(e => (
          <a class="card" href={'/estudos/' + e.id + '/'}>
            <div class="kicker">{e.data.category}</div>
            <h3>{e.data.title}</h3>
            <p>{e.data.description}</p>
            <strong>Leia o estudo →</strong>
          </a>
        ))}
      </div>
      {estudos.length === 0 && <p>Estudos em preparação.</p>}
    </div>
  </section>
  <section class="section">
    <div class="wrap"><h2>Pesquisar na biblioteca</h2><p>Encontre estudos por assunto, título, livro bíblico ou palavra-chave.</p><a class="btn" href="/pesquisa/">Abrir pesquisa</a></div>
  </section>
</Base>
