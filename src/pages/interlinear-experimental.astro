---
const books = "Gen Exod Lev Num Deut Josh Judg Ruth 1Sam 2Sam 1Kgs 2Kgs 1Chr 2Chr Ezra Neh Esth Job Ps Prov Eccl Song Isa Jer Lam Ezek Dan Hos Joel Amos Obad Jonah Mic Nah Hab Zeph Hag Zech Mal Matt Mark Luke John Acts Rom 1Cor 2Cor Gal Eph Phil Col 1Thess 2Thess 1Tim 2Tim Titus Phlm Heb Jas 1Pet 2Pet 1John 2John 3John Jude Rev".split(" ");
const names = "Gênesis|Êxodo|Levítico|Números|Deuteronômio|Josué|Juízes|Rute|1 Samuel|2 Samuel|1 Reis|2 Reis|1 Crônicas|2 Crônicas|Esdras|Neemias|Ester|Jó|Salmos|Provérbios|Eclesiastes|Cânticos|Isaías|Jeremias|Lamentações|Ezequiel|Daniel|Oseias|Joel|Amós|Obadias|Jonas|Miqueias|Naum|Habacuque|Sofonias|Ageu|Zacarias|Malaquias|Mateus|Marcos|Lucas|João|Atos|Romanos|1 Coríntios|2 Coríntios|Gálatas|Efésios|Filipenses|Colossenses|1 Tessalonicenses|2 Tessalonicenses|1 Timóteo|2 Timóteo|Tito|Filemom|Hebreus|Tiago|1 Pedro|2 Pedro|1 João|2 João|3 João|Judas|Apocalipse".split("|");
---
<html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Interlinear experimental — Prima Scriptura</title></head><body>
<main><h1>Prima Scriptura — Interlinear experimental</h1><p>Dados de pesquisa; numeração conforme a fonte original. Glossas ausentes não são inferidas.</p>
<label>Livro <select id="book">{books.map((b,i)=><option value={b} data-rtl={i<39?"yes":"no"}>{names[i]}</option>)}</select></label>
<label>Capítulo <select id="chapter"></select></label>
<label>Versículo <select id="verse"></select></label>
<p id="status" role="status"></p><p id="pt-text" dir="ltr"></p><p>Glossas de fonte aberta: importadas e verificadas estruturalmente, alinhadas automaticamente ou pendentes. As verificações automáticas não equivalem à revisão semântica humana. <a href="/interlinear-enrichment/CREDITOS.md">Créditos e licenças</a>. <a href="/interlinear-strong-review/CREDITOS.md">Fontes dos índices Strong</a>. <a href="/interlinear-transliteration/CONVENCOES.md">Convenções e limites da transliteração</a>. <a href="/interlinear-morphology/METODOLOGIA.md">Metodologia morfológica</a>. <a href="/interlinear-lexicon/CREDITOS.md">Fontes lexicais</a>.</p><form id="lex-search"><label>Concordância: termo original, lema ou Strong <input id="query" required /></label><button>Pesquisar</button></form><p id="search-status" role="status"></p><section id="hits" aria-label="Ocorrências"></section><section id="words" aria-label="Palavras do versículo"></section><dialog id="lex-dialog" aria-labelledby="lex-title"><form method="dialog"><button>Fechar</button></form><h2 id="lex-title">Ficha lexical</h2><div id="lex-content"></div></dialog>
<p>Fontes: <a href="https://github.com/morphgnt/sblgnt">MorphGNT / SBLGNT</a>; <a href="https://github.com/openscriptures/morphhb">Original work of the Open Scriptures Hebrew Bible</a>. Consulte as licenças originais.</p></main>
<script>
type Token={text:string;lemma?:string;morph?:string;gloss_pt?:string;pos?:string};
const book=document.querySelector<HTMLSelectElement>("#book")!,chapter=document.querySelector<HTMLSelectElement>("#chapter")!,verse=document.querySelector<HTMLSelectElement>("#verse")!,status=document.querySelector<HTMLElement>("#status")!,words=document.querySelector<HTMLElement>("#words")!;
type Extra={gloss_pt?:string;strong?:string;source_flag?:string;gloss_status?:string;gloss_reason?:string}; type Match={source_ref:string|null;words:Extra[]};
type StrongEntry={ids:string[];status:string;extended_ids?:string[];components?:{raw:string;id?:string;sense_suffix?:string}[]};
let strongData:Record<string,StrongEntry[]>={};
type Translit={value:string|null;status:string;language:string;flags:string[]};
let translitData:Record<string,Translit[]>={};
type MorphEntry={descricao:string|null;status:string;motivo?:string};
let morphCatalog:Record<string,MorphEntry>={};
let data:Record<string,Token[]>={}; let extra:Record<string,Match>={};let pt:Record<string,string>={}; let serial=0;
const ptText=document.querySelector<HTMLElement>("#pt-text")!;
async function optional(url:string){try{const r=await fetch(url);return r.ok?await r.json():{};}catch{return {};}}
function options(el:HTMLSelectElement,values:string[]){el.replaceChildren(...values.map(v=>new Option(v,v)));}
type LexEntry={source_id:string;disambiguated_id:string;unique_id:string;headword:string;transliteration:string;lexical_morphology:string;gloss_en:string;definition_en:string;source_line:number};
type LexCard={id:string;source:string;entries:LexEntry[];occurrence_count:number;observed_portuguese_glosses:{gloss:string;count:number}[]};
const lexDialog=document.querySelector<HTMLDialogElement>("#lex-dialog")!,lexContent=document.querySelector<HTMLElement>("#lex-content")!;
let lexSerial=0;
const lexCache=new Map<string,Promise<any>>();
async function lexShard(folder:string,key:string){
  const digest=await crypto.subtle.digest("SHA-256",new TextEncoder().encode(key));
  const file=new Uint8Array(digest)[0].toString(16).padStart(2,"0");
  const url="/interlinear-lexicon/"+folder+"/"+file+".json";
  if(!lexCache.has(url))lexCache.set(url,optional(url));
  return await lexCache.get(url);
}
function appendText(parent:HTMLElement,tag:string,value:string){const node=document.createElement(tag);node.textContent=value;node.dir="auto";parent.append(node);return node;}
function occurrenceButtons(parent:HTMLElement,refs:[string,string,number][]){
  const list=document.createElement("div");parent.append(list);let page=0;
  function show(){list.replaceChildren();appendText(list,"p","Ocorrências "+(page*25+1)+"–"+Math.min((page+1)*25,refs.length)+" de "+refs.length);
    for(const [b,ref,i] of refs.slice(page*25,page*25+25)){const btn=document.createElement("button");btn.type="button";btn.textContent=b+" "+ref+" · palavra "+(i+1);btn.onclick=async()=>{lexDialog.close();book.value=b;await load();const [c,v]=ref.split(":");chapter.value=c;chapters();verse.value=v;render();};list.append(btn);}
    for(const [label,delta] of [["Anterior",-1],["Próxima",1]] as const){const btn=document.createElement("button");btn.type="button";btn.textContent=label;btn.disabled=page+delta<0||(page+delta)*25>=refs.length;btn.onclick=()=>{page+=delta;show();};list.append(btn);}
  }if(refs.length)show();
}
async function openLex(token:Token,add:Extra|undefined,strong:StrongEntry|undefined){
  const serial=++lexSerial;lexContent.replaceChildren();if(!lexDialog.open)lexDialog.showModal();
  appendText(lexContent,"h3",token.text);appendText(lexContent,"p","Lema / código da fonte: "+(token.lemma||"Não disponível"));
  appendText(lexContent,"p","Glosa contextual em português: "+(add?.gloss_pt||"Não disponível"));
  appendText(lexContent,"p","Estado da associação Strong: "+(strong?.status||"Pendente"));
  if(strong?.components?.length)appendText(lexContent,"p","Componentes OSHB: "+strong.components.map(c=>c.raw).join(" / "));
  const wait=appendText(lexContent,"p","Carregando léxico…");
  try{
    const ids=strong?.ids||[];const cards=await Promise.all(ids.map(async id=>(await lexShard("cards",id.toLowerCase()))[id] as LexCard|undefined));
    const lemmaKey=token.pos&&token.lemma?"grc:"+token.lemma.trim().toLowerCase().normalize("NFC"):null;
    const lemmaRefs=lemmaKey?(await lexShard("lemas",lemmaKey))[lemmaKey]:null;
    if(serial!==lexSerial||!lexDialog.open)return;wait.remove();
    if(!ids.length)appendText(lexContent,"p","Nenhum número clássico atribuído nesta auditoria. Não há definição inferida.");
    if(lemmaKey&&Array.isArray(lemmaRefs)){const section=document.createElement("details");appendText(section,"summary","Concordância exata do lema grego: "+lemmaRefs.length+" unidades");occurrenceButtons(section,lemmaRefs);lexContent.append(section);}
    for(const [i,card] of cards.entries()){
      if(!card){appendText(lexContent,"p","Ficha indisponível para "+ids[i]);continue;}
      appendText(lexContent,"h3",card.id+" · "+card.source+" — STEP Bible");
      appendText(lexContent,"p","Ocorrências no corpus deste projeto por índice: "+card.occurrence_count);
      appendText(lexContent,"p","Aceções registradas pela fonte (inglês original). Não indicam automaticamente o sentido deste versículo.");
      for(const e of card.entries){const section=document.createElement("section");section.className="lex-entry";
        appendText(section,"h4",e.headword+" · "+e.transliteration);
        appendText(section,"p","Identificadores da fonte: "+[e.source_id,e.disambiguated_id,e.unique_id].filter(Boolean).join(" / "));
        appendText(section,"p","Morfologia lexical da fonte: "+e.lexical_morphology);
        appendText(section,"p","Glosa lexical (EN): "+e.gloss_en);
        appendText(section,"p",e.definition_en);
        appendText(section,"small","STEP Bible · "+card.source+" · linha "+e.source_line+" · CC BY 4.0");
        lexContent.append(section);
      }
      appendText(lexContent,"p","Glosas contextuais portuguesas observadas (até 30 mais frequentes; não são definições lexicais): "+card.observed_portuguese_glosses.map(g=>g.gloss+" ("+g.count+")").join("; "));
      const btn=document.createElement("button");btn.type="button";btn.textContent="Pesquisar todas as ocorrências de "+card.id;
      btn.onclick=()=>{lexDialog.close();document.querySelector<HTMLInputElement>("#query")!.value=card.id;document.querySelector<HTMLFormElement>("#lex-search")!.requestSubmit();};lexContent.append(btn);
    }
  }catch{if(serial===lexSerial)wait.textContent="Não foi possível recuperar a ficha lexical.";}
}
function render(){words.replaceChildren();const key=chapter.value+":"+verse.value,match=extra[key];words.dir=book.selectedOptions[0]?.dataset.rtl==="yes"?"rtl":"ltr";ptText.textContent=match?.source_ref&&pt[match.source_ref]?"BLIVRE "+match.source_ref+": "+pt[match.source_ref]:"";for(const [i,token] of (data[key]||[]).entries()){const add=match?.words[i];const card=document.createElement("article");for(const [label,value] of [["",token.text],["Transliteração",translitData[key]?.[i]?.value||"Não disponível"],["Método de transliteração",({grego_ortografico:"Grego · convenção ortográfica",sbl_automatico:"SBL · automática",sbl_modo_permissivo:"SBL · revisão necessária",pendente:"Pendente"} as Record<string,string>)[translitData[key]?.[i]?.status||""]],["Glosa",add?.gloss_pt],["Estado da glosa",({importada_verificada:"Importada · conferência estrutural",alinhada_automaticamente:"Alinhamento automático · revisão humana pendente",corrigida_pontualmente:"Corrigida pontualmente",pendente:"Pendente de revisão"} as Record<string,string>)[add?.gloss_status||""]],["Strong",strongData[key]?.[i]?.ids?.join(", ")||"Não atribuído"],["Origem do índice",({oshb_direto:"OSHB",dupla_fonte:"Alinhamento e léxico STEP",fonte_direta:"Fonte alinhada; sem confirmação do lema no STEP",lema_univoco:"Lema unívoco no STEP",afixo_sem_numero:"Afixo sem número OSHB",identificador_ampliado:"Identificador ampliado (não clássico)",conflito_lexical:"Conflito entre fontes",lema_ambiguo:"Lema ambíguo"} as Record<string,string>)[strongData[key]?.[i]?.status||""]||"Pendente"],["Identificador ampliado",strongData[key]?.[i]?.extended_ids?.join(", ")],["Lema / ID lexical",token.lemma],["Morfologia em português",morphCatalog[token.pos?token.pos+" "+token.morph:token.morph||""]?.descricao||"Decodificação pendente"],["Código morfológico original",token.pos?token.pos+" "+token.morph:token.morph]]){const p=document.createElement("p");p.dir=label?"auto":words.dir;p.textContent=label?label+": "+(value||"Não disponível"):value||"";if(!label)p.className="original";card.append(p);}const btn=document.createElement("button");btn.type="button";btn.textContent="Ficha lexical";btn.onclick=()=>openLex(token,add,strongData[key]?.[i]);card.append(btn);words.append(card);}}
function chapters(){options(verse,Object.keys(data).filter(k=>k.split(":")[0]===chapter.value).map(k=>k.split(":")[1]));render();}
async function load(){const id=++serial;data={};extra={};pt={};strongData={};translitData={};options(chapter,[]);options(verse,[]);render();status.textContent="Carregando…";try{const slug=encodeURIComponent(book.value);const [res,e,p,s,t,m]=await Promise.all([fetch("/interlinear-corpus/"+slug+".json"),optional("/interlinear-gloss-review/"+slug+".json"),optional("/interlinear-enrichment/portugues/"+slug+".json"),optional("/interlinear-strong-review/tokens/"+slug+".json"),optional("/interlinear-transliteration/"+slug+".json"),Object.keys(morphCatalog).length?Promise.resolve(morphCatalog):optional("/interlinear-morphology/catalogo.json")]);if(!res.ok)throw Error();const next=await res.json();if(id!==serial)return;data=next;extra=e;pt=p;strongData=s;translitData=t;morphCatalog=m;options(chapter,[...new Set(Object.keys(data).map(k=>k.split(":")[0]))]);chapters();status.textContent="";}catch{if(id===serial)status.textContent="Corpus ainda não importado ou indisponível.";}}
const hits=document.querySelector<HTMLElement>("#hits")!,searchStatus=document.querySelector<HTMLElement>("#search-status")!;
let searchSerial=0;
document.querySelector<HTMLFormElement>("#lex-search")!.addEventListener("submit",async ev=>{ev.preventDefault();const id=++searchSerial;hits.replaceChildren();let q=document.querySelector<HTMLInputElement>("#query")!.value.normalize("NFD").toLowerCase().replace(/[^\p{L}\p{N}]/gu,"");q=q.replace(/^([hg])0+(?=\d)/,"$1");if(!q){searchStatus.textContent="Digite um termo.";return;}searchStatus.textContent="Pesquisando…";try{const hash=await crypto.subtle.digest("SHA-256",new TextEncoder().encode(q));const shard=new Uint8Array(hash)[0].toString(16).padStart(2,"0");const r=await fetch("/interlinear-strong-review/concordancia/"+shard+".json");if(!r.ok)throw Error();const found=(await r.json())[q]||[];if(id!==searchSerial)return;searchStatus.textContent=found.length+" ocorrências (até 200 exibidas)";for(const [b,ref,i] of found.slice(0,200)){const btn=document.createElement("button");btn.type="button";btn.textContent=b+" "+ref+" · palavra "+(i+1);btn.addEventListener("click",async()=>{book.value=b;await load();const [c,v]=ref.split(":");chapter.value=c;chapters();verse.value=v;render();});hits.append(btn);}}catch{if(id===searchSerial)searchStatus.textContent="Índice indisponível ou ainda não gerado.";}}); 
book.addEventListener("change",load);chapter.addEventListener("change",chapters);verse.addEventListener("change",render);load();
</script>
<style is:global>body{background:#102440;color:#eee;font-family:"Times New Roman",serif;margin:0}main{max-width:1000px;margin:auto;padding:24px}h1,a{color:#d9b66d}label{display:inline-block;margin:8px}select{padding:8px}#words{display:flex;gap:12px;overflow-x:auto;padding:12px 0} #words article{flex:0 0 auto;border:1px solid #d9b66d;padding:12px;max-width:300px}#words .original{font-size:1.8rem}#words article p{margin:6px} #hits button{margin:4px;padding:6px} #lex-dialog{width:min(760px,90vw);max-height:85vh;overflow:auto;background:#102440;color:#eee;border:1px solid #d9b66d;padding:20px}#lex-dialog::backdrop{background:#0009}#lex-dialog form{float:right}#lex-dialog button{margin:4px;padding:6px}#lex-dialog .lex-entry{border-top:1px solid #8b774d;padding:10px 0;white-space:pre-wrap;overflow-wrap:anywhere}</style></body></html>