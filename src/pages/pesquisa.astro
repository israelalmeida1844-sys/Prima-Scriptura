---
import Base from "../layouts/Base.astro";
import {getCollection} from "astro:content";
import {marcos} from "../data/cronologia";
import {books,names} from "../data/livros";
const comentarios=await getCollection("comentarios",({data})=>!data.draft);
const estudos=await getCollection("estudos",({data})=>!data.draft);
const slugs:Record<string,string>={"1 João":"1-joao","Hebreus":"hebreus","Daniel":"daniel","Gênesis":"genesis","Apocalipse":"apocalipse"};
const items=[
  ...comentarios.map(x=>({title:x.data.title,description:x.data.description,href:slugs[x.data.book]?"/comentarios/"+slugs[x.data.book]+"/capitulo-"+x.data.chapter+"/":"/comentarios/"+x.id+"/",terms:[x.data.book,x.data.verses,...x.data.tags].join(" "),type:"Comentário"})),
  ...estudos.map(x=>({title:x.data.title,description:x.data.description,href:"/estudos/"+x.id+"/",terms:[x.data.category,...x.data.tags].join(" "),type:"Estudo"}))
];
---
<Base title="Pesquisa avançada">
  <section class="section"><div class="wrap advanced">
    <h1>Pesquisa avançada</h1>
    <nav class="search-links" aria-label="Pesquisa no texto original">
      {Object.entries({original:"Palavra original",lema:"Lema",strong:"Strong",morfologia:"Morfologia"}).map(([id,label])=><a class="ps-control" href={`/interlinear-experimental/?modo=${id}#busca`}>{label}</a>)}
    </nav>
    <form id="advanced">
      <label>Pesquisar em
        <select class="ps-control" id="scope"><option value="library">Biblioteca</option><option value="translation">Tradução · Bíblia Livre</option><option value="person">Personagens da cronologia</option><option value="event">Acontecimentos históricos</option></select>
      </label>
      <label id="book-control" hidden>Livro
        <select class="ps-control" id="book-filter"><option value="">Todos</option>{books.map((book,i)=><option value={book}>{names[i]}</option>)}</select>
      </label>
      <label id="type-control">Tipo de conteúdo<select class="ps-control" id="type-filter"><option value="">Todos</option><option>Comentário</option><option>Estudo</option></select></label>
      <label class="term">Palavra ou expressão
        <input class="ps-control" id="term" type="search" required placeholder="Ex. criação, reino de Deus, Moisés" />
      </label>
      <button type="submit" class="btn">Pesquisar</button>
    </form>
    <p id="count" role="status"></p>
    <div class="results" id="results"></div>
    <div id="result-pages"></div>
  </div></section>
  <script define:vars={{items,marcos,books,names}}>
    const form=document.querySelector("#advanced");
    const scope=document.querySelector("#scope");
    const filter=document.querySelector("#book-filter");
    const type=document.querySelector("#type-filter");
    const input=document.querySelector("#term");
    const results=document.querySelector("#results");
    const pagination=document.querySelector("#result-pages");
    const count=document.querySelector("#count");
    const norm=s=>s.toLocaleLowerCase("pt-BR").normalize("NFD").replace(/\p{M}/gu,"").replace(/\s+/gu," ").trim();
    let request=0;
    let controller;
    scope.onchange=()=>{
      controller?.abort();
      request++;
      document.querySelector("#book-control").hidden=scope.value!=="translation";
      document.querySelector("#type-control").hidden=scope.value!=="library";
      count.textContent="";
      results.replaceChildren();
      pagination.replaceChildren();
    };
    form.onsubmit=async event=>{
      event.preventDefault();
      controller?.abort();
      controller=new AbortController();
      const signal=controller.signal;
      const id=++request;
      const query=norm(input.value);
      if(!query)return;
      count.textContent="Pesquisando…";
      results.replaceChildren();
      pagination.replaceChildren();
      let matches=[];
      let failed=0;
      if(scope.value==="translation"){
        const selected=filter.value?[filter.value]:books;
        for(let i=0;i<selected.length;i+=8){
          const group=selected.slice(i,i+8);
          const responses=await Promise.allSettled(group.map(async book=>{
            const response=await fetch("/interlinear-enrichment/portugues/"+book+".json",{signal});
            if(!response.ok)throw Error("Texto indisponível");
            return await response.json();
          }));
          if(id!==request)return;
          for(const [j,response] of responses.entries()){
            if(response.status==="rejected"){failed++;continue;}
            const book=group[j];
            for(const [ref,text] of Object.entries(response.value)){
              if(norm(text).includes(query))matches.push({title:names[books.indexOf(book)]+" "+ref,description:text,href:"/biblia/?livro="+book+"&ref="+ref,type:"Bíblia Livre"});
            }
          }
        }
      }else if(scope.value==="library"){
        matches=items.filter(item=>(!type.value||type.value===item.type)&&norm([item.title,item.description,item.terms].join(" ")).includes(query));
      }else{
        const people=scope.value==="person";
        matches=marcos.filter(item=>norm(people?item.pessoas.join(" "):[item.titulo,item.periodo,item.nota].join(" ")).includes(query)).map(item=>({
          title:item.titulo,description:item.data+" · "+item.passagem,
          href:"/cronologia/#"+item.id,type:people?item.pessoas.join(", "):item.periodo,
          passage:"/biblia/?livro="+item.livro+"&ref="+item.ref
        }));
      }
      count.textContent=matches.length+" resultados"+(failed?" · "+failed+" livros indisponíveis":"");
      const size=30;
      function render(page){
        results.replaceChildren();
        pagination.replaceChildren();
        for(const item of matches.slice(page*size,(page+1)*size)){
          const row=document.createElement("article");
          const main=document.createElement("a");
          main.href=item.href;
          const heading=document.createElement("strong");
          heading.textContent=item.title;
          const summary=document.createElement("small");
          summary.textContent=item.type+" · "+item.description;
          main.append(heading,summary);
          row.append(main);
          if(item.passage){const a=document.createElement("a");a.href=item.passage;a.textContent="Abrir passagem →";row.append(a);}
          results.append(row);
        }
        for(const [label,delta] of [["Anterior",-1],["Próxima",1]]){
          if(matches.length<=size)break;
          const button=document.createElement("button");
          button.className="ps-control";
          button.textContent=label;
          button.disabled=page+delta<0||(page+delta)*size>=matches.length;
          button.onclick=()=>{render(page+delta);count.scrollIntoView({block:"start"});};
          pagination.append(button);
        }
      }
      render(0);
    };
    const initialTerm=new URLSearchParams(location.search).get("termo");
    if(initialTerm){input.value=initialTerm;form.requestSubmit();}

  </script>
</Base>
<style>
.advanced h1 { margin-top: 0; }
.advanced form { display: flex; flex-wrap: wrap; align-items: end; gap: .8rem; margin: 1.4rem 0; }
.advanced label { display: grid; gap: .25rem; max-width: 100%; }
.advanced .term { flex: 1 1 16rem; }
.search-links { gap: .5rem; }
.search-links a { display: inline-flex; align-items: center; }
.advanced .results a { border-color: var(--line); overflow-wrap: anywhere; }
.advanced .results small { font: 1rem/1.5 var(--serif); }
.advanced .results article > a:nth-child(2) { padding-block: .4rem; color: var(--accent); }
#result-pages { display: flex; gap: .4rem; margin-top: .8rem; }
</style>
