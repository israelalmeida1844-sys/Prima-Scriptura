---
import Base from '../layouts/Base.astro';import {getCollection} from 'astro:content';
const c=await getCollection('comentarios',({data})=>!data.draft);const e=await getCollection('estudos',({data})=>!data.draft);
const items=[...c.map(x=>({title:x.data.title,description:x.data.description,href:'/comentarios/'+x.id+'/',terms:[x.data.book,x.data.verses,...x.data.tags].join(' '),type:'Comentário'})),...e.map(x=>({title:x.data.title,description:x.data.description,href:'/estudos/'+x.id+'/',terms:[x.data.category,...x.data.tags].join(' '),type:'Estudo'}))];
---
<Base title="Pesquisar"><section class="section"><div class="wrap"><h1>Pesquisar conteúdos</h1><p>Busque por títulos, temas e referências.</p><label for="query">Termo de pesquisa</label><input id="query" type="search" placeholder="Ex.: 1 João, santuário, hermenêutica"/><p id="count" aria-live="polite"></p><div class="results" id="results"></div></div></section><script define:vars={{items}}>
const input=document.getElementById('query'),results=document.getElementById('results'),count=document.getElementById('count');const norm=s=>s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');function update(){const q=norm(input.value.trim());const found=items.filter(x=>!q||norm(x.title+' '+x.description+' '+x.terms).includes(q));results.replaceChildren();count.textContent=`${found.length} conteúdo(s) encontrado(s)`;for(const x of found){const a=document.createElement('a');a.href=x.href;const b=document.createElement('strong');b.textContent=x.title;const s=document.createElement('small');s.textContent=x.type+' — '+x.description;a.append(b,s);results.append(a)}}input.addEventListener('input',update);update();
</script></Base>
