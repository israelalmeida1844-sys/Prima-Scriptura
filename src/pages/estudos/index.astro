---
import Base from '../../layouts/Base.astro';import {getCollection} from 'astro:content';
const items=(await getCollection('estudos',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<Base title="Estudos temáticos"><section class="section"><div class="wrap"><div class="eyebrow">Artigos e pesquisas</div><h1>Estudos temáticos</h1><p>Estudos de teologia, profecias, história e interpretação bíblica.</p><div class="grid">{items.map(item=><a class="card" href={'/estudos/'+item.id+'/'}><div class="kicker">{item.data.category}</div><h3>{item.data.title}</h3><p>{item.data.description}</p><strong>Ler estudo →</strong></a>)}</div>{items.length===0&&<p>Não há estudos publicados.</p>}</div></section></Base>
