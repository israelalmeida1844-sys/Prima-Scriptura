---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const categories = ['escatologia', 'eventos finais', 'escatologia/eventos finais', 'escatologia / eventos finais'];
const items = (await getCollection('estudos', ({data}) => !data.draft && categories.includes(data.category.trim().toLocaleLowerCase('pt-BR')))).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const proposals = [
  {
    "number": 1,
    "title": "Fundamentos da escatologia bíblica",
    "description": "Princípios de interpretação profética e esperança cristã.",
    "references": "Dn 2; Mt 24; Ap 1:1–3"
  },
  {
    "number": 2,
    "title": "Os sinais do tempo do fim",
    "description": "Discernimento dos sinais e limites da previsão cronológica.",
    "references": "Mt 24; Lc 21:25–36"
  },
  {
    "number": 3,
    "title": "O juízo investigativo",
    "description": "O juízo celestial na perspectiva historicista adventista.",
    "references": "Dn 7:9–14; 8:14; Ap 14:6–7"
  },
  {
    "number": 4,
    "title": "O selamento do povo de Deus",
    "description": "Identidade, fidelidade e proteção espiritual dos servos de Deus.",
    "references": "Ap 7:1–8; 14:1–5; Ef 4:30"
  },
  {
    "number": 5,
    "title": "A marca da besta",
    "description": "Adoração, autoridade e lealdade no conflito final.",
    "references": "Ap 13:11–18; 14:9–12"
  },
  {
    "number": 6,
    "title": "O decreto dominical",
    "description": "Exame da interpretação adventista sobre coerção religiosa e liberdade de consciência.",
    "references": "Ap 13:11–17; 14:12"
  },
  {
    "number": 7,
    "title": "As três mensagens angélicas",
    "description": "Evangelho eterno, juízo, queda de Babilônia e advertência final.",
    "references": "Ap 14:6–12"
  },
  {
    "number": 8,
    "title": "A sacudidura",
    "description": "Provação, perseverança e fidelidade da comunidade de fé.",
    "references": "Am 9:9; Hb 12:25–29; Ap 3:14–22"
  },
  {
    "number": 9,
    "title": "A chuva serôdia",
    "description": "A obra do Espírito Santo e a metáfora bíblica das chuvas.",
    "references": "Jl 2:23–29; At 2:14–21; Tg 5:7–8"
  },
  {
    "number": 10,
    "title": "O alto clamor",
    "description": "A proclamação final da mensagem divina e o chamado para sair de Babilônia.",
    "references": "Ap 14:6–12; 18:1–4"
  },
  {
    "number": 11,
    "title": "O fechamento da porta da graça",
    "description": "A conclusão da intercessão e a responsabilidade humana diante do juízo.",
    "references": "Dn 12:1; Ap 15:5–8; 22:11–12"
  },
  {
    "number": 12,
    "title": "As sete últimas pragas",
    "description": "Estrutura, simbolismo e função dos juízos finais.",
    "references": "Ap 15–16"
  },
  {
    "number": 13,
    "title": "O tempo de angústia",
    "description": "A crise final, a perseverança e o livramento do povo de Deus.",
    "references": "Jr 30:7; Dn 12:1; Mt 24:21–22"
  },
  {
    "number": 14,
    "title": "O Armagedom",
    "description": "O conflito final e o significado literário e teológico de Armagedom.",
    "references": "Ap 16:12–16; 19:11–21"
  },
  {
    "number": 15,
    "title": "A segunda vinda de Cristo",
    "description": "A esperança do retorno de Jesus e a ressurreição dos justos.",
    "references": "Mt 24:29–31; 1Ts 4:13–18; Ap 19:11–21"
  },
  {
    "number": 16,
    "title": "O milênio",
    "description": "Os mil anos, a ressurreição e o juízo em Apocalipse 20.",
    "references": "Ap 20:1–6; 1Co 6:2–3"
  },
  {
    "number": 17,
    "title": "O juízo executivo",
    "description": "A consumação do juízo divino e o destino final do mal.",
    "references": "Ap 20:7–15; 21:8"
  },
  {
    "number": 18,
    "title": "A Nova Terra",
    "description": "Restauração da criação e comunhão eterna com Deus.",
    "references": "Is 65:17–25; 2Pe 3:13; Ap 21–22"
  }
];
---
<Base title="Escatologia / Eventos finais">
  <section class="section"><div class="wrap">
    <a href="/estudos/">← Estudos temáticos</a>
    <div class="eyebrow">Profecias bíblicas</div>
    <h1>Escatologia / Eventos finais</h1>
    <p>Estudos bíblicos dedicados ao tempo do fim, à segunda vinda de Cristo e à consumação do plano da salvação, com atenção ao contexto histórico, literário e teológico das Escrituras.</p>
    <h2>Propostas de artigos</h2>
    <p>Plano editorial de 18 estudos. Os temas abaixo são propostas de pesquisa, não artigos concluídos nem uma cronologia definitiva dos eventos.</p>
    <div class="grid">
      {proposals.map(proposal => <article class="card"><div class="kicker">ESTUDO {String(proposal.number).padStart(2,'0')} · PROPOSTA EDITORIAL</div><h3>{proposal.title}</h3><p>{proposal.description}</p><p><strong>Textos-base sugeridos:</strong> {proposal.references}</p><small>Em planejamento</small></article>)}
    </div>
    <h2>Artigos publicados</h2>
    <div class="grid">{items.map(item => <a class="card" href={'/estudos/'+item.id+'/'}><div class="kicker">{item.data.category}</div><h3>{item.data.title}</h3><p>{item.data.description}</p><strong>Ler estudo →</strong></a>)}</div>
    {items.length === 0 && <p>Ainda não há artigos publicados nesta seção.</p>}
  </div></section>
</Base>
