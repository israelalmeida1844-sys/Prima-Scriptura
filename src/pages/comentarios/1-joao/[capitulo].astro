---
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('comentarios', ({data}) => !data.draft && data.book === '1 João');
  return entries.map(entry => ({
    params: { capitulo: 'capitulo-' + entry.data.chapter },
    props: { entry }
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const chapter = entry.data.chapter;
const verseCount = Number(entry.data.verses.split('–').at(-1));
const araUrl = 'https://www.sbb.org.br/biblia/ARA/1JN.' + chapter;
---
<Base title={'1 João — Capítulo ' + chapter} description={entry.data.description}>
  <section class="section reading-page">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Caminho de navegação">
        <a href="/comentarios/">Comentários</a>
        <span aria-hidden="true">/</span>
        <a href="/comentarios/1-joao/">1 João</a>
        <span aria-hidden="true">/</span>
        <span>Capítulo {chapter}</span>
      </nav>
      <div class="reading-head">
        <div class="eyebrow">PRIMEIRA EPÍSTOLA DE JOÃO · COMENTÁRIO EXEGÉTICO E PASTORAL</div>
        <p class="chapter-index">CAPÍTULO {String(chapter).padStart(2,'0')} / 05</p>
        <h1>1 João — Capítulo {chapter}</h1>
        <p class="reading-description">{entry.data.description}</p>
      </div>
      <div class="bible-reference">
        <div>
          <span class="bible-label">TEXTO BÍBLICO</span>
          <strong>1 João {chapter} · Almeida Revista e Atualizada (ARA)</strong>
          <small>Leia o texto na edição oficial da Sociedade Bíblica do Brasil.</small>
        </div>
        <a class="bible-link" href={araUrl} target="_blank" rel="noopener noreferrer">Ler capítulo na ARA <span aria-hidden="true">↗</span></a>
      </div>
      <article class="article reading-content">
        <div class="meta">Equipe Prima Scriptura · Comentário de 1 João {chapter}:1–{entry.data.verses.split('–').at(-1)}</div>

        <nav class="verse-browser" data-joao-browser data-chapter={chapter} data-count={verseCount} aria-label={'Navegação por versículos de 1 João ' + chapter} hidden>
          <div class="verse-browser-top">
            <div>
              <span class="verse-eyebrow">LEITURA POR VERSÍCULO</span>
              <h2>Selecione o versículo para estudar</h2>
              <p>Escolha um número na faixa horizontal. Quando o manuscrito agrupa versículos, a seção correspondente será exibida.</p>
            </div>
            <div class="verse-view-controls">
              <button type="button" class="verse-control" data-target="all" aria-pressed="true" aria-controls="joao-prose">Capítulo completo</button>
              <button type="button" class="verse-control" data-target="intro" aria-pressed="false" aria-controls="joao-prose">Contexto do capítulo</button>
            </div>
          </div>
          <div class="verse-number-grid" data-verse-buttons role="group" aria-label={'Selecionar versículo em 1 João ' + chapter}></div>
          <p class="verse-current" data-verse-status role="status" aria-live="polite"></p>
        </nav>
        <div class="prose" id="joao-prose"><Content /></div>
      </article>
      <div class="next-reading">
        <div><span>CONTINUE A LEITURA</span><strong>Explore os capítulos de 1 João</strong></div>
        <a href="/comentarios/1-joao/">Voltar ao índice de capítulos →</a>
      </div>
    </div>
  </section>
</Base>
<script>
  // Seleção progressiva: sem JavaScript, o comentário completo permanece acessível.
  const browser = document.querySelector('[data-joao-browser]');
  if (browser instanceof HTMLElement) {
    const prose = browser.closest('article')?.querySelector('#joao-prose');
    const chapter = Number(browser.dataset.chapter);
    const verseCount = Number(browser.dataset.count);
    if (prose instanceof HTMLElement && Number.isInteger(chapter)) {
      const blocks = Array.from(prose.children);
      const ranges: [number, number][] = [];
      let group = -1;
      let kind = 'intro';
      let detailStart = 0;
      let detailEnd = 0;
      for (const element of blocks) {
        const text = element.textContent?.trim() || '';
        if (element.tagName === 'H2') {
          const section = text.match(/^1 João\s+(\d+):(\d+)[–-](\d+)/i);
          if (section && Number(section[1]) === chapter) {
            group++;
            ranges.push([Number(section[2]), Number(section[3])]);
            kind = 'context';
          }
        } else if (element.tagName === 'H3') {
          const match = text.match(/^Versículos?\s+(\d+)(?:[–-](\d+))?\b/i);
          if (match) {
            detailStart = Number(match[1]);
            detailEnd = Number(match[2] || match[1]);
            kind = 'detail';
          } else if (/^(Síntese do capítulo|Notas bibliográficas)/i.test(text)) {
            kind = 'appendix';
          } else {
            kind = 'context';
          }
        }
        element.setAttribute('data-joao-group', String(group));
        element.setAttribute('data-joao-kind', kind);
        if (kind === 'detail') element.setAttribute('data-detail-range', detailStart + ':' + detailEnd);
      }
      const consistent = ranges.length > 0 && ranges[0][0] === 1 &&
        ranges[ranges.length - 1][1] === verseCount &&
        ranges.every((r,i) => i === 0 || r[0] === ranges[i - 1][1] + 1);
      if (consistent) {
        const grid = browser.querySelector('[data-verse-buttons]');
        const status = browser.querySelector('[data-verse-status]');
        const buttons = Array.from(browser.querySelectorAll('button[data-target]'));
        if (grid instanceof HTMLElement && status instanceof HTMLElement) {
          for (let v = 1; v <= verseCount; v++) {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'verse-number';
            button.textContent = String(v);
            button.dataset.target = String(v);
            button.setAttribute('aria-label', 'Mostrar comentário sobre 1 João ' + chapter + ':' + v);
            button.setAttribute('aria-pressed', 'false');
            button.setAttribute('aria-controls', 'joao-prose');
            grid.append(button);
            buttons.push(button);
          }
          const findGroup = (v: number) => ranges.findIndex(r => v >= r[0] && v <= r[1]);
          const detailMatches = (element: Element, v: number) => {
            const match = (element.getAttribute('data-detail-range') || '').split(':').map(Number);
            return match.length === 2 && v >= match[0] && v <= match[1];
          };
          function fromAddress() {
            if (window.location.hash === '#introducao') return 'intro';
            const hit = window.location.hash.match(/^#v(\d+)$/);
            const n = hit ? Number(hit[1]) : 0;
            return findGroup(n) >= 0 ? String(n) : 'all';
          }
          function displaySelection(requested: string, changeAddress = true, scroll = true) {
            const v = Number(requested);
            const g = findGroup(v);
            const selection = requested === 'intro' ? 'intro' : requested === 'all' ? 'all' : g >= 0 ? String(v) : 'all';
            const hasSpecific = selection !== 'all' && selection !== 'intro' && blocks.some(el =>
              Number(el.getAttribute('data-joao-group')) === g &&
              el.getAttribute('data-joao-kind') === 'detail' && detailMatches(el, v));
            for (const block of blocks) {
              const groupIndex = Number(block.getAttribute('data-joao-group'));
              const kind = block.getAttribute('data-joao-kind');
              let visible = selection === 'all' || (selection === 'intro' && groupIndex === -1);
              if (selection !== 'all' && selection !== 'intro' && groupIndex === g && kind !== 'appendix') {
                visible = !hasSpecific || block.tagName === 'H2' || (kind === 'detail' && detailMatches(block,v));
              }
              block.hidden = !visible;
            }
            buttons.forEach(button => {
              const active = button.dataset.target === selection;
              button.classList.toggle('is-active',active);
              button.setAttribute('aria-pressed', String(active));
            });
            if (selection === 'all') status.textContent = 'Exibindo o capítulo completo.';
            else if (selection === 'intro') status.textContent = 'Exibindo o contexto do capítulo.';
            else status.textContent = '1 João ' + chapter + ':' + v + ' — ' +
              (hasSpecific ? 'comentário específico do versículo.' : 'comentário da passagem que abrange este versículo.');
            if (changeAddress) {
              const url = new URL(window.location.href);
              url.hash = selection === 'all' ? '' : selection === 'intro' ? 'introducao' : 'v' + selection;
              window.history.pushState(null,'',url);
            }
            if (scroll) browser.scrollIntoView({behavior:'smooth',block:'start'});
          }
          browser.addEventListener('click', event => {
            const target = event.target;
            if (!(target instanceof Element)) return;
            const button = target.closest('button[data-target]');
            if (!(button instanceof HTMLButtonElement) || !browser.contains(button)) return;
            displaySelection(button.dataset.target || 'all');
          });
          window.addEventListener('popstate', () => displaySelection(fromAddress(),false,false));
          window.addEventListener('hashchange', () => displaySelection(fromAddress(),false,false));
          browser.hidden = false;
          displaySelection(fromAddress(),false,false);
        }
      }
    }
  }
</script>
<style>
.reading-page{padding-top:34px;padding-bottom:90px}
.breadcrumbs{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:64px;font:500 12px Inter,sans-serif;color:#75808d}
.breadcrumbs a{text-decoration:underline;text-underline-offset:4px}
.reading-head{max-width:860px;margin:0 auto 36px}
.reading-head .eyebrow{font-size:11px;letter-spacing:.14em}
.chapter-index{font:700 12px Inter,sans-serif;letter-spacing:.13em;color:#9a7035;margin:32px 0 12px}
.reading-head h1{font-size:clamp(34px,5vw,54px);line-height:1.2;letter-spacing:-.045em;margin:0 0 18px}
.reading-description{font:400 20px/1.65 "Source Serif 4",Georgia,serif;color:#5b6675;max-width:710px;margin:0}
.bible-reference{max-width:860px;margin:0 auto 48px;padding:24px 30px;background:#f4efe5;border:1px solid #e3d5be;border-radius:10px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.bible-reference>div{display:flex;flex-direction:column;gap:5px}
.bible-label{font:700 10px Inter,sans-serif;letter-spacing:.17em;color:#987139}
.bible-reference strong{font:600 15px/1.45 Inter,sans-serif;color:#17304d}
.bible-reference small{font:400 12px/1.5 Inter,sans-serif;color:#78818c}
.bible-link{font:700 12px/1.4 Inter,sans-serif;color:white;background:#17304d;padding:14px 18px;border-radius:6px;text-align:center;white-space:nowrap;transition:background .15s}
.bible-link:hover{background:#2e4d71;color:white}
.reading-content{max-width:790px}
.reading-content .meta{margin-bottom:36px}
.next-reading{max-width:790px;display:flex;align-items:center;justify-content:space-between;gap:22px;border-top:1px solid #e1d7ca;margin:64px auto 0;padding-top:26px}
.next-reading>div{display:flex;flex-direction:column;gap:6px}
.next-reading span{font:700 10px Inter,sans-serif;letter-spacing:.14em;color:#9a7035}
.next-reading strong{font:600 17px "Libre Baskerville",Georgia,serif;color:#182e49}
.next-reading a{font:700 13px Inter,sans-serif;color:#8f672d}
@media(max-width:760px){.breadcrumbs{margin-bottom:38px}.reading-head{margin-bottom:30px}.reading-description{font-size:18px}.bible-reference{flex-direction:column;align-items:stretch;padding:20px}.bible-link{white-space:normal}.next-reading{flex-direction:column;align-items:flex-start}}
.verse-browser{max-width:790px;margin:0 0 32px;padding:24px 26px 21px;border:1px solid #d9dfdd;background:#f8f8f5;border-radius:12px;scroll-margin-top:14px}
.verse-browser[hidden]{display:none!important}
.verse-browser-top{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;margin-bottom:20px}
.verse-eyebrow{font:700 10px Inter,sans-serif;letter-spacing:.14em;color:#8a682f}
.verse-browser h2{font:700 18px/1.5 Inter,sans-serif;letter-spacing:-.015em;color:#17304d;margin:6px 0}
.verse-browser-top p{font:400 13px/1.65 Inter,sans-serif;color:#657587;margin:0;max-width:380px}
.verse-view-controls{display:flex;flex-wrap:wrap;gap:8px;min-width:225px;justify-content:flex-end}
.verse-control,.verse-number{appearance:none;border:1px solid #cbd5d8;background:#fff;color:#294358;border-radius:7px;cursor:pointer;transition:background .12s,border-color .12s}
.verse-control{padding:10px 12px;font:600 12px/1.4 Inter,sans-serif}
.verse-number-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(42px,1fr));gap:8px}
.verse-number{min-height:43px;font:700 14px/1.3 Inter,sans-serif}
.verse-control:hover,.verse-number:hover{border-color:#a78044;background:#f3eee5}
.verse-control.is-active,.verse-number.is-active{background:#17304d;border-color:#17304d;color:#fff}
.verse-control:focus-visible,.verse-number:focus-visible{outline:3px solid #b58b49;outline-offset:3px}
.verse-current{font:500 12px/1.5 Inter,sans-serif;color:#647589;margin:15px 0 0}
:global(.reading-content .prose > [hidden]){display:none!important}
@media(max-width:760px){.verse-browser{padding:18px 16px}.verse-browser-top{display:block}.verse-view-controls{margin-top:14px;justify-content:flex-start}.verse-number-grid{grid-template-columns:repeat(auto-fill,minmax(38px,1fr))}.verse-number{min-height:41px}}

.reading-head{max-width:900px;min-height:263px;background-image:linear-gradient(90deg,rgba(9,24,44,.08),rgba(9,24,44,.58) 46%,rgba(9,24,44,.96) 100%),url('/images/1-joao-hero.webp');background-size:cover;background-position:center center;display:flex;flex-direction:column;justify-content:center;margin:0 auto 34px;padding:30px 39px;border-radius:14px;box-shadow:0 14px 37px #10264224;align-items:flex-end;text-align:right;}
.reading-head .eyebrow{color:#e7c58d}
.reading-head .chapter-index{color:#e9c58e;margin:14px 0 9px}
.reading-head h1{color:#fff;max-width:68%;}
.reading-head .reading-description{color:#eaf2f8;max-width:68%;font-size:18px}
.verse-number-grid{display:flex;flex-wrap:nowrap;overflow-x:auto;gap:8px;padding:5px 2px 13px;scrollbar-width:thin;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain;max-width:100%}
.verse-number{flex:0 0 44px;min-width:44px;min-height:44px}
@media(max-width:760px){.reading-head{min-height:240px;padding:24px 21px}.reading-head h1{font-size:clamp(29px,7vw,38px)}.reading-head .reading-description{font-size:16px;line-height:1.5}.reading-head h1,.reading-head .reading-description{max-width:72%}.reading-head{background-position:38% center}.verse-number{flex-basis:42px;min-width:42px}}

</style>
