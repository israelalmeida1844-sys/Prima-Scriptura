---
import Base from '../../layouts/Base.astro';import {getCollection} from 'astro:content';
const items=(await getCollection('comentarios',({data})=>!data.draft)).sort((a,b)=>a.data.book.localeCompare(b.data.book,'pt-BR')||a.data.chapter-b.data.chapter);
---
<Base title="Comentários bíblicos"><section class="section"><div class="wrap"><div class="eyebrow">Antigo e Novo Testamento</div><h1>Comentários bíblicos</h1><p>Organizados por livro, capítulo e passagem.</p><div class="grid">{items.map(item=><a class="card" href={'/comentarios/'+item.id+'/'}><div class="kicker">{item.data.testament} · {item.data.book} {item.data.chapter}:{item.data.verses}</div><h3>{item.data.title}</h3><p>{item.data.description}</p><strong>Ler comentário →</strong></a>)}</div>{items.length===0&&<p>Não há comentários publicados.</p>}</div></section></Base>
