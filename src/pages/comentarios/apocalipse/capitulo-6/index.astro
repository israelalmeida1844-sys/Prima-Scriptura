---
import Base from '../../../../layouts/Base.astro';

const availableVerses = [
  {
    "number": 1,
    "title": "O primeiro selo e a convocação",
    "description": "O Cordeiro abre o selo; o chamado Ἔρχου introduz o primeiro cavaleiro. A destinação da ordem é interpretação sintática e contextual."
  },
  {
    "number": 2,
    "title": "O cavalo branco e o arco",
    "description": "O arco e a coroa não identificam explicitamente o cavaleiro. A associação à cavalaria parta é hipótese histórica. A interpretação historicista adventista tradicional relaciona o cavalo à expansão inicial do evangelho; outras leituras enfatizam conquista ou engano."
  },
  {
    "number": 3,
    "title": "O segundo selo e a convocação",
    "description": "A convocação pelo segundo ser vivente é paralela à do primeiro e deve preservar a leitura textual adotada."
  },
  {
    "number": 4,
    "title": "O cavalo vermelho e a retirada da paz",
    "description": "A retirada da paz anuncia violência recíproca. μάχαιρα é arma cortante distinta, em muitos contextos, da ῥομφαία. A associação historicista a conflitos históricos é aplicação interpretativa."
  },
  {
    "number": 5,
    "title": "O cavalo negro e a balança",
    "description": "ζυγός descreve um instrumento de pesagem que, associado à economia dos cereais, sugere escassez."
  },
  {
    "number": 6,
    "title": "Escassez, preços e alimentos",
    "description": "χοῖνιξ era medida de cereal; o denário pode funcionar como salário de um dia (Mt 20:2). A explicação por um édito de Domiciano sobre videiras é hipótese histórica debatida, não identificação afirmada pelo texto."
  },
  {
    "number": 7,
    "title": "A convocação do quarto selo",
    "description": "O quarto ser vivente convoca o último cavaleiro; os quatro primeiros selos compõem uma unidade literária."
  },
  {
    "number": 8,
    "title": "O cavalo pálido, a Morte e o Hades",
    "description": "χλωρός é verde ou amarelo-esverdeado; no contexto de Morte pode sugerir palidez cadavérica. A série de flagelos ecoa Ez 14:21 e a quarta parte delimita a autoridade."
  },
  {
    "number": 9,
    "title": "Os mártires sob o altar",
    "description": "As vidas dos mortos estão simbolicamente debaixo do altar, evocando o sangue sacrificial (Lv 4:7). A perspectiva adventista entende a cena de modo simbólico, não como prova independente de consciência desencarnada."
  },
  {
    "number": 10,
    "title": "O clamor de justiça: Até quando?",
    "description": "Ἕως πότε recupera a fórmula de apelo judicial do Antigo Testamento (Sl 79:5; Hc 1:2). δεσπότης exprime autoridade soberana."
  },
  {
    "number": 11,
    "title": "Vestes brancas e espera",
    "description": "As vestes brancas e o tempo de repouso indicam reconhecimento e espera. Não se deve converter a passagem em cálculo cronológico exato."
  },
  {
    "number": 12,
    "title": "Terremoto, sol e lua",
    "description": "Os abalos cósmicos ecoam Is 13:10 e Jl 2:31. A leitura historicista adventista associa a esta sequência eventos como Lisboa (1755) e o Dia Escuro (1780), em diálogo com perspectivas escatológicas alternativas."
  },
  {
    "number": 13,
    "title": "A queda das estrelas",
    "description": "A figueira e seus figos temporãos formam comparação para a queda das estrelas. A associação à chuva de meteoros de 1833 é aplicação historicista, não tradução lexical."
  },
  {
    "number": 14,
    "title": "O céu como um rolo",
    "description": "A retirada do céu como rolo remete a Is 34:4; a linguagem é apocalíptica e não requer mecanismo astronômico literal."
  },
  {
    "number": 15,
    "title": "O temor de toda a sociedade",
    "description": "A lista alcança elites políticas, militares e econômicas, e inclui escravos e livres; a universalidade impede sua redução a uma única classe."
  },
  {
    "number": 16,
    "title": "A ira do Cordeiro",
    "description": "Os pedidos às rochas ecoam Os 10:8 e Lc 23:30. A ira do Cordeiro une as imagens do sacrifício e do juízo."
  },
  {
    "number": 17,
    "title": "Quem poderá subsistir?",
    "description": "O pronome αὐτῶν na edição-base é plural, ligando a ira ao entronizado e ao Cordeiro. A pergunta final prepara o selamento em Ap 7."
  }
];
---
<Base
  title="Apocalipse 6 — Estudo interlinear em avaliação"
  description="Consulte o texto original grego e a análise lexical de Apocalipse 6:1–17, com concordâncias exaustivas do Novo Testamento."
>
  <section class="apocalipse-chapter">
    <div class="wrap">
      <nav class="crumbs" aria-label="Caminho de navegação">
        <a href="/comentarios/">Comentários</a>
        <span aria-hidden="true">/</span>
        <a href="/comentarios/apocalipse/">Apocalipse</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Capítulo 6</span>
      </nav>

      <div class="chapter-heading">
        <p class="eyebrow">A REVELAÇÃO DE JESUS CRISTO · CAPÍTULO 06</p>
        <h1>Apocalipse 6 — A Abertura dos Seis Selos e os Cavaleiros</h1>
        <p>
          Examine o texto grego koiné no texto crítico SBLGNT com transliteração, glosas, morfologia, acepções semânticas e concordâncias exaustivas do Novo Testamento. Apresentação em rascunho de avaliação editorial.
        </p>
      </div>

      <div class="summary" aria-label="Progresso do capítulo 6">
        <strong>17 de 17</strong>
        <span>versículos preparados: a abertura dos seis selos, os quatro cavaleiros, os mártires sob o altar e os sinais cósmicos — capítulo 6 completo em rascunho</span>
      </div>

      <h2>Versículos preparados</h2>
      <div class="verse-list">
        {availableVerses.map(v => (
          <a href={'/comentarios/apocalipse/capitulo-6/versiculo-' + v.number + '/'}>
            <span>APOCALIPSE 6:{v.number}</span>
            <strong>{v.title}</strong>
            <p>{v.description}</p>
            <small>Estudar versículo <span aria-hidden="true">→</span></small>
          </a>
        ))}
      </div>

      <div class="pending">
        <h2>Em preparação editorial</h2>
        <p>
          Os 17 versículos estão estruturados com texto SBLGNT, morfologia MorphGNT, léxico e concordâncias. A etapa seguinte é a homologação filológica individual de glosas e construções sintáticas, juntamente com a verificação do build Astro.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .apocalipse-chapter,
  .apocalipse-chapter :is(a, span, p, h1, h2, strong, small) {
    font-family: 'Times New Roman', Times, serif;
  }
  .apocalipse-chapter {
    padding: 45px 0 90px;
  }
  .crumbs {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 14px;
    color: #5e7287;
    margin-bottom: 30px;
  }
  .apocalipse-chapter .crumbs a {
    color: #435b76;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .chapter-heading {
    padding: 40px;
    background: linear-gradient(120deg, #10233b, #244366);
    color: #f4f4f1;
    border-radius: 14px;
    margin-bottom: 24px;
  }
  .chapter-heading .eyebrow {
    color: #eac48d;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .chapter-heading h1 {
    color: #fff;
    font-size: clamp(32px, 5vw, 50px);
    margin: 10px 0;
  }
  .chapter-heading > p:last-child {
    font-size: 19px;
    max-width: 760px;
    line-height: 1.7;
    color: #d6e2ee;
  }
  .summary {
    background: white;
    border: 1px solid #e0d7c8;
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 35px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .summary strong {
    font-size: 27px;
    color: #1a334f;
    white-space: nowrap;
  }
  .summary span {
    font-size: 16px;
    color: #607084;
  }
  .verse-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
  }
  .verse-list a {
    background: #fff;
    border: 1px solid #e3daca;
    border-radius: 10px;
    min-height: 160px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
    color: inherit;
    transition: all 0.15s ease-in-out;
  }
  .verse-list a:hover {
    background: #faf6ed;
    border-color: #b59157;
    transform: translateY(-2px);
  }
  .verse-list a > span {
    font-size: 13px;
    font-weight: 700;
    color: #936d36;
  }
  .verse-list strong {
    font-size: 20px;
    line-height: 1.35;
    color: #101f35;
  }
  .verse-list p {
    font-size: 14px;
    color: #5d6f82;
    line-height: 1.5;
    margin: 0;
  }
  .verse-list small {
    margin-top: auto;
    color: #59708a;
    font-size: 14px;
    font-weight: 700;
  }
  .pending {
    margin-top: 48px;
    padding: 24px;
    border-left: 4px solid #c6a15b;
    background: #f7f3e9;
    border-radius: 0 8px 8px 0;
  }
  .pending h2 {
    font-size: 21px;
    margin: 0 0 6px;
    color: #1c3554;
  }
  .pending p {
    margin: 0;
    line-height: 1.65;
    color: #596a7d;
  }
  @media (max-width: 440px) {
    .chapter-heading {
      padding: 24px;
    }
  }
</style>
