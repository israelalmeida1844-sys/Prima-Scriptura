<style>
  .apocalipse-site,
  .apocalipse-site :is(h1, h2, h3, p, a, span, strong, small) {
    font-family: 'Times New Roman', Times, serif;
  }
  .apocalipse-site {
    padding: 42px 0 84px;
  }
  .apocalipse-crumbs {
    display: flex;
    gap: 12px;
    align-items: center;
    font-size: 14px;
    margin-bottom: 35px;
    color: #607086;
  }
  .apocalipse-crumbs a {
    color: #435b76;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .apocalipse-hero {
    background: linear-gradient(120deg, #10243d, #274567);
    color: #f3f4f7;
    padding: clamp(26px, 6vw, 66px);
    border-radius: 15px;
    margin-bottom: 24px;
  }
  .apocalipse-overline {
    color: #f0c786;
    text-transform: uppercase;
    font-size: 13px;
    letter-spacing: 0.11em;
    font-weight: 700;
  }
  .apocalipse-hero h1 {
    color: white;
    font-size: clamp(40px, 6vw, 68px);
    margin: 6px 0 15px;
  }
  .apocalipse-hero > p:not(.apocalipse-overline) {
    font-size: clamp(17px, 2vw, 21px);
    max-width: 770px;
    line-height: 1.65;
    color: #dbe7f2;
  }
  .apocalipse-status {
    display: inline-block;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.35);
    padding: 6px 16px;
    border-radius: 100px;
    font-size: 14px;
    font-weight: 700;
    margin-top: 10px;
  }
  .apocalipse-metadata {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin: 22px 0 45px;
  }
  .apocalipse-metadata > div {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #e0dacc;
    padding: 17px 18px;
    border-radius: 9px;
  }
  .apocalipse-metadata span {
    color: #697789;
    font-size: 13px;
  }
  .apocalipse-metadata strong {
    font-size: 19px;
    color: #142b4c;
    margin-top: 2px;
  }
  .apocalipse-section-heading {
    display: flex;
    justify-content: space-between;
    gap: 22px;
    align-items: flex-end;
    margin-bottom: 20px;
  }
  .apocalipse-section-heading h2 {
    margin: 5px 0 0;
    font-size: 28px;
    color: #101f35;
  }
  .apocalipse-section-heading > p {
    max-width: 440px;
    line-height: 1.5;
    color: #647083;
    margin: 0;
  }
  .apocalipse-chapters-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 16px; margin: 18px 0 24px; }
  .apocalipse-chapter-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: 18px;
    background: white;
    border: 1px solid #d6c6aa;
    padding: 24px;
    border-radius: 11px;
    text-decoration: none;
    color: inherit;
    transition: all 0.15s ease-in-out;
  }
  .apocalipse-chapter-card:hover {
    border-color: #ab813e;
    background: #faf6eb;
    transform: translateY(-2px);
  }
  .apocalipse-chapter-card h3 {
    margin: 8px 0;
    font-size: 24px;
    color: #101f35;
  }
  .apocalipse-chapter-card p {
    color: #66768b;
    margin: 0;
    font-size: 15px;
  }
  .apocalipse-label {
    color: #936d36;
    font-size: 12px;
    font-weight: 700;
  }
  .apocalipse-link {
    color: #906b34;
    font-size: 15px;
    font-weight: 700;
    white-space: nowrap;
  }
  .apocalipse-verse-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 14px;
    margin: 18px 0 35px;
  }
  .apocalipse-verse-grid a {
    background: white;
    border: 1px solid #e4dccf;
    border-radius: 10px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
    color: inherit;
    transition: all 0.15s ease-in-out;
  }
  .apocalipse-verse-grid a:hover {
    border-color: #ab813e;
    background: #faf6eb;
    transform: translateY(-2px);
  }
  .apocalipse-verse-grid a > span {
    font-size: 12px;
    font-weight: 700;
    color: #876735;
  }
  .apocalipse-verse-grid strong {
    font-size: 20px;
    color: #101f35;
  }
  .apocalipse-verse-grid p {
    font-size: 15px;
    color: #4b6279;
    margin: 0;
  }
  .apocalipse-verse-grid small {
    color: #69798a;
    font-size: 13px;
    font-weight: 700;
    margin-top: auto;
  }
  .apocalipse-note {
    font-size: 13px;
    line-height: 1.65;
    color: #68788a;
    margin-top: 25px;
  }
  @media (max-width: 760px) {
    .apocalipse-metadata {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .apocalipse-section-heading {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }
  @media (max-width: 480px) {
    .apocalipse-metadata {
      grid-template-columns: 1fr;
    }
  }
</style>
