---
import Base from '../../../../layouts/Base.astro';

const availableVerses = [
  {
    "number": 1,
    "title": "Os quatro ventos retidos",
    "description": "A retenção dos ventos precede o selamento (7:3); os quatro cantos expressam abrangência terrestre. Compare Jr 49:36 e Dn 7:2, sem equiparar automaticamente todos os símbolos."
  },
  {
    "number": 2,
    "title": "O anjo com o selo de Deus",
    "description": "O selo pertence ao Deus vivo; a direção do nascente não identifica por si só o anjo com Cristo. A autoridade dos quatro anjos é limitada pelo mandamento seguinte."
  },
  {
    "number": 3,
    "title": "O selamento dos servos",
    "description": "A marca na fronte evoca Ez 9:4–6 e antecipa Ap 14:1. Na leitura adventista, o selamento envolve lealdade a Deus; a ligação com o sábado é uma síntese teológica, não uma glosa de σφραγίζω."
  },
  {
    "number": 4,
    "title": "O número dos selados",
    "description": "O número é ouvido, ao passo que a multidão é vista em 7:9. A relação entre os grupos e o caráter literal ou simbólico do número são questões interpretativas."
  },
  {
    "number": 5,
    "title": "Judá, Rúben e Gade",
    "description": "Judá abre a lista, diferentemente da ordem de nascimento em Gn 29. Ap 5:5 fornece contexto cristológico possível, sem afirmar a razão da ordem."
  },
  {
    "number": 6,
    "title": "Aser, Naftali e Manassés",
    "description": "Manassés integra a lista; compare Gn 48. A seleção não reproduz integralmente nenhuma lista tribal usual do AT."
  },
  {
    "number": 7,
    "title": "Simeão, Levi e Issacar",
    "description": "Levi figura na enumeração; sua inclusão não permite deduzir por si só uma distribuição territorial literal."
  },
  {
    "number": 8,
    "title": "Zebulom, José e Benjamim",
    "description": "José e Manassés aparecem, enquanto Dã não é mencionado e Efraim não aparece nominalmente. O texto não explica essas escolhas."
  },
  {
    "number": 9,
    "title": "A multidão incontável",
    "description": "A universalidade da multidão ecoa Ap 5:9; as vestes brancas remetem a 6:11. As palmas evocam celebração e vitória; compare Lv 23:40 e Jo 12:13."
  },
  {
    "number": 10,
    "title": "A salvação pertence a Deus e ao Cordeiro",
    "description": "A salvação é atribuída conjuntamente a Deus e ao Cordeiro, não ao mérito da multidão."
  },
  {
    "number": 11,
    "title": "A adoração celestial",
    "description": "A adoração amplia a cena de 7:10 e retoma a liturgia celestial de Ap 4–5."
  },
  {
    "number": 12,
    "title": "A doxologia dos anjos",
    "description": "A doxologia de sete elementos expressa plenitude de louvor e retoma Ap 5:12, com diferenças na enumeração."
  },
  {
    "number": 13,
    "title": "A pergunta do ancião",
    "description": "A pergunta do ancião conduz João e o leitor à interpretação das vestes e da origem da multidão."
  },
  {
    "number": 14,
    "title": "Os que vêm da grande tribulação",
    "description": "A imagem paradoxal de branquear vestes em sangue aponta à eficácia da morte do Cordeiro. A grande tribulação admite diferentes delimitações interpretativas; compare Dn 12:1."
  },
  {
    "number": 15,
    "title": "Serviço no santuário e proteção divina",
    "description": "A presença diante do trono e o serviço no santuário respondem à pergunta de 6:17. O verbo σκηνόω evoca habitação e proteção divinas; compare Ap 21:3."
  },
  {
    "number": 16,
    "title": "Fim da fome, sede e calor",
    "description": "A promessa retoma Is 49:10, descrevendo a superação da privação e do sofrimento."
  },
  {
    "number": 17,
    "title": "O Cordeiro como pastor",
    "description": "O Cordeiro exerce função pastoral; compare Sl 23 e Is 49:10. A remoção das lágrimas ecoa Is 25:8 e antecipa Ap 21:4."
  }
];
---
<Base
  title="Apocalipse 7 — Estudo interlinear em avaliação"
  description="Consulte o texto original grego e a análise lexical de Apocalipse 7:1–17, com concordâncias exaustivas do Novo Testamento."
>
  <section class="apocalipse-chapter">
    <div class="wrap">
      <nav class="crumbs" aria-label="Caminho de navegação">
        <a href="/comentarios/">Comentários</a>
        <span aria-hidden="true">/</span>
        <a href="/comentarios/apocalipse/">Apocalipse</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Capítulo 7</span>
      </nav>

      <div class="chapter-heading">
        <p class="eyebrow">A REVELAÇÃO DE JESUS CRISTO · CAPÍTULO 07</p>
        <h1>Apocalipse 7 — O Selamento e a Grande Multidão</h1>
        <p>
          Examine o texto grego koiné no texto crítico SBLGNT com transliteração, glosas, morfologia, acepções semânticas e concordâncias exaustivas do Novo Testamento. Apresentação em rascunho de avaliação editorial.
        </p>
      </div>

      <div class="summary" aria-label="Progresso do capítulo 7">
        <strong>17 de 17</strong>
        <span>versículos preparados: os 144 mil selados e a grande multidão — capítulo 7 completo em rascunho</span>
      </div>

      <h2>Versículos preparados</h2>
      <div class="verse-list">
        {availableVerses.map(v => (
          <a href={'/comentarios/apocalipse/capitulo-7/versiculo-' + v.number + '/'}>
            <span>APOCALIPSE 7:{v.number}</span>
            <strong>{v.title}</strong>
            <p>{v.description}</p>
            <small>Estudar versículo <span aria-hidden="true">→</span></small>
          </a>
        ))}
      </div>

      <div class="pending">
        <h2>Em preparação editorial</h2>
        <p>
          Os 17 versículos contêm texto SBLGNT/MorphGNT, glosas, tradução e notas; os novos índices de concordância ainda exigem preparação. A etapa seguinte é a homologação filológica individual de glosas e construções sintáticas, juntamente com a verificação do build Astro.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .apocalipse-chapter,
  .apocalipse-chapter :is(a, span, p, h1, h2, strong, small) {
    font-family: 'Times New Roman', Times, serif;
  }
  .apocalipse-chapter {
    padding: 45px 0 90px;
  }
  .crumbs {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 14px;
    color: #5e7287;
    margin-bottom: 30px;
  }
  .apocalipse-chapter .crumbs a {
    color: #435b76;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .chapter-heading {
    padding: 40px;
    background: linear-gradient(120deg, #10233b, #244366);
    color: #f4f4f1;
    border-radius: 14px;
    margin-bottom: 24px;
  }
  .chapter-heading .eyebrow {
    color: #eac48d;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .chapter-heading h1 {
    color: #fff;
    font-size: clamp(32px, 5vw, 50px);
    margin: 10px 0;
  }
  .chapter-heading > p:last-child {
    font-size: 19px;
    max-width: 760px;
    line-height: 1.7;
    color: #d6e2ee;
  }
  .summary {
    background: white;
    border: 1px solid #e0d7c8;
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 35px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .summary strong {
    font-size: 27px;
    color: #1a334f;
    white-space: nowrap;
  }
  .summary span {
    font-size: 16px;
    color: #607084;
  }
  .verse-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
  }
  .verse-list a {
    background: #fff;
    border: 1px solid #e3daca;
    border-radius: 10px;
    min-height: 160px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
    color: inherit;
    transition: all 0.15s ease-in-out;
  }
  .verse-list a:hover {
    background: #faf6ed;
    border-color: #b59157;
    transform: translateY(-2px);
  }
  .verse-list a > span {
    font-size: 13px;
    font-weight: 700;
    color: #936d36;
  }
  .verse-list strong {
    font-size: 20px;
    line-height: 1.35;
    color: #101f35;
  }
  .verse-list p {
    font-size: 14px;
    color: #5d6f82;
    line-height: 1.5;
    margin: 0;
  }
  .verse-list small {
    margin-top: auto;
    color: #59708a;
    font-size: 14px;
    font-weight: 700;
  }
  .pending {
    margin-top: 48px;
    padding: 24px;
    border-left: 4px solid #c6a15b;
    background: #f7f3e9;
    border-radius: 0 8px 8px 0;
  }
  .pending h2 {
    font-size: 21px;
    margin: 0 0 6px;
    color: #1c3554;
  }
  .pending p {
    margin: 0;
    line-height: 1.65;
    color: #596a7d;
  }
  @media (max-width: 440px) {
    .chapter-heading {
      padding: 24px;
    }
  }
</style>
