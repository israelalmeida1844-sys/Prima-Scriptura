---
import Base from '../../../../layouts/Base.astro';

const availableVerses = [
  {
    "number": 1,
    "title": "A quinta trombeta",
    "description": "A estrela e a chave do poço."
  },
  {
    "number": 2,
    "title": "A fumaça do abismo",
    "description": "O sol e o ar escurecem."
  },
  {
    "number": 3,
    "title": "Os gafanhotos",
    "description": "Autoridade comparada à dos escorpiões."
  },
  {
    "number": 4,
    "title": "A proteção dos selados",
    "description": "A restrição do juízo aos não selados."
  },
  {
    "number": 5,
    "title": "Os cinco meses",
    "description": "A duração limitada do tormento."
  },
  {
    "number": 6,
    "title": "A busca pela morte",
    "description": "A intensidade do sofrimento."
  },
  {
    "number": 7,
    "title": "A aparência dos gafanhotos",
    "description": "Comparações de caráter visionário."
  },
  {
    "number": 8,
    "title": "Cabelos e dentes",
    "description": "Imagens que evocam Joel 1:6."
  },
  {
    "number": 9,
    "title": "Couraças e asas",
    "description": "O estrondo de uma cavalaria."
  },
  {
    "number": 10,
    "title": "Caudas e ferrões",
    "description": "A repetição do período de cinco meses."
  },
  {
    "number": 11,
    "title": "Abadom e Apoliom",
    "description": "Os nomes do anjo do abismo."
  },
  {
    "number": 12,
    "title": "O primeiro ai",
    "description": "A transição entre os ais."
  },
  {
    "number": 13,
    "title": "A sexta trombeta",
    "description": "Uma voz junto ao altar de ouro."
  },
  {
    "number": 14,
    "title": "Os quatro anjos do Eufrates",
    "description": "A ordem para libertar os anjos."
  },
  {
    "number": 15,
    "title": "O momento preparado",
    "description": "A hora, o dia, o mês e o ano."
  },
  {
    "number": 16,
    "title": "O número da cavalaria",
    "description": "A expressão numeral multiplicativa."
  },
  {
    "number": 17,
    "title": "Os cavalos da visão",
    "description": "Fogo, fumaça e enxofre."
  },
  {
    "number": 18,
    "title": "As três pragas",
    "description": "O juízo sobre um terço."
  },
  {
    "number": 19,
    "title": "O poder das caudas",
    "description": "O simbolismo das serpentes."
  },
  {
    "number": 20,
    "title": "A persistência da idolatria",
    "description": "A denúncia das obras humanas."
  },
  {
    "number": 21,
    "title": "A ausência de arrependimento",
    "description": "A lista final de práticas não abandonadas."
  }
];
---
<Base
  title="Apocalipse 9 — Estudo interlinear em avaliação"
  description="Consulte o texto original grego e a análise lexical de Apocalipse 9:1–21, com concordâncias em preparação."
>
  <section class="apocalipse-chapter">
    <div class="wrap">
      <nav class="crumbs" aria-label="Caminho de navegação">
        <a href="/comentarios/">Comentários</a>
        <span aria-hidden="true">/</span>
        <a href="/comentarios/apocalipse/">Apocalipse</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Capítulo 9</span>
      </nav>

      <div class="chapter-heading">
        <p class="eyebrow">A REVELAÇÃO DE JESUS CRISTO · CAPÍTULO 09</p>
        <h1>Apocalipse 9 — A Quinta e a Sexta Trombetas</h1>
        <p>
          Examine o texto grego koiné no texto crítico SBLGNT com transliteração, glosas, morfologia, acepções semânticas e concordâncias exaustivas do Novo Testamento. Apresentação em rascunho de avaliação editorial.
        </p>
      </div>

      <div class="summary" aria-label="Progresso do capítulo 9">
        <strong>21 de 21</strong>
        <span>versículos preparados: a quinta e a sexta trombetas — capítulo 9 completo em rascunho</span>
      </div>

      <h2>Versículos preparados</h2>
      <div class="verse-list">
        {availableVerses.map(v => (
          <a href={'/comentarios/apocalipse/capitulo-9/versiculo-' + v.number + '/'}>
            <span>APOCALIPSE 9:{v.number}</span>
            <strong>{v.title}</strong>
            <p>{v.description}</p>
            <small>Estudar versículo <span aria-hidden="true">→</span></small>
          </a>
        ))}
      </div>

      <div class="pending">
        <h2>Em preparação editorial</h2>
        <p>
          Os 21 versículos contêm texto, glosas, tradução e notas em rascunho; os novos índices, a auditoria filológica final e os testes estão pendentes.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .apocalipse-chapter,
  .apocalipse-chapter :is(a, span, p, h1, h2, strong, small) {
    font-family: 'Times New Roman', Times, serif;
  }
  .apocalipse-chapter {
    padding: 45px 0 90px;
  }
  .crumbs {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 14px;
    color: #5e7287;
    margin-bottom: 30px;
  }
  .apocalipse-chapter .crumbs a {
    color: #435b76;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .chapter-heading {
    padding: 40px;
    background: linear-gradient(120deg, #10233b, #244366);
    color: #f4f4f1;
    border-radius: 14px;
    margin-bottom: 24px;
  }
  .chapter-heading .eyebrow {
    color: #eac48d;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .chapter-heading h1 {
    color: #fff;
    font-size: clamp(32px, 5vw, 50px);
    margin: 10px 0;
  }
  .chapter-heading > p:last-child {
    font-size: 19px;
    max-width: 760px;
    line-height: 1.7;
    color: #d6e2ee;
  }
  .summary {
    background: white;
    border: 1px solid #e0d7c8;
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 35px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .summary strong {
    font-size: 27px;
    color: #1a334f;
    white-space: nowrap;
  }
  .summary span {
    font-size: 16px;
    color: #607084;
  }
  .verse-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
  }
  .verse-list a {
    background: #fff;
    border: 1px solid #e3daca;
    border-radius: 10px;
    min-height: 160px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-decoration: none;
    color: inherit;
    transition: all 0.15s ease-in-out;
  }
  .verse-list a:hover {
    background: #faf6ed;
    border-color: #b59157;
    transform: translateY(-2px);
  }
  .verse-list a > span {
    font-size: 13px;
    font-weight: 700;
    color: #936d36;
  }
  .verse-list strong {
    font-size: 20px;
    line-height: 1.35;
    color: #101f35;
  }
  .verse-list p {
    font-size: 14px;
    color: #5d6f82;
    line-height: 1.5;
    margin: 0;
  }
  .verse-list small {
    margin-top: auto;
    color: #59708a;
    font-size: 14px;
    font-weight: 700;
  }
  .pending {
    margin-top: 48px;
    padding: 24px;
    border-left: 4px solid #c6a15b;
    background: #f7f3e9;
    border-radius: 0 8px 8px 0;
  }
  .pending h2 {
    font-size: 21px;
    margin: 0 0 6px;
    color: #1c3554;
  }
  .pending p {
    margin: 0;
    line-height: 1.65;
    color: #596a7d;
  }
  @media (max-width: 440px) {
    .chapter-heading {
      padding: 24px;
    }
  }
</style>
