---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const publicEntries = await getCollection('comentarios', ({data}) => !data.draft && data.book === 'Daniel');
const chapterTitles = [
  'A prova de fidelidade na corte de Babilônia',
  'O sonho de Nabucodonosor e o panorama profético',
  'A estátua de ouro e a fornalha ardente',
  'O orgulho e a humilhação de Nabucodonosor',
  'O banquete de Belsazar e a queda de Babilônia',
  'Daniel na cova dos leões',
  'Os quatro animais e o juízo celestial',
  'O carneiro, o bode e as 2.300 tardes e manhãs',
  'A oração de Daniel e as setenta semanas',
  'A visão à margem do rio Tigre',
  'Conflitos históricos e o rei do Norte',
  'Miguel se levanta e o livramento final'
];
const chapters = chapterTitles.map((label, i) => {
  const number = i + 1;
  const entry = publicEntries.find(item => item.data.chapter === number);
  return { number, entry, label, available: Boolean(entry) };
});
const availableCount = chapters.filter(item => item.available).length;
---
<Base title="Daniel — Comentário bíblico por capítulos" description="Comentário do livro de Daniel na perspectiva histórico-exegética e historicista adventista, organizado por capítulo.">
  <section class="section daniel-project">
    <div class="wrap">
      <nav class="crumbs" aria-label="Navegação"><a href="/comentarios/">Comentários bíblicos</a><span>/</span><span>Daniel</span></nav>
      <div class="eyebrow">ANTIGO TESTAMENTO · PROFECIA E HISTÓRIA</div>
      <h1>Comentário Bíblico de Daniel</h1>
      <p class="subtitle">Análise exegética, histórica e teológica, capítulo por capítulo, na perspectiva historicista adventista do sétimo dia.</p>
      <div class="metadata">
        <div><small>LIVRO</small><strong>Daniel</strong></div>
        <div><small>TESTAMENTO</small><strong>Antigo</strong></div>
        <div><small>CAPÍTULOS</small><strong>12</strong></div>
        <div><small>DISPONÍVEIS</small><strong>{availableCount} de 12</strong></div>
        <div><small>BÍBLIA</small><strong>ARA</strong></div>
      </div>
      <div class="section-heading">
        <div><div class="eyebrow">ÍNDICE DO LIVRO</div><h2>Escolha um capítulo</h2></div>
        <p>Os capítulos publicados podem ser abertos para leitura completa. Os demais serão adicionados posteriormente.</p>
      </div>
      <div class="chapters">
        {chapters.map(({number,label,entry,available}) => available ? (
          <a class="chapter available" href={'/comentarios/daniel/capitulo-' + number + '/'} aria-label={'Abrir comentário de Daniel capítulo ' + number}>
            <div class="top"><span>CAPÍTULO</span><span class="tag">Disponível</span></div>
            <div class="number">{String(number).padStart(2,'0')}</div>
            <h3>{label}</h3>
            <p>{entry.data.description}</p>
            <strong class="read">Ler comentário <span aria-hidden="true">→</span></strong>
          </a>
        ) : (
          <div class="chapter pending" aria-label={'Daniel capítulo ' + number + ' em preparação'}>
            <div class="top"><span>CAPÍTULO</span><span class="tag">Em preparação</span></div>
            <div class="number">{String(number).padStart(2,'0')}</div>
            <h3>{label}</h3>
            <p>Comentário em preparação para publicação.</p>
          </div>
        ))}
      </div>
      <p class="ara-notice">Versão bíblica de referência: <strong>Almeida Revista e Atualizada (ARA)</strong>. Os comentários seguem o manuscrito editorial do livro de Daniel; a leitura do texto bíblico pode ser feita na <a href="https://www.sbb.org.br/biblia/ARA/DAN.1" target="_blank" rel="noopener noreferrer">Sociedade Bíblica do Brasil</a>.</p>
    </div>
  </section>
</Base>
<style>
.daniel-project{padding:44px 0 100px}
.crumbs{font:500 13px Inter,sans-serif;display:flex;align-items:center;gap:11px;color:#748394;margin-bottom:52px}
.crumbs a{text-decoration:underline;text-underline-offset:4px}
.daniel-project h1{font-size:clamp(33px,5vw,53px);line-height:1.16;letter-spacing:-.04em;max-width:850px;margin:15px 0 18px}
.subtitle{max-width:770px;font:400 19px/1.82 "Source Serif 4",Georgia,serif;color:#5b6878;margin:0 0 40px}
.metadata{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));border:1px solid #e6dccd;border-radius:12px;background:#fff;padding:25px 27px;margin-bottom:62px;gap:17px}
.metadata>div{display:flex;flex-direction:column;gap:7px;padding-left:20px;border-left:1px solid #e9e2d7}
.metadata>div:first-child{padding-left:0;border-left:0}
.metadata small{font:700 10px Inter,sans-serif;letter-spacing:.12em;color:#8994a0}
.metadata strong{font:600 16px Inter,sans-serif;color:#162d4c}
.section-heading{display:flex;gap:30px;align-items:flex-end;justify-content:space-between;margin-bottom:25px}
.section-heading h2{font-size:clamp(26px,3vw,33px);margin:10px 0 0}
.section-heading p{max-width:315px;color:#6d7886;font-size:13px;line-height:1.6}
.chapters{display:grid;grid-template-columns:repeat(auto-fill,minmax(245px,1fr));gap:18px}
.chapter{display:flex;flex-direction:column;min-height:300px;background:#fff;border:1px solid #e5dac8;border-radius:12px;padding:24px 25px;transition:border-color .2s,box-shadow .2s,transform .2s}
.chapter.available:hover{border-color:#b99860;transform:translateY(-3px);box-shadow:0 15px 32px #1429420c}
.top{display:flex;gap:8px;align-items:center;justify-content:space-between;font:700 10px Inter,sans-serif;letter-spacing:.11em;color:#9c763f}
.top .tag{letter-spacing:0;color:#356c51;background:#e7f3eb;border-radius:25px;padding:6px 9px}
.pending .top .tag{color:#768391;background:#edf0f2}
.number{font:700 44px/1.2 "Libre Baskerville",Georgia,serif;color:#17304d;margin:19px 0 14px}
.chapter h3{font-size:17px;line-height:1.5;letter-spacing:-.01em;margin:0 0 12px}
.chapter p{font:400 13px/1.65 Inter,sans-serif;color:#6b7887;margin:0 0 23px}
.read{margin-top:auto;font:700 13px Inter,sans-serif;color:#906b34}
.pending{background:#f7f6f3;border-style:dashed}
.pending .number,.pending h3{color:#83909b}
.ara-notice{margin-top:42px;padding-top:27px;border-top:1px solid #e5dac8;font:400 13px/1.7 Inter,sans-serif;color:#71808e}
.ara-notice a{color:#936b34;text-decoration:underline;text-underline-offset:3px}
@media(max-width:760px){.daniel-project{padding:30px 0 70px}.crumbs{margin-bottom:36px}.metadata{grid-template-columns:repeat(2,1fr);padding:20px}.metadata>div{padding:0;border:0}.section-heading{display:block}.section-heading p{max-width:none}.chapter{min-height:265px}}
</style>
