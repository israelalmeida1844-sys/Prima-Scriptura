---
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('comentarios', ({data}) => !data.draft && data.book === 'Daniel');
  return entries.map(entry => ({
    params: { capitulo: 'capitulo-' + entry.data.chapter },
    props: { entry }
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const chapter = entry.data.chapter;
const araUrl = 'https://www.sbb.org.br/biblia/ARA/DAN.' + chapter;
---
<Base title={'Daniel — Capítulo ' + chapter} description={entry.data.description}>
  <section class="section reading-page">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Caminho de navegação">
        <a href="/comentarios/">Comentários</a>
        <span aria-hidden="true">/</span>
        <a href="/comentarios/daniel/">Daniel</a>
        <span aria-hidden="true">/</span>
        <span>Capítulo {chapter}</span>
      </nav>
      <div class="reading-head">
        <div class="eyebrow">LIVRO DE DANIEL · COMENTÁRIO HISTÓRICO E EXEGÉTICO</div>
        <p class="chapter-index">CAPÍTULO {String(chapter).padStart(2,'0')} / 12</p>
        <h1>Daniel — Capítulo {chapter}</h1>
        <p class="reading-description">{entry.data.description}</p>
      </div>
      <div class="bible-reference">
        <div>
          <span class="bible-label">TEXTO BÍBLICO</span>
          <strong>Daniel {chapter} · Almeida Revista e Atualizada (ARA)</strong>
          <small>Leia o texto na edição oficial da Sociedade Bíblica do Brasil.</small>
        </div>
        <a class="bible-link" href={araUrl} target="_blank" rel="noopener noreferrer">Ler capítulo na ARA <span aria-hidden="true">↗</span></a>
      </div>
      <article class="article reading-content">
        <div class="meta">{entry.data.author} · Comentário de Daniel {chapter}:1–{entry.data.verses.split('–').at(-1)}</div>

        <nav class="verse-browser" data-verse-browser data-chapter={chapter} aria-label={'Navegação pelos versículos de Daniel ' + chapter} hidden>
          <div class="verse-browser-top">
            <div>
              <span class="verse-eyebrow">LEITURA POR VERSÍCULO</span>
              <h2>Escolha o versículo que deseja estudar</h2>
              <p>Clique em um número para ver somente o comentário correspondente. A leitura integral permanece disponível.</p>
            </div>
            <div class="verse-view-controls">
              <button type="button" class="verse-control" data-verse-target="all" aria-pressed="true" aria-controls="daniel-prose">Capítulo completo</button>
              <button type="button" class="verse-control" data-verse-target="intro" aria-pressed="false" aria-controls="daniel-prose">Introdução e esboço</button>
            </div>
          </div>
          <div class="verse-number-grid" data-verse-buttons role="group" aria-label={'Selecionar o número do versículo em Daniel ' + chapter}></div>
          <p class="verse-current" data-verse-status role="status" aria-live="polite"></p>
        </nav>
        <div class="prose" id="daniel-prose"><Content /></div>
        <nav class="verse-step-navigation" data-verse-step-navigation hidden aria-label="Navegar entre os comentários de Daniel">
          <button type="button" data-verse-prev class="verse-step-button verse-step-prev" aria-label="Voltar ao versículo anterior">
            <span class="verse-step-arrow" aria-hidden="true">←</span>
            <span class="verse-step-text"><small>VOLTAR</small><strong data-verse-prev-label>Versículo anterior</strong></span>
          </button>
          <button type="button" data-verse-next class="verse-step-button verse-step-next" aria-label="Avançar ao próximo versículo">
            <span class="verse-step-text"><small>AVANÇAR</small><strong data-verse-next-label>Próximo versículo</strong></span>
            <span class="verse-step-arrow" aria-hidden="true">→</span>
          </button>
        </nav>
      </article>
      <div class="next-reading">
        <div><span>CONTINUE A LEITURA</span><strong>Explore os capítulos de Daniel</strong></div>
        <a href="/comentarios/daniel/">Voltar ao índice de capítulos →</a>
      </div>
    </div>
  </section>
</Base>
<script>
  // Navegação progressiva: o capítulo permanece legível sem JavaScript.
  // Os capítulos 1–3 usam títulos H3 para versículos; os capítulos 4–12 usam H4.
  const browser = document.querySelector('[data-verse-browser]');

  if (browser instanceof HTMLElement) {
    const prose = browser.closest('article')?.querySelector('.prose');
    const chapter = Number(browser.dataset.chapter);

    if (prose instanceof HTMLElement && Number.isInteger(chapter)) {
      const blocks = Array.from(prose.children);
      const verseHeadings = new Map<string, HTMLElement>();
      let segment = 'intro';
      let reachedVerses = false;

      for (const element of blocks) {
        if (!(element instanceof HTMLElement)) continue;
        const isHeading = /^H[1-4]$/.test(element.tagName);
        const match = isHeading
          ? element.textContent?.trim().match(/^Daniel\s+(\d+):(\d+)$/i)
          : null;

        if (match && Number(match[1]) === chapter) {
          segment = String(Number(match[2]));
          verseHeadings.set(segment, element);
          element.id = 'v' + segment;
          reachedVerses = true;
        } else if (isHeading) {
          segment = reachedVerses ? 'section' : 'intro';
        }
        element.dataset.versePart = segment;
      }

      const verses = Array.from(verseHeadings.keys()).sort((a, b) => Number(a) - Number(b));
      const grid = browser.querySelector('[data-verse-buttons]');
      const status = browser.querySelector('[data-verse-status]');
      const controls = Array.from(browser.querySelectorAll('button[data-verse-target]'));
      const stepNavigation = browser.closest('article')?.querySelector('[data-verse-step-navigation]');
      const previousButton = stepNavigation?.querySelector('[data-verse-prev]');
      const nextButton = stepNavigation?.querySelector('[data-verse-next]');
      // Todos os 12 capítulos: permite seguir de um capítulo ao próximo sem retornar ao índice.
      const chapterLengths = [21,49,30,37,31,28,28,27,27,21,45,13];

      if (verses.length && grid instanceof HTMLElement && status instanceof HTMLElement) {
        for (const verse of verses) {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'verse-number';
          button.textContent = verse;
          button.dataset.verseTarget = verse;
          button.setAttribute('aria-label', 'Mostrar comentário de Daniel ' + chapter + ':' + verse);
          button.setAttribute('aria-pressed', 'false');
          button.setAttribute('aria-controls', 'daniel-prose');
          grid.append(button);
          controls.push(button);
        }

        function fromHash() {
          if (window.location.hash === '#introducao') return 'intro';
          const found = window.location.hash.match(/^#v(\d+)$/i);
          const verse = found ? String(Number(found[1])) : '';
          return verseHeadings.has(verse) ? verse : 'all';
        }

        function showSelection(requested: string, changeAddress = true, scroll = true, smooth = true) {
          const verse = String(Number(requested));
          const selection = requested === 'intro'
            ? 'intro'
            : verseHeadings.has(verse) ? verse : 'all';

          for (const element of blocks) {
            if (element instanceof HTMLElement) {
              element.hidden = selection !== 'all' && element.dataset.versePart !== selection;
            }
          }

          for (const button of controls) {
            const active = button.dataset.verseTarget === selection;
            button.setAttribute('aria-pressed', String(active));
            button.classList.toggle('is-active', active);
          }

          status.textContent = selection === 'all'
            ? 'Exibindo o capítulo completo.'
            : selection === 'intro'
              ? 'Exibindo a introdução e o esboço do capítulo.'
              : 'Exibindo somente o comentário de Daniel ' + chapter + ':' + selection + '.';

          // Rodapé contextual: setas disponíveis somente quando se lê um versículo.
          if (stepNavigation instanceof HTMLElement) {
            const index = verses.indexOf(selection);
            stepNavigation.hidden = index < 0;
            if (index >= 0) {
              const current = Number(selection);
              const previous = index > 0
                ? { chapter, verse: Number(verses[index - 1]) }
                : chapter > 1
                  ? { chapter: chapter - 1, verse: chapterLengths[chapter - 2] }
                  : null;
              const next = index < verses.length - 1
                ? { chapter, verse: Number(verses[index + 1]) }
                : chapter < chapterLengths.length
                  ? { chapter: chapter + 1, verse: 1 }
                  : null;

              function updateStep(button: Element | null | undefined, destination: { chapter: number; verse: number } | null) {
                if (!(button instanceof HTMLButtonElement)) return;
                button.disabled = !destination;
                button.dataset.targetChapter = destination ? String(destination.chapter) : '';
                button.dataset.targetVerse = destination ? String(destination.verse) : '';
                const direction = button.hasAttribute('data-verse-prev') ? 'Voltar' : 'Avançar';
                button.setAttribute('aria-label', destination
                  ? direction + ' para Daniel ' + destination.chapter + ':' + destination.verse
                  : direction + ': limite do livro de Daniel');
                const label = button.querySelector('[data-verse-prev-label], [data-verse-next-label]');
                if (label) label.textContent = destination
                  ? 'Daniel ' + destination.chapter + ':' + destination.verse
                  : (previous === null && button.hasAttribute('data-verse-prev') ? 'Início do livro' : 'Fim do livro');
              }
              updateStep(previousButton, previous);
              updateStep(nextButton, next);
            }
          }

          if (changeAddress) {
            const url = new URL(window.location.href);
            url.hash = selection === 'all' ? '' : selection === 'intro' ? 'introducao' : 'v' + selection;
            window.history.pushState(null, '', url);
          }

          // Os IDs dos versículos são configurados pelo JavaScript.
          // Um link direto #v14 chega antes desses IDs existirem no DOM;
          // por isso é necessário rolar explicitamente após a seleção.
          if (scroll) {
            const target = verseHeadings.get(selection)
              ?? (selection === 'intro'
                ? blocks.find(el => el instanceof HTMLElement && el.dataset.versePart === 'intro')
                : prose);
            if (target instanceof HTMLElement) {
              window.requestAnimationFrame(() => {
                target.scrollIntoView({ behavior: smooth ? 'smooth' : 'instant', block: 'start' });
              });
            }
          }
        }

        browser.addEventListener('click', (event) => {
          const clicked = event.target;
          if (!(clicked instanceof Element)) return;
          const button = clicked.closest('button[data-verse-target]');
          if (!(button instanceof HTMLButtonElement) || !browser.contains(button)) return;
          showSelection(button.dataset.verseTarget || 'all');
        });

        // Navegação sequencial; atualiza o hash e o foco no mesmo capítulo.
        // Ao atingir os limites, abre o primeiro/último versículo do capítulo adjacente.
        if (stepNavigation instanceof HTMLElement) {
          stepNavigation.addEventListener('click', event => {
            const clicked = event.target;
            if (!(clicked instanceof Element)) return;
            const button = clicked.closest('button[data-verse-prev],button[data-verse-next]');
            if (!(button instanceof HTMLButtonElement) || button.disabled) return;
            const targetChapter = Number(button.dataset.targetChapter);
            const targetVerse = Number(button.dataset.targetVerse);
            if (!Number.isInteger(targetChapter) || !Number.isInteger(targetVerse) || targetVerse < 1) return;
            if (targetChapter === chapter) {
              showSelection(String(targetVerse));
            } else {
              window.location.assign('/comentarios/daniel/capitulo-' + targetChapter + '/#v' + targetVerse);
            }
          });
        }

        const syncAddress = () => showSelection(fromHash(), false, true, false);
        window.addEventListener('popstate', syncAddress);
        window.addEventListener('hashchange', syncAddress);
        browser.hidden = false;
        const initial = fromHash();
        showSelection(initial, false, initial !== 'all', false);
      }
    }
  }
</script>
<style>
.reading-page{padding-top:34px;padding-bottom:90px}
.breadcrumbs{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:64px;font:500 12px Inter,sans-serif;color:#75808d}
.breadcrumbs a{text-decoration:underline;text-underline-offset:4px}
.reading-head{max-width:860px;margin:0 auto 36px}
.reading-head .eyebrow{font-size:11px;letter-spacing:.14em}
.chapter-index{font:700 12px Inter,sans-serif;letter-spacing:.13em;color:#9a7035;margin:32px 0 12px}
.reading-head h1{font-size:clamp(34px,5vw,54px);line-height:1.2;letter-spacing:-.045em;margin:0 0 18px}
.reading-description{font:400 20px/1.65 "Source Serif 4",Georgia,serif;color:#5b6675;max-width:710px;margin:0}
.bible-reference{max-width:860px;margin:0 auto 48px;padding:24px 30px;background:#f4efe5;border:1px solid #e3d5be;border-radius:10px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.bible-reference>div{display:flex;flex-direction:column;gap:5px}
.bible-label{font:700 10px Inter,sans-serif;letter-spacing:.17em;color:#987139}
.bible-reference strong{font:600 15px/1.45 Inter,sans-serif;color:#17304d}
.bible-reference small{font:400 12px/1.5 Inter,sans-serif;color:#78818c}
.bible-link{font:700 12px/1.4 Inter,sans-serif;color:white;background:#17304d;padding:14px 18px;border-radius:6px;text-align:center;white-space:nowrap;transition:background .15s}
.bible-link:hover{background:#2e4d71;color:white}
.reading-content{max-width:790px}
.reading-content .meta{margin-bottom:36px}
.next-reading{max-width:790px;display:flex;align-items:center;justify-content:space-between;gap:22px;border-top:1px solid #e1d7ca;margin:64px auto 0;padding-top:26px}
.next-reading>div{display:flex;flex-direction:column;gap:6px}
.next-reading span{font:700 10px Inter,sans-serif;letter-spacing:.14em;color:#9a7035}
.next-reading strong{font:600 17px "Libre Baskerville",Georgia,serif;color:#182e49}
.next-reading a{font:700 13px Inter,sans-serif;color:#8f672d}
@media(max-width:760px){.breadcrumbs{margin-bottom:38px}.reading-head{margin-bottom:30px}.reading-description{font-size:18px}.bible-reference{flex-direction:column;align-items:stretch;padding:20px}.bible-link{white-space:normal}.next-reading{flex-direction:column;align-items:flex-start}}
:global(.reading-content .prose img){display:block;max-width:100%;height:auto;margin:28px auto 14px;border:1px solid #d9e5e9;border-radius:12px}

.verse-browser{max-width:790px;margin:0 0 32px;padding:24px 26px 21px;border:1px solid #d9dfdd;background:#f8f8f5;border-radius:12px;scroll-margin-top:14px}
.verse-browser[hidden]{display:none!important}
.verse-browser-top{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;margin-bottom:20px}
.verse-eyebrow{font:700 10px Inter,sans-serif;letter-spacing:.14em;color:#8a682f}
.verse-browser h2{font:700 18px/1.5 Inter,sans-serif;letter-spacing:-.015em;color:#17304d;margin:6px 0}
.verse-browser-top p{font:400 13px/1.65 Inter,sans-serif;color:#657587;margin:0;max-width:380px}
.verse-view-controls{display:flex;flex-wrap:wrap;gap:8px;min-width:225px;justify-content:flex-end}
.verse-control,.verse-number{appearance:none;border:1px solid #cbd5d8;background:#fff;color:#294358;border-radius:7px;cursor:pointer;transition:background .12s,border-color .12s}
.verse-control{padding:10px 12px;font:600 12px/1.4 Inter,sans-serif}
.verse-number-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(42px,1fr));gap:8px}
.verse-number{min-height:43px;font:700 14px/1.3 Inter,sans-serif}
.verse-control:hover,.verse-number:hover{border-color:#a78044;background:#f3eee5}
.verse-control.is-active,.verse-number.is-active{background:#17304d;border-color:#17304d;color:#fff}
.verse-control:focus-visible,.verse-number:focus-visible{outline:3px solid #b58b49;outline-offset:3px}
.verse-current{font:500 12px/1.5 Inter,sans-serif;color:#647589;margin:15px 0 0}
:global(.reading-content .prose > [hidden]){display:none!important}
:global(.reading-content .prose > [id^='v']){scroll-margin-top:28px}
@media(max-width:760px){.verse-browser{padding:18px 16px}.verse-browser-top{display:block}.verse-view-controls{margin-top:14px;justify-content:flex-start}.verse-number-grid{grid-template-columns:repeat(auto-fill,minmax(38px,1fr))}.verse-number{min-height:41px}}


.reading-head{max-width:900px;min-height:263px;background-image:linear-gradient(90deg,rgba(9,24,44,.96),rgba(9,24,44,.72) 50%,rgba(9,24,44,.04) 100%),url('/images/daniel-hero.webp');background-size:cover;background-position:center center;display:flex;flex-direction:column;justify-content:center;margin:0 auto 34px;padding:30px 39px;border-radius:14px;box-shadow:0 14px 37px #10264224;}
.reading-head .eyebrow{color:#e7c58d}
.reading-head .chapter-index{color:#e9c58e;margin:14px 0 9px}
.reading-head h1{color:#fff;}
.reading-head .reading-description{color:#eaf2f8;font-size:18px}
.verse-number-grid{display:flex;flex-wrap:nowrap;overflow-x:auto;gap:8px;padding:5px 2px 13px;scrollbar-width:thin;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain;max-width:100%}
.verse-number{flex:0 0 44px;min-width:44px;min-height:44px}
@media(max-width:760px){.reading-head{min-height:240px;padding:24px 21px}.reading-head h1{font-size:clamp(29px,7vw,38px)}.reading-head .reading-description{font-size:16px;line-height:1.5}.verse-number{flex-basis:42px;min-width:42px}}
.verse-step-navigation{display:flex;justify-content:space-between;gap:16px;border-top:1px solid #d9e1e4;padding-top:25px;margin-top:45px;max-width:790px}
.verse-step-navigation[hidden]{display:none!important}
.verse-step-button{display:flex;align-items:center;gap:13px;min-height:76px;min-width:0;flex:1;background:#f7f9fa;color:#17304d;border:1px solid #d4dfe5;border-radius:12px;padding:13px 20px;cursor:pointer;transition:border-color .15s,background .15s}
.verse-step-button:hover:not(:disabled){border-color:#b28b53;background:#f6f1e8}
.verse-step-button:focus-visible{outline:3px solid #b28b53;outline-offset:4px}
.verse-step-button:disabled{opacity:.46;cursor:not-allowed}
.verse-step-next{justify-content:flex-end;text-align:right}
.verse-step-arrow{font:700 30px/1 Inter,Arial,sans-serif;color:#9a743c}
.verse-step-text{display:flex;flex-direction:column;gap:7px;min-width:0}
.verse-step-text small{font:700 10px Inter,Arial,sans-serif;letter-spacing:.13em;color:#7d8894}
.verse-step-text strong{font:700 15px Inter,Arial,sans-serif;color:#203a54}
@media(max-width:600px){.verse-step-navigation{gap:8px}.verse-step-button{min-height:68px;padding:10px 12px;gap:8px}.verse-step-arrow{font-size:24px}.verse-step-text strong{font-size:12px}}

</style>
