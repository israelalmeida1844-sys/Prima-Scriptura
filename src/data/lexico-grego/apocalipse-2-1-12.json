      "partOfSpeech": "Verbo",
      "senses": [
        {
          "id": "G91-1",
          "label": "fazer injustiça, prejudicar, causar dano",
          "definition": "ἀδικέω é agir injustamente ou causar dano. Em 2:11, a forma ἀδικηθῇ é aoristo passivo subjuntivo após οὐ μή, negação enfática prospectiva.",
          "examples": [
            {
              "reference": "Apocalipse 2:11",
              "greek": "μὴ ἀδικηθῇ ἐκ",
              "translation": "sofrerá dano",
              "explanation": "A glosa contextual é «não sofrerá dano», e não «não cometerá injustiça»."
            }
          ]
        }
