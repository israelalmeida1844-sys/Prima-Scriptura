glosses":[{"gloss":"mulher","count":165},{"gloss":"mulheres","count":39},{"gloss":"esposas","count":5},{"gloss":"esposa","count":3}]},"G1327":{"id":"G1327","source":"TBESG","entries":[{"source_id":"G1327","disambiguated_id":"G1327 =","unique_id":"G1327","headword":"διέξοδος","transliteration":"diexodos","lexical_morphology":"G:N-F","gloss_en":"thoroughfare","definition_en":"δι-έ-οδος, -ου, ἡ \n [in LXX chiefly for תּוֹצָאָה, as Num.34:4ff, and frequently in Jos;] \nin π. of the conclusion of a trial (MM, Exp., xi); a way out through, an outlet; pl., δ. τῶν ὁδῶν, RV, the partings of the highways: Mat.22:9.†\n (AS)","source_line":1459}],"occurrence_count":1,"observed_portuguese_glosses":[{"gloss":"saídas","count":1}]},"G1361":{"id":"G1361","source":"TBESG","entries":[{"source_id":"G1361","disambiguated_id":"G1361 =","unique_id":"G1361","headword":"Διοτρεφής","transliteration":"Diotrephēs","lexical_morphology":"N:N-M-P","gloss_en":"Diotrephes","definition_en":"Διοτρέφης (Rec. -τρεψής), -ες \n (Διός, genitive of Ζεύς + τρέφω: cherished by Zeus), \nas proper name, Diotrephes: III Jn 9.†\n (AS)","source_line":1493}],"occurrence_count":1,"observed_portuguese_glosses":[{"gloss":"busca","count":1}]},"G1384":{"id":"G1384","source":"TBESG","entries":[{"source_id":"G1384","disambiguated_id":"G1384 =","unique_id":"G1384","headword":"δόκιμος","transliteration":"dokimos","lexical_morphology":"G:A","gloss_en":"tested","definition_en":"δοκίμιος, -α, -ον\n (δοκιμή), [in LXX: ἀργύριον δ. (עֲלִיל), Psa.12:6; and as seel. for δόκιμος (B), ἀργυρίου δ. (זָקַק pual.), 1Ch.29:4 (Bab); εἰ δ .ίστιν (יְקָר), Zec.11:13 א with a vid, Q *)* ;] \n= δόκιμος, \n tested, approved: τὸ δ. ὑμῶν τ. πίστεως, that which is approved in your faith, 1Pe.1:7 (where Hort suggests the seel. δόκιμος, found in some cursives), Jas.1:3 (but see Mayor, in l For full discussion of this word, not hitherto found in a Gk. Lexicon, and for exx. of its use in π., see Deiss. (to whom is due the credit of its discovery), BS, 259 ff.; MM, Exp., xi; cf. also Milligan, NTD, 76).†\n δόκιμος, -ον \n (δέκομαι = δέχομαι) [in LXX for זָקַק pual., etc. ;] \nprimarily of metals, tested, accepted, approved: of persons, Rom.14:18 16:10, 1Co.11:19, 2Co.10:18 13:7, 2Ti.2:15, Jas.1:12 (Cremer, 212, 697).†\n (AS)","source_line":1516}],"occurrence_count":7,"observed_portuguese_glosses":[{"gloss":"aprovado","count":5},{"gloss":"aprovados","count":2}]},"G1809":{"id":"G1809","source":"TBESG","entries":[{"source_id":"G1809","disambiguated_id":"G1809 =","unique_id":"G1809","headword":"ἐξαιτέω","transliteration":"exaiteō","lexical_morphology":"G:V","gloss_en":"to demand/ask for","definition_en":"ἐξ-αιτέω, -ῶ \n to ask from; mid., to ask for oneself, demand: aor., ἐξῃτήσατο, with accusative (obtained you by asking, R, mg.), Luk.22:31 (see Field, Notes, 76; Cremer, 73).†\n (AS)","source_line":1950}],"occurrence_count":1,"observed_portuguese_glosses":[{"gloss":"pediu","count":1}]},"G1985":{"id":"G1985","source":"TBESG","entries":[{"source_id":"G1985","disambiguated_id":"G1985 =","unique_id":"G1985","headword":"ἐπίσκοπος","transliteration":"episkopos","lexical_morphology":"G:N-M","gloss_en":"overseer","definition_en":"ἐπί-σκοπος, -ου, ὁ\n (σκοπός, a watcher), [in LXX for פָּקַד, its parts and derivatives, Num.4:16 31:14, Jdg.9:28, 4Ki.11:15 11:18, 2Ch.34:12 34:17, Neh.11:9, 14 11:22; אֵל, Job.20:29; נָגַשׂ:, Isa.60:17; Wis.1:6, 1Ma.1:51 * ;] \na superintendent, guardian, overseer (cl.; for exx. see LS, see word): Act.20:28, 1Pe.2:25 (ICC, in l); as technical term for a religious office (Deiss., BS, 230 f.), in later Paul. epp. of the head of a church (Vg. episcopus), a bishop: Php.1:1, 1Ti.3:2, Tit.1:7 (see reff. see word ἐπισκοπή).†\n (AS)","source_line":2126}],"occurrence_count":5,"observed_portuguese_glosses":[{"gloss":"supervisores","count":2},{"gloss":"supervisor","count":2},{"gloss":"bispo","count":1}]},"G2034":{"id":"G2034","source":"TBESG","entries":[{"source_id":"G2034","disambiguated_id":"G2034 =","uni