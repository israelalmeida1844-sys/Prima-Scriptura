":[{"source_id":"G1678","disambiguated_id":"G1678 =","unique_id":"G1678","headword":"Ἐλμωδάμ","transliteration":"Elmōdam","lexical_morphology":"N:N-M-P","gloss_en":"Elmadam","definition_en":"Ἐλμαδάμ (L, Ἑλ-; Rec. -μωδάμ), ό, indecl., \n Elmadam, an ancestor of Jesus: Luk.3:28. \n (AS)","source_line":1819}],"occurrence_count":1,"observed_portuguese_glosses":[{"gloss":"Elmadã","count":1}]},"G2327":{"id":"G2327","source":"TBESG","entries":[{"source_id":"G2327","disambiguated_id":"G2327 =","unique_id":"G2327","headword":"θεριστής","transliteration":"theristēs","lexical_morphology":"G:N-M","gloss_en":"reaper","definition_en":"θεριστής, -οῦ, ὁ\n (θερίζω), [in LXX: Dan LXX Bel 1:32, Th Bel 1:33* ;] \na reaper: Mat.13:30, 39†\n (AS)","source_line":2476}],"occurrence_count":2,"observed_portuguese_glosses":[{"gloss":"colhem","count":2}]},"G2331":{"id":"G2331","source":"TBESG","entries":[{"source_id":"G2331","disambiguated_id":"G2331 = a Group member of","unique_id":"G2332","headword":"Θεσσαλονικεύς","transliteration":"Thessalonikeus","lexical_morphology":"N:N--LG","gloss_en":"Thessalonian","definition_en":"θεσσαλονικεύς, -έως, ὁ \n a Thessalonian: Act.20:4 27:2, 1Th.1:1, 2Th.1:1.†\n (AS)","source_line":2480}],"occurrence_count":4,"observed_portuguese_glosses":[{"gloss":"tessalonicenses","count":3},{"gloss":"tessalonicense","count":1}]},"G2699":{"id":"G2699","source":"TBESG","entries":[{"source_id":"G2699","disambiguated_id":"G2699 =","unique_id":"G2699","headword":"κατατομή","transliteration":"katatomē","lexical_morphology":"G:N-F","gloss_en":"mutilation","definition_en":"κατα-τομή, -ῆς, ἡ \n [in Sm.: Jer.31:37 (κατατέμνω is used in LXX of forbidden mutilations: Lev.21:5, al.) ;] \n__1. incision. \n __2. excision, concision, mutilation: in sarcasm, by paronomasia, in contrast to (true) περιτομή (v3), of Judaizing Christians, Php.3:2 (see Lft., in l; Cremer, 883).†\n (AS)","source_line":2890}],"occurrence_count":1,"observed_portuguese_glosses":[{"gloss":"mutilação","count":1}]},"G2893":{"id":"G2893","source":"TBESG","entries":[{"source_id":"G2893","disambiguated_id":"G2893 =","unique_id":"G2893","headword":"κουφίζω","transliteration":"kouphizō","lexical_morphology":"G:V","gloss_en":"to lighten","definition_en":"κουφίζω\n (κοῦφος, light), [in LXX: Exo.18:22, Jon.1.5, al. (קָלַל hi.), Est.5:1, al. ;] \n__1. intrans., to be light (poetic chiefly). \n __2. to lighten, make light: with accusative, Act.27:38.†\n (AS)","source_line":3088}],"occurrence_count":1,"observed_portuguese_glosses":[{"gloss":"tiraram-peso","count":1}]},"G3059":{"id":"G3059","source":"TBESG","entries":[{"source_id":"G3059","disambiguated_id":"G3059 =","unique_id":"G3059","headword":"λοιδορία","transliteration":"loidoria","lexical_morphology":"G:N-F","gloss_en":"reviling","definition_en":"λοιδορία, -ας, ἡ\n (λοιδορέω), [in LXX chiefly for רִיב, מְרִיבָה ;] \nabuse, railing: 1Ti.5:14, 1Pe.3:9.†\n (AS)","source_line":3261}],"occurrence_count":3,"observed_portuguese_glosses":[{"gloss":"insulto","count":2},{"gloss":"maledicência","count":1}]},"G3570":{"id":"G3570","source":"TBESG","entries":[{"source_id":"G3570","disambiguated_id":"G3570 = a Form of","unique_id":"G3568","headword":"νυνί","transliteration":"nuni","lexical_morphology":"G:ADV","gloss_en":"now","definition_en":"νῦνί an Attic strengthened form of νῦν \n (in cl. always of time, and most often strictly of the pres.), [in LXX : Job.5:1-27, Psa.2:1-12, 1-12, 4Ma.4:1-26, Ep. Je* ;] \nnow; \n __1. of time: with praes., Act.24:13, Rom.15:23, 25, 1Co.13:13, 2Co.8:11 8:22, Phm 9 11; with pf., Rom.3:21; with pret., Rom.6:22 11:30 (WH, mg.) Rom.7:6, Eph.2:13, Col.1:21 3:8; ἡ ν. ἀπολογία, Act.22:1. \n __2. Of logical sequence (not so in cl.): Rom.7:17, 1Co.5:11 (νῦν, WH) 1Co.12:18 (νῦν, WH, txt.) 1Co.15:20, Heb.8:6 (νῦν, WH, txt.), Heb.9:26 (cf. WM, 24, 579n).†\n (AS)","source_line":3684}],"occurrence_count":20,"observed_portuguese_glosses":[{"gloss":"agora","count":18},{"gloss":"mas","count":2}]},"G36":{"id":"G36","source":"TBESG","entries":[{"source_id":"G0036","disambiguated_id":"G0036 =","unique_id":"G0036","headword":"ἀγενής","transliteration":"agenēs","lexical_morphology":"G:A","gloss_en":"lowly","definition_en":"ἀγενής, -ές \n (γένος), \n __1. unborn (Plat.); \n __2. of no family, ignoble, base (opposite to ἀγαθός, Soph., Fr., 105): opposite to εὐγενής, 1Co.1:28 (for exx. from π., see MM, VGT, see word). \n † (AS)","source_line":129}],"occurrence_count":1,"observed_portuguese_glosses":[{"gloss":"desprezíveis","count":1}]},"G3874":{"id":"G3874","source":"TBESG","entries":[{"source_id":"G3874","disambiguated_id":"G3874 =","unique_id":"G3874","headword":"παράκλησις","transliteration":"paraklēsis","lexical_morphology":"G:N-F","gloss_en":"encouragement","definition_en":"παρά-κλησις, -εως, ἡ\n (παρακαλέω), [in LXX : Job.21:2, Psa.94:19, Hos.13:14, Nam.3:7, Isa.57:18 66:11, Jer.16:7 (נָחַם, its parts and derivatives), Jer.38:9 (תַּחֲנוּן), Isa.28:29 30:7, 1Ma.10:24 1Mac 12:9, 2Ma.7:24 2Mac 15:11 * ;] \n__1. a calling to one's aid, summons (Thus.), hence, appeal, entreaty (Strab., Plut., al., 1Ma.10:24; of. Lft., Notes, 20) : 2Co.8:4. \n __2. exhortation, encouragement: Act.15:31, Rom.12:8, 1Co.14:3, 2Co.8:17, Php.2:1, 1Th.2:3, 1Ti.4:13, Heb.12:5; λόγος (τῆς) π., Act.13:15, Heb.13:22; υἱὸς π., Act.4:36. \n __3. consolation, comfort (Phalar., LXX) : Luk.6:24, Act.9:31, 2Co.1:4-7 7:4 7:7 7:13, 2Th.2:16, Phm 7; τ. γραφῶν, Rom.15:4; θεὸς τῆς π., Rom.15:5, 2Co.1:3; π. τοῦ Ἰσραήλ (see Dalman, Words, 109 f.), Lk\n (AS)","source_line":3992}],"occurrence_count":29,"observed_portuguese_glosses":[{"gloss":"consolação","count":18},{"gloss":"exortação","count":6},{"gloss":"consolo","count":2},{"gloss":"entusiasmo","count":1},{"gloss":"refúgio","count":1},{"gloss":"encorajamento","count":1}]},"G4634":{"id":"G4634","source":"TBESG","entries":[{"source_id":"G4634","disambiguated_id":"G4634 =","unique_id":"G4634","headword":"σκηνοπηγία","transliteration":"skēnopēgia","lexical_morphology":"G:N-F","gloss_en":"Feast|Festival of Booths","definition_en":"σκηνοπηγία, -ας, ἡ\n (σκηνή, πήγνυηι), [in LXX for סֻכָּה, Deu.16:16 31:10, Zec.14:16, 18-19; I Est.5:51, 1Ma.10:21, 2Ma.1:9 2Mac 1:18 * ;] \nprop., the setting up of tents or dwellings (Arist.); in LXX and NT, ἡ σ., ἡ ἑορτή τῆς σ. (called also ἑορτὴ σκηνῶν, Lev.23:34, al.; see Deiss., LAE, 116 f.), the feast of Tabernacles: Jhn.7:2.†\n (AS)","source_line":4780}],"occurrence_count":1,"observed_portuguese_glosses":[{"gloss":"tabernáculos","count":1}]},"G4739":{"id":"G4739","source":"TBESG","entries":[{"source_id":"G4739","disambiguated_id":"G4739 =","unique_id":"G4739","headword":"στήκω","transliteration":"stēkō","lexical_morphology":"G:V","gloss_en":"to stand","definition_en":"στήκω late Pres., formed from perf., ἕστηκα (see B1., § 17; WH, App., 169; Kennedy, Sources, 158; M, Pr., 238; MM, xxiii), \n [in LXX: Exo.14:13 A, Jdg.16:26 B, 3Ki.8:11 B * ;] \n= ἵστημι, to stand: Mrk.3:31 11:25, Jhn.1:26, Rev.12:4 (ἕστηκεν T). Metaphorical, to stand firm, stand fast: absol., Gal.5:1 (but see Field, Notes, 189 f.), 2Th.2:15; before ἐν, Jhn.8:44 (ἕστηκεν, T, R, mg.), 1Co.16:13, Php.1:27 4:1; with dative, Rom.14:4.†\n (AS)","source_line":4887}],"occurrence_count":9,"observed_portuguese_glosses":[{"gloss":"firmes","count":2},{"gloss":"estando","count":1},{"gloss":"estiverdes","count":1},{"gloss":"fica-firme","count":1},{"gloss":"estai-firmes","count":1},{"gloss":"libertou","count":1},{"gloss":"estais","count":1},{"gloss":"ficai-firmes","count":1}]},"G4846":{"id":"G4846","source":"TBESG","entries":[{"source_id":"G4846","disambiguated_id":"G4846 =","unique_id":"G4846","headword":"συμπνίγω","transliteration":"sumpnigō","lexical_morphology":"G:V","gloss_en":"to choke","definition_en":"συν-πνίγω (Rec. συμπ-), \n to choke: of thronging by a crowd, Luk.8:42. Fig., of seed, τ. λόγον, Mat.13:22, Mrk.4:7, 19, Luk.8:14.†\n (AS)","source_line":4998}],"occurrence_count":5,"observed_portuguese_glosses":[{"gloss":"sufocam","count":3},{"gloss":"sufocaram","count":1},{"gloss":"apertavam","count":1}]},"G4864":{"id":"G4864","source":"TBESG","entries":[{"source_id":"G4864","disambiguated_id":"G4864 =","unique_id":"G4864","headword":"συναγωγή","transliteration":"sunagōgē","lexical_morphology":"G:N-F","gloss_en":"synagogue","definition_en":"συν-αγωγή, -ῆς, ἡ \n [in LXX chiefly for עֵדָה, also for קָהָל, etc. ;] \nprop., a bringing together; \n __1. of things, \n __(a) a gathering in of harvest; \n __(b) a collection of money. \n __2. Of persons, \n __(a) a collecting, assembling (Polyb.); \n __(b) an assembly (MM, xxiv; Deiss., LAE, 101 ff.): Rev.2:9 3:9; esp. of a Jewish religious assembly, a synagogue: Luk.12:11, Act.9:2, al.; of a Christian assembly, Jas.2:2. By meton., of the building in which the assembly is held, a synagogue: Mat.10:17, Mrk.1:21, al. (cf. Cremer, see word ἐκκλησία) \n SYN.: ἐκκλησία (which see) (AS)","source_line":5016}],"occurrence_count":56,"observed_portuguese_glosses":[{"gloss":"sinagoga","count":31},{"gloss":"sinagogas","count":24},{"gloss":"congregação","count":1}]},"G5275":{"id":"G5275","source":"TBESG","entries":[{"source_id":"G5275","disambiguated_id":"G5275 =","unique_id":"G5275","headword":"ὑπολείπω","transliteration":"hupoleipō","lexical_morphology":"G:V","gloss_en":"to leave","definition_en":"ὑπο-λείπω \n [in LXX chiefly (pass.) for יָתַר ni., שָׁאַר ni. ;] \nto leave remaining (Hom., Thuc., al.): pass., of survivors, Rom.11:3.†\n (AS)","source_line":5431}],"occurrence_count":1,"observed_portuguese_glosses":[{"gloss":"fiquei","count":1}]},"G5401":{"id":"G5401","source":"TBESG","entries":[{"source_id":"G5401","disambiguated_id":"G5401 =","unique_id":"G5401","headword":"φόβος","transliteration":"phobos","lexical_morphology":"G:N-M","gloss_en":"fear","definition_en":"φόβος, -ου, ὁ \n [in LXX chiefly for יִרְאָה, also for פַּחַד, אֵימָה, etc. ;] \n__1. in Hom., flight. \n __2. That which causes flight, fear, dread, terror: Luk.1:12, Act.5:5, 1Ti.5:20. 1Jn.4:18, al.; cogn. accusative