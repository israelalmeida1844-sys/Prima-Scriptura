ount":7,"observed_portuguese_glosses":[{"gloss":"esmagada","count":1},{"gloss":"esmigalhados","count":1},{"gloss":"quebrando","count":1},{"gloss":"maltrata","count":1},{"gloss":"osso","count":1},{"gloss":"esmagará","count":1},{"gloss":"são-quebrados","count":1}]},"G4971":{"id":"G4971","source":"TBESG","entries":[{"source_id":"G4971","disambiguated_id":"G4971 =","unique_id":"G4971","headword":"σφοδρῶς","transliteration":"sphodrōs","lexical_morphology":"G:ADV","gloss_en":"violently","definition_en":"σφοδρῶς \n adv., \nexceedingly: Act.27:18.†\n (AS)","source_line":5123}],"occurrence_count":1,"observed_portuguese_glosses":[{"gloss":"afligidos","count":1}]},"G5300":{"id":"G5300","source":"TBESG","entries":[{"source_id":"G5300","disambiguated_id":"G5300 =","unique_id":"G5300","headword":"ὗς","transliteration":"hus","lexical_morphology":"G:N-F","gloss_en":"sow","definition_en":"ὗς, ὑός, ὁ, ἡ\n [in LXX for חֲזִיר ;] \nswine: fem. (sow), 2Pe.2:22,†\n (AS)","source_line":5456}],"occurrence_count":1,"observed_portuguese_glosses":[{"gloss":"porca","count":1}]},"G5567":{"id":"G5567","source":"TBESG","entries":[{"source_id":"G5567","disambiguated_id":"G5567 =","unique_id":"G5567","headword":"ψάλλω","transliteration":"psallō","lexical_morphology":"G:V","gloss_en":"to sing praise","definition_en":"ψάλλω \n [in LXX chiefly for זָמַר pi. (Jdg.5:3, Psa.7:17, al.), also for נָגַן pi. (1Ki.16:16 ff, al.) ;] \n__1. to pull, twitch, twang (as a bowstring, etc.; Æsch., Eur., al.), hence, \n __2. absol., \n __(a) to play a stringed instrument with the fingers (Hdt., Plat., al.); \n __(b) later, to sing to a harp, sing psalms (LXX); in NT, to sing a hymn, sing praise: Jas.5:13; with dative of person(s), Rom.15:9 (LXX), Eph.5:19; dative instr., 1Co.14:15.†\n (AS)","source_line":5737}],"occurrence_count":5,"observed_portuguese_glosses":[{"gloss":"cantarei","count":3},{"gloss":"salmodiando","count":1},{"gloss":"contente","count":1}]},"G896":{"id":"G896","source":"TBESG","entries":[{"source_id":"G0896","disambiguated_id":"G0896 = the Greek of","unique_id":"H1168A","headword":"Βάαλ","transliteration":"Baal","lexical_morphology":"N:N--T","gloss_en":"Baal","definition_en":"Βάαλ (Rec. βαάλ), ὁ, ἡ, indecl. (Heb. בַּעַל, lord), \n Baal: Rom.11:4 (LXX). The fem. art. here agrees with the usage of LXX, where, following a similar Hebrew practice (בֹּשֶׁת for בַּעַל), αἰσχύνη appears to have been substituted in reading for the written Βάαλ (cf. 3Ki.18:19), and to account for the frequently use of the fem. art. bef. Β. The usage, however, is not general, and in the passage cited in Ro (3Ki.19:18), LXX reads τῷ Β. † \n (AS)","source_line":1010}],"occurrence_count":1,"observed_portuguese_glosses":[{"gloss":"Baal","count":1}]},"H1332":{"id":"H1332","source":"TBESH","entries":[{"source_id":"H1332","disambiguated_id":"H1332 =","unique_id":"H1332","headword":"בִּתְיָה","transliteration":"bit.yah","lexical_morphology":"N:N-F-P","gloss_en":"Bithiah","definition_en":"A woman of the Egyptians living at the time of Divided Monarchy, only mentioned at 1Ch.4.18; \n daughter of: Pharaoh (H6547M); married to Mered (H4778)(?); \n mother of: Miriam (H4813H), Shammai (H8060I) and Ishbah (H3431) \n § Bithiah = \"daughter of Jehovah\"\n a daughter of a Pharaoh and wife of Mered of Judah","source_line":1876}],"occurrence_count":1,"observed_portuguese_glosses":[{"gloss":"Bitias","count":1}]},"H1476":{"id":"H1476","source":"TBESH","entries":[{"source_id":"H1476","disambiguated_id":"H1476G =","unique_id":"H1476G","headword":"גּוּנִי","transliteration":"gu.ni","lexical_morphology":"N:N-M-P","gloss_en":"Guni","definition_en":"A man of the tribe of Naphtali living at the time of Egypt and Wilderness, first mentioned at Gen.46.24; \n son of: Naphtali (H5321); \n brother of: Jahzeel (H3183), Jezer (H3337) and Shillem (H8006)\nAlso named: gu.ni (גּוּנִי \"Gunite\" H1477)\n § Guni = \"my defender (?)\"\n1) a son of Naphtali and founder of the family of Gunites\n2) a descendant of Gad","source_lin