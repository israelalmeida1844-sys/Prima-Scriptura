":[{"gloss":"prisão","count":2},{"gloss":"vale","count":1}]},"G525":{"id":"G525","source":"TBESG","entries":[{"source_id":"G0525","disambiguated_id":"G0525 =","unique_id":"G0525","headword":"ἀπαλλάσσω","transliteration":"apallassō","lexical_morphology":"G:V","gloss_en":"to release","definition_en":"ἀπ-αλλάσσω \n [in LXX for סוּר hi., etc. ;] \nto remove, release: Heb.2:15; pass., to depart: Act.19:12; in legal sense (MM, VGT, see word), before ἀπό, with genitive of person(s), to be quit of: Luk.12:58 (Cremer, 90, 632).†\n (AS)","source_line":633}],"occurrence_count":3,"observed_portuguese_glosses":[{"gloss":"livrares","count":2},{"gloss":"libertar","count":1}]},"G5519":{"id":"G5519","source":"TBESG","entries":[{"source_id":"G5519","disambiguated_id":"G5519 =","unique_id":"G5519","headword":"χοῖρος","transliteration":"choiros","lexical_morphology":"G:N-M","gloss_en":"pig","definition_en":"χοῖρος, -ου, ὁ \n [in Sm.: Isa.65:4 66:3 ;] \na swine: pl., Mat.7:6 8:30-32, Mrk.5:11-13, 16, Luk.8:32-33 15:15-16 †\n (AS)","source_line":5687}],"occurrence_count":12,"observed_portuguese_glosses":[{"gloss":"porcos","count":12}]},"G591":{"id":"G591","source":"TBESG","entries":[{"source_id":"G0591","disambiguated_id":"G0591 =","unique_id":"G0591","headword":"ἀποδίδωμι","transliteration":"apodidōmi","lexical_morphology":"G:V","gloss_en":"to pay","definition_en":"ἀπο-δίδωμι \n [in LXX for מָכַר, שׁוּב hi., נָתַן, שָׁלֵם pi., etc. ;] \nto give up or back, restore, return: Mat.27:58, Luk.4:20 9:42 19:8; esp. of wages, debts, oaths, etc. (MM, see word), to render what is due, to pay (Deiss., LAE, 334 f.): absol., Mat.18:25, 28, Luk.7:42. with accusative, Mat.5:26 18:29-30, 34 20:8 21:41 22:21, Mrk.12:17, Luk.10:35 12:59 20:25, Rom.13:7, Heb.12:11, Rev.22:2; ὅρκους, Mat.5:33 (cf. Num.30:3, Deu.23:21 al.); of conjugal duty, τ. ὀφειλήν, 1Co.7:3; ἀμοιβάς, 1Ti.5:4; μαρτύριον, to give (as in duty bound) testimony, Act.4:33; λόγον, to render account, Mat.12:36, Luk.16:2, Act.19:40, Heb.13:17, 1Pe.4:5; hence of requital, recompense, both in good and bad sense, Mat.6:4, 6 6:18 16:27, Rom.2:6, 2Ti.4:8 4:14 Rev.18:6 22:12; κακὸν ἀντὶ κακοῦ, Rom.12:17, 1Th.5:15, 1Pe.3:9. Mid., to give up of one's own, hence to sell (fr. Hdt. on): with accusative of thing(s), Act.5:8, Heb.12:16; with accusative of person(s), Act.7:9 (cf. ἀνταποδίδωμι) .†\n (AS)","source_line":699}],"occurrence_count":48,"observed_portuguese_glosses":[{"gloss":"recompensará","count":11},{"gloss":"dai","count":4},{"gloss":"pagarei","count":3},{"gloss":"pagares","count":2},{"gloss":"prestarão","count":2},{"gloss":"paga","count":2},{"gloss":"pagasse","count":2},{"gloss":"devolveu","count":2},{"gloss":"falsamente","count":1},{"gloss":"pagar","count":1},{"gloss":"deem","count":1},{"gloss":"entregue","count":1},{"gloss":"dívida","count":1},{"gloss":"dá","count":1},{"gloss":"devolvo","count":1},{"gloss":"davam","count":1},{"gloss":"ela","count":1},{"gloss":"venderam","count":1},{"gloss":"dar","count":1},{"gloss":"pagando","count":1},{"gloss":"retribua","count":1},{"gloss":"vendeu","count":1},{"gloss":"retribuais","count":1},{"gloss":"terão","count":1},{"gloss":"retribuí","count":1},{"gloss":"retribuído","count":1},{"gloss":"dando","count":1},{"gloss":"retribuir","count":1}]},"G868":{"id":"G868","source":"TBESG","entries":[{"source_id":"G0868","disambiguated_id":"G0868 =","unique_id":"G0868","headword":"ἀφίστημι","transliteration":"aphistēmi","lexical_morphology":"G:V","gloss_en":"to leave","definition_en":"ἀφ-ίστημι \n [in LXX for סוּר, מָעַל, etc. (41 words in all) ;] \n__1. trans. in pres., impf., fut., 1 aor., to put away, lead away; metaphorically, to move to revolt: Act.5:37. \n __2. Intrans. in pf., plpf., 2 aor., to stand off, depart from, withdraw from: with genitive, Luk.2:37; before ἀπό, Luk.4:13 13:27, Act.5:38 12:10 15:38 19:9 22:29, 2Co.12:8; metaphorically, ἀπὸ ἀδικίας, 2Ti.2:19; ἀπὸ θεοῦ, (fall away, apostatize), Heb.3:12 Mid. (exc. 1 aor., WH. is trans.), to withdraw oneself from, absen