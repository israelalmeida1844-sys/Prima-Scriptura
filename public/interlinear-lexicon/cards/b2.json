unt":5},{"gloss":"réu","count":4},{"gloss":"servidão","count":1}]},"G2013":{"id":"G2013","source":"TBESG","entries":[{"source_id":"G2013","disambiguated_id":"G2013 =","unique_id":"G2013","headword":"ἐπιτυγχάνω","transliteration":"epitugchanō","lexical_morphology":"G:V","gloss_en":"to obtain","definition_en":"ἐπι-τυγχάνω \n [in LXX: Gen.39:2 (צָלַח hi.), Pro.12:27 (חָרַךְ)* ;] \n__1. to light upon. \n __2. to obtain, attain to: Jas.4:2, with genitive of thing(s) (as in cl.), Heb.6:15 11:33; with accusative (late Gk.), Rom.11:7 (Rec. τούτου).†\n (AS)","source_line":2154}],"occurrence_count":5,"observed_portuguese_glosses":[{"gloss":"obteve","count":1},{"gloss":"obtiveram","count":1},{"gloss":"pacientemente-obteve","count":1},{"gloss":"alcançaram","count":1},{"gloss":"obter","count":1}]},"G2210":{"id":"G2210","source":"TBESG","entries":[{"source_id":"G2210","disambiguated_id":"G2210 =","unique_id":"G2210","headword":"ζημιόω","transliteration":"zēmioō","lexical_morphology":"G:V","gloss_en":"to lose","definition_en":"ζημόω, -ῶ\n (ζημία), [in LXX chiefly for עָנַשׁ ;] \nto damage. Pass., to suffer loss, forfeit, lose: absol., 1Co.3:15; before ἐν, 2Co.7:9; with accusative of thing(s) (see B1., § 34, 6), τ. ψυχήν, Mat.16:26, Mrk.8:36; ἑαυτόν, Luk.9:25; τ. πάντα, Php.3:8.†\n (AS)","source_line":2354}],"occurrence_count":6,"observed_portuguese_glosses":[{"gloss":"sofrer-perda","count":1},{"gloss":"perder","count":1},{"gloss":"sendo-prejudicado","count":1},{"gloss":"sofrerá","count":1},{"gloss":"sofrestes-dano","count":1},{"gloss":"aceitei-perder-essas","count":1}]},"G2425":{"id":"G2425","source":"TBESG","entries":[{"source_id":"G2425","disambiguated_id":"G2425 =","unique_id":"G2425","headword":"ἱκανός","transliteration":"hikanos","lexical_morphology":"G:A","gloss_en":"sufficient","definition_en":"ἱκανός, -ή, -όν\n (ἵκω, ἱκάνω, to reach, attain), [in LXX for דַּי, etc. ;] \n__1. of persons, suffcient, competent, fit: with inf., Mat.3:11, Mrk.1:7, Luk.3:16, 1Co.15:9, 2Co.3:6, 2Ti.2:2; before πρός, 2Co.2:16; before ἵνα, Mat.8:8, Luk.7:6. \n __2. Of things, in number, quantity or size, sufficient, enough, much, many: absol., ἱκανοί, Luk.7:11 (WH, R, omit) Luk.8:32, Act.12:12 14:21 19:19, 1Co.11:30; ὄχλος ἱ., Mrk.10:46, Luk.7:12, Act.11:24, 26 19:26; κλαυθμός, Act.20:37; ἀργύρια, Mat.28:12; λαμπάδες, Act.20:8; λόγοι, Luk.23:9; φῶς, Act.22:6; ἱ, ἐστιν (cf. לָכֶם רַב, LXX ἱκανούσθω, Deu.3:26), Luk.22:38; τὸ ἱ. ποιεῖν (Lat. satisfacere; cf. Jer.48:30), Mrk.15:15; τὸ ἱ. λαμβάνειν (Lat. satis accipere; see M, Pro.20:1-30 f.), Act.17:9; of time, ἡμέραι ἱ., Act.9:23, 43 18:18 27:7; ἱ. χρόνος, Luk.8:27, Act.8:11 14:3 27:9; pl., Luk.20:9; ἐκ χρόνων ἱ., Luk.23:8; ἀπὸ ἱ. ἐτῶν, Rom.15:23 (WH); ἐφ ̓ ἱκανόν (cf. 2Ma.8:25), Act.20:11.†\n (AS)","source_line":2582}],"occurrence_count":40,"observed_portuguese_glosses":[{"gloss":"muitos","count":9},{"gloss":"digno","count":6},{"gloss":"grande","count":5},{"gloss":"muito","count":5},{"gloss":"muitas","count":3},{"gloss":"considerável","count":2},{"gloss":"satisfazer","count":1},{"gloss":"suficiente","count":1},{"gloss":"magias","count":1},{"gloss":"tiveram","count":1},{"gloss":"fiança","count":1},{"gloss":"falou","count":1},{"gloss":"basta","count":1},{"gloss":"idôneo","count":1},{"gloss":"capazes","count":1},{"gloss":"competentes","count":1}]},"G2587":{"id":"G2587","source":"TBESG","entries":[{"source_id":"G2587","disambiguated_id":"G2587 =","unique_id":"G2587","headword":"Καππαδοκία","transliteration":"Kappadokia","lexical_morphology":"N:N-F-L","gloss_en":"Cappadocia","definition_en":"Καππαδοκία, -ας, ἡ \n Cappadocia, a province of Asia Minor: Act.2:9, 1Pe.1:1.†\n (AS)","source_line":2778}],"occurrence_count":2,"observed_portuguese_glosses":[{"gloss":"Capadócia","count":2}]},"G2856":{"id":"G2856","source":"TBESG","entries":[{"source_id":"G2856","disambiguated_id":"G2856 =","unique_id":"G2856","headword":"κολοβόω","transliteration":"koloboō","lexical_morphology":"G:V","gloss_en":"to shorten","definition_en":"κ